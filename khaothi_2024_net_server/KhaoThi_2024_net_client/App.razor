@using Fluxor
@using KhaoThi_2024_net_client.Components.Auth
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Authorization
@using Fluxor.Blazor.Web.Components
@inject NavigationManager NavigationManager

    <StoreInitializer />
    <MudThemeProvider />
    <MudDialogProvider />
    <MudSnackbarProvider />
    <fluxorReduxDevTools />
    <CascadingValue Value="typeof(CircularProgress)" Name="CircularProgressComponent">
        <CascadingAuthenticationState>
            <Router AppAssembly="@typeof(App).Assembly">
                <Found Context="routeData">
                    <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
                        <NotAuthorized>
                            @if (context.User?.Identity?.IsAuthenticated != true)
                            {
                                @if (!routeData.PageType.GetCustomAttributes(typeof(AllowAnonymousAttribute), true).Any())
                                {
                                    <LoginRedirect />
                                }
                                else
                                {
                                    <RouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)" />
                                }
                            }
                            else
                            {
                                <MudAlert Severity="Severity.Warning" Variant="Variant.Filled">
                                    Bạn không có quyền truy cập trang này.
                                </MudAlert>
                            }
                        </NotAuthorized>
                        <Authorizing>
                            <MudAlert Severity="Severity.Info" Variant="Variant.Filled">
                                Đang kiểm tra quyền truy cập...
                            </MudAlert>
                        </Authorizing>
                    </AuthorizeRouteView>
                    <FocusOnNavigate RouteData="@routeData" Selector="h1" />
                </Found>
                <NotFound>
                    <PageTitle>Không tìm thấy trang</PageTitle>
                    <LayoutView Layout="@typeof(MainLayout)">
                        <MudAlert Severity="Severity.Warning" Variant="Variant.Filled" Class="mt-8">
                            Xin lỗi, không tìm thấy trang bạn yêu cầu.
                        </MudAlert>
                    </LayoutView>
                </NotFound>
            </Router>
        </CascadingAuthenticationState>
    </CascadingValue>
