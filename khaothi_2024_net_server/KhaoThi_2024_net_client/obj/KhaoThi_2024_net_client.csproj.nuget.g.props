    <Import Project="$(NuGetPackageRoot)auralizeblazor\2.0.0\buildTransitive\AuralizeBlazor.props" Condition="Exists('$(NuGetPackageRoot)auralizeblazor\2.0.0\buildTransitive\AuralizeBlazor.props')" />
    <Import Project="$(NuGetPackageRoot)mudblazor.extensions\8.0.1\buildTransitive\MudBlazor.Extensions.props" Condition="Exists('$(NuGetPackageRoot)mudblazor.extensions\8.0.1\buildTransitive\MudBlazor.Extensions.props')" />
    <Import Project="$(NuGetPackageRoot)microsoft.net.sdk.webassembly.pack\9.0.1\build\Microsoft.NET.Sdk.WebAssembly.Pack.props" Condition="Exists('$(NuGetPackageRoot)microsoft.net.sdk.webassembly.pack\9.0.1\build\Microsoft.NET.Sdk.WebAssembly.Pack.props')" />
    <Import Project="$(NuGetPackageRoot)microsoft.aspnetcore.components.webassembly.authentication\8.0.12\buildTransitive\Microsoft.AspNetCore.Components.WebAssembly.Authentication.props" Condition="Exists('$(NuGetPackageRoot)microsoft.aspnetcore.components.webassembly.authentication\8.0.12\buildTransitive\Microsoft.AspNetCore.Components.WebAssembly.Authentication.props')" />
    <Import Project="$(NuGetPackageRoot)microsoft.authentication.webassembly.msal\8.0.12\buildTransitive\Microsoft.Authentication.WebAssembly.Msal.props" Condition="Exists('$(NuGetPackageRoot)microsoft.authentication.webassembly.msal\8.0.12\buildTransitive\Microsoft.Authentication.WebAssembly.Msal.props')" />
    <Import Project="$(NuGetPackageRoot)blazored.modal\7.3.1\buildTransitive\Blazored.Modal.props" Condition="Exists('$(NuGetPackageRoot)blazored.modal\7.3.1\buildTransitive\Blazored.Modal.props')" />
  </ImportGroup>
  <PropertyGroup Condition=" '$(ExcludeRestorePackageImports)' != 'true' ">
    <PkgMicrosoft_CodeAnalysis_Analyzers Condition=" '$(PkgMicrosoft_CodeAnalysis_Analyzers)' == '' ">C:\Users\K-PC\.nuget\packages\microsoft.codeanalysis.analyzers\3.3.4</PkgMicrosoft_CodeAnalysis_Analyzers>
    <PkgBuildBundlerMinifier Condition=" '$(PkgBuildBundlerMinifier)' == '' ">C:\Users\K-PC\.nuget\packages\buildbundlerminifier\3.2.449</PkgBuildBundlerMinifier>
    <PkgMicrosoft_NET_Sdk_WebAssembly_Pack Condition=" '$(PkgMicrosoft_NET_Sdk_WebAssembly_Pack)' == '' ">C:\Users\K-PC\.nuget\packages\microsoft.net.sdk.webassembly.pack\9.0.1</PkgMicrosoft_NET_Sdk_WebAssembly_Pack>
    <PkgMicrosoft_AspNetCore_Components_WebAssembly_DevServer Condition=" '$(PkgMicrosoft_AspNetCore_Components_WebAssembly_DevServer)' == '' ">C:\Users\K-PC\.nuget\packages\microsoft.aspnetcore.components.webassembly.devserver\8.0.12</PkgMicrosoft_AspNetCore_Components_WebAssembly_DevServer>
