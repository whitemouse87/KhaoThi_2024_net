@inherits LayoutComponentBase
@using KhaoThi_2024_net_client.Models.Auth
@using KhaoThi_2024_net_client.Components.Auth
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Authorization
@implements IDisposable
@inject IState<AuthState> AuthState
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar

<div class="main-layout">
    <MudLayout>
        @if (_isLoading)
        {
            <div class="loading-overlay">
                <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" />
                <MudText Typo="Typo.subtitle1" Color="Color.Primary" Class="mt-4">
                    @_loadingText
                </MudText>
            </div>
        }

        <AuthorizeView>
            <Authorized>
                <MudAppBar Elevation="0">
                    <MudIconButton Icon="@Icons.Material.Filled.Menu"
                                   Color="Color.Dark"
                                   Edge="Edge.Start"
                                   OnClick="@ToggleDrawer" />

                    <MudText Typo="Typo.subtitle1" Color="Color.Dark" Class="ml-4 mr-4">
                        @GetCurrentPageTitle()
                    </MudText>

                    <MudBreadcrumbs Items="_items" Class="flex-grow-1"></MudBreadcrumbs>

                    <MudSpacer />

                    <MudStack Row="true" Spacing="3">
                        <MudIconButton Icon="@Icons.Material.Filled.Search" Color="Color.Dark" Size="Size.Medium" />
                        <MudIconButton Icon="@Icons.Material.Filled.Notifications" Color="Color.Dark" Size="Size.Medium" />
                        <MudDivider Vertical="true" FlexItem="true" Class="mx-3" />
                        <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                            <ActivatorContent>
                                <MudAvatar Color="Color.Primary" Size="Size.Medium">
                                    @((!string.IsNullOrEmpty(AuthState.Value.CurrentUser?.HoTen))
                                        ? AuthState.Value.CurrentUser.HoTen[0].ToString().ToUpper()
                                        : "U")
                                </MudAvatar>
                            </ActivatorContent>
                            <ChildContent>
                                <MudMenuItem OnClick="HandleLogout">
                                    <div class="d-flex align-center">
                                        <MudIcon Icon="@Icons.Material.Filled.Logout" Class="mr-2" />
                                        Đăng xuất
                                    </div>
                                </MudMenuItem>
                            </ChildContent>
                        </MudMenu>
                    </MudStack>
                </MudAppBar>

                <MudDrawer @bind-Open="@_drawerOpen"
                           ClipMode="DrawerClipMode.Always"
                           Elevation="0"
                           Variant="@DrawerVariant.Persistent"
                           DisableOverlay="true">
                    <NavMenu />
                </MudDrawer>

                <MudMainContent>
                    <MudContainer>
                        @Body
                    </MudContainer>
                </MudMainContent>
            </Authorized>
            <NotAuthorized>
                @if (IsPublicPage)
                {
                    <MudContainer MaxWidth="MaxWidth.Small" Class="d-flex justify-center align-center" Style="min-height: 100vh;">
                        @Body
                    </MudContainer>
                }
                else
                {
                    <LoginRedirect />
                }
            </NotAuthorized>
        </AuthorizeView>
    </MudLayout>
</div>

@code {
    [Inject] private AuthenticationStateProvider AuthenticationStateProvider { get; set; } = default!;
    private bool _drawerOpen = true;
    private bool _isLoading = false;
    private string _loadingText = "Loading...";

    private List<BreadcrumbItem> _items = new List<BreadcrumbItem>
{
        new BreadcrumbItem("Home", href: "/"),
        new BreadcrumbItem("Dashboard", href: null)
    };

    private string GetCurrentPageTitle()
    {
        var uri = new Uri(NavigationManager.Uri);
        var segments = uri.Segments;
        if (segments.Length > 1)
        {
            var lastSegment = segments.Last().Trim('/');
            return char.ToUpper(lastSegment[0]) + lastSegment.Substring(1);
        }
        return "Dashboard";
    }

    private bool IsPublicPage =>
        NavigationManager.Uri.EndsWith("/login", StringComparison.OrdinalIgnoreCase) ||
        NavigationManager.Uri.EndsWith("/", StringComparison.OrdinalIgnoreCase);

    private void ToggleDrawer()
    {
        _drawerOpen = !_drawerOpen;
    }

    protected override void OnInitialized()
    {
        NavigationManager.LocationChanged += HandleLocationChanged;
    }

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        StateHasChanged();
    }

    public void ShowLoading(string text = "Loading...")
    {
        _isLoading = true;
        _loadingText = text;
        StateHasChanged();
    }

    public void HideLoading()
    {
        _isLoading = false;
        StateHasChanged();
    }

    private async Task HandleLogout()
    {
        try
        {
            ShowLoading("Đang đăng xuất...");
            if (AuthenticationStateProvider is CustomAuthStateProvider authStateProvider)
            {
                await authStateProvider.MarkUserAsLoggedOut();
                NavigationManager.NavigateTo("/", true);
                Snackbar.Add("Đăng xuất thành công", Severity.Success);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Lỗi khi đăng xuất: {ex.Message}", Severity.Error);
            Console.WriteLine($"Error during logout: {ex.Message}");
        }
        finally
        {
            HideLoading();
        }
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= HandleLocationChanged;
    }
}