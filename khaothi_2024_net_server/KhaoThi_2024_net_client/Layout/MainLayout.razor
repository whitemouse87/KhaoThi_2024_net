@inherits LayoutComponentBase
@using KhaoThi_2024_net_client.Models.Auth
@using KhaoThi_2024_net_client.Components.Auth
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Authorization

@implements IDisposable
@inject IState<AuthState> AuthState
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar
@inject ILogger<MainLayout> _logger
@inject IPageTitleService PageTitleService
@inject IModalService ModalService
<div class="main-layout">
    <MudLayout>
        @if (_isLoading)
        {
            <div class="loading-overlay">
                <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" />
                <MudText Typo="Typo.subtitle1" Color="Color.Primary" Class="mt-4">
                    @_loadingText
                </MudText>
            </div>
        }

        <AuthorizeView>
            <Authorized>
                <MudAppBar Elevation="0" Fixed="true">
                    <MudIconButton Icon="@Icons.Material.Filled.Menu"
                                   Color="Color.Dark"
                                   Edge="Edge.Start"
                                   OnClick="@ToggleDrawer" />

                    <MudText Typo="Typo.subtitle1" Color="Color.Dark" Class="ml-4 mr-4">
                        @GetCurrentPageTitle()
                    </MudText>

                    <MudBreadcrumbs Items="@_breadcrumbItems" Class="flex-grow-1"></MudBreadcrumbs>

                    <MudSpacer />

                    <MudStack Row="true" Spacing="3">
                        <MudIconButton Icon="@Icons.Material.Filled.Search" Color="Color.Dark" Size="Size.Medium" />
                        <MudIconButton Icon="@Icons.Material.Filled.Notifications" Color="Color.Dark" Size="Size.Medium" />
                        <MudDivider Vertical="true" FlexItem="true" Class="mx-3" />
                        <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                            <ActivatorContent>
                                <MudAvatar Color="Color.Primary" Size="Size.Medium">
                                    @{
                                        var initial = GetUserInitial(context);
                                        <text>@initial</text>
                                    }
                                </MudAvatar>
                            </ActivatorContent>
                            <ChildContent>
                                <MudMenuItem OnClick="HandleLogout">
                                    <div class="d-flex align-center">
                                        <MudIcon Icon="@Icons.Material.Filled.Logout" Class="mr-2" />
                                        Đăng xuất
                                    </div>
                                </MudMenuItem>
                            </ChildContent>
                        </MudMenu>
                    </MudStack>
                </MudAppBar>
                <MudDrawer @bind-Open="@_drawerOpen"
                           ClipMode="DrawerClipMode.Always"
                           Elevation="0"
                           Variant="@DrawerVariant.Persistent"
                           DisableOverlay="true"
                           Fixed="true">
                    <NavMenu />
                </MudDrawer>


                <MudMainContent>
                    <div class="content-wrapper">
                        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="px-4">
                            <MudPaper Class="pa-4" Elevation="0">
                                @Body
                            </MudPaper>
                        </MudContainer>
                    </div>
                    <footer class="footer">
                        <div class="footer-content">
                            <div class="footer-left">
                                2025 © Osen - Phiên bản thử nghiệm - Phòng Khảo thí và Kiểm định chất lượng giáo dục -
                                <MudLink Href="https://hcm.edu.vn" Target="_blank" Class="footer-link">
                                    Sở Giáo dục và Đào tạo Thành phố Hồ Chí Minh
                                </MudLink>
                            </div>
                            <div class="footer-right">
                                <MudLink Href="/about" Class="footer-link">About</MudLink>
                                <MudLink Href="/support" Class="footer-link">Support</MudLink>
                                <MudLink Href="/contact" Class="footer-link">Contact Us</MudLink>
                            </div>
                        </div>
                    </footer>
                </MudMainContent>
            </Authorized>
            <NotAuthorized>

                @if (IsPublicPage)
                {
                    <MudContainer MaxWidth="MaxWidth.Small" Class="d-flex justify-center align-center" Style="min-height: 100vh;">
                        @Body
                    </MudContainer>
                }
                else
                {
                    <LoginRedirect />
                }

            </NotAuthorized>
        </AuthorizeView>

    </MudLayout>

</div>

@code {
    [Inject] private AuthenticationStateProvider AuthenticationStateProvider { get; set; } = default!;
    private bool _drawerOpen = true;
    private bool _isLoading = false;
    private string _loadingText = "Đang tải...";
    private List<BreadcrumbItem> _breadcrumbItems = new();

    private string GetUserInitial(AuthenticationState context)
    {
        try
        {
            // Đầu tiên kiểm tra từ AuthState
            if (AuthState.Value.CurrentUser?.HoTen != null)
            {
                var HoTen = AuthState.Value.CurrentUser.HoTen.Trim();
                var parts = HoTen.Split(' ', StringSplitOptions.RemoveEmptyEntries);
                // Lấy phần tử cuối cùng (tên)
                return parts.Last()[0].ToString().ToUpper();
            }

            // Nếu không có trong AuthState, thử tìm trong Claims
            var nameClaims = new[] { "HoTen", ClaimTypes.GivenName, "name" };
            foreach (var claimType in nameClaims)
            {
                var claim = context.User.Claims.FirstOrDefault(c => c.Type == claimType);
                if (!string.IsNullOrEmpty(claim?.Value))
                {
                    var parts = claim.Value.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
                    // Lấy phần tử cuối cùng (tên)
                    return parts.Last()[0].ToString().ToUpper();
                }
            }

            return "U";
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error in GetUserInitial: {ex.Message}");
            return "U";
        }
    }

    private string GetCurrentPageTitle()
    {
        try
        {
            var uri = new Uri(NavigationManager.Uri);
            var tenPage = PageTitleService.GetPageTitle(uri.AbsolutePath);
            return !string.IsNullOrEmpty(tenPage) ? tenPage : "Dashboard";
        }
        catch (Exception)
        {
            return "Dashboard";
        }
    }

    private void UpdateBreadcrumbs()
    {
        var uri = new Uri(NavigationManager.Uri);
        var segments = uri.Segments.Skip(1).ToList();

        _breadcrumbItems.Clear();
        _breadcrumbItems.Add(new BreadcrumbItem("Home", "/"));

        var currentPath = "";
        foreach (var segment in segments.Where(s => !string.IsNullOrWhiteSpace(s)))
        {
            currentPath += "/" + segment.TrimEnd('/');
            var title = char.ToUpper(segment[0]) + segment[1..].TrimEnd('/');
            _breadcrumbItems.Add(new BreadcrumbItem(title, currentPath));
        }
    }

    private bool IsPublicPage =>
        NavigationManager.Uri.EndsWith("/login", StringComparison.OrdinalIgnoreCase) ||
        NavigationManager.Uri.EndsWith("/", StringComparison.OrdinalIgnoreCase);

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            if (authState.User.Identity?.IsAuthenticated == true)
            {
                // Log tất cả claims hiện có
                //foreach (var claim in authState.User.Claims)
                //{
                //    Console.WriteLine($"Initial Claim - Type: {claim.Type}, Value: {claim.Value}");
                //}

                UpdateBreadcrumbs();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Lỗi khi khởi tạo: {ex.Message}", Severity.Error);
            Console.WriteLine($"Error in OnInitializedAsync: {ex}");
        }

        NavigationManager.LocationChanged += HandleLocationChanged;


    }

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        UpdateBreadcrumbs();
        StateHasChanged();
    }

    public void ShowLoading(string text = "Đang tải...")
    {
        _isLoading = true;
        _loadingText = text;
        StateHasChanged();
    }

    public void HideLoading()
    {
        _isLoading = false;
        StateHasChanged();
    }

    private async Task HandleLogout()
    {
        try
        {
            ShowLoading("Đang đăng xuất...");
            if (AuthenticationStateProvider is CustomAuthStateProvider authStateProvider)
            {
                await authStateProvider.MarkUserAsLoggedOut();
                NavigationManager.NavigateTo("/", true);
                Snackbar.Add("Đăng xuất thành công", Severity.Success);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Lỗi khi đăng xuất: {ex.Message}", Severity.Error);
            await Logger.Error($"Lỗi khi đăng xuất: {ex.Message}", ex, this.GetType().Name);
        }
        finally
        {
            HideLoading();
        }
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= HandleLocationChanged;
    }
    @* ... rest of the code remains the same until MudMainContent ... *@


}
