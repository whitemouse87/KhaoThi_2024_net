@inherits LayoutComponentBase
@using KhaoThi_2024_net_client.Models.Auth
@using KhaoThi_2024_net_client.Components.Auth
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Authorization
@implements IDisposable
@inject IState<AuthState> AuthState
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar

<div class="main-layout">
    <MudLayout>
        @if (_isLoading)
        {
            <div class="loading-overlay">
                <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" />
                <MudText Typo="Typo.subtitle1" Color="Color.Primary" Class="mt-4">
                    @_loadingText
                </MudText>
            </div>
        }

        <AuthorizeView>
            <Authorized>
                <MudAppBar Elevation="0">
                    <MudIconButton Icon="@Icons.Material.Filled.Menu"
                                   Color="Color.Dark"
                                   Edge="Edge.Start"
                                   OnClick="@ToggleDrawer" />

                    <MudText Typo="Typo.subtitle1" Color="Color.Dark" Class="ml-4 mr-4">
                        @GetCurrentPageTitle()
                    </MudText>

                    <MudBreadcrumbs Items="@_breadcrumbItems" Class="flex-grow-1"></MudBreadcrumbs>

                    <MudSpacer />

                    <MudStack Row="true" Spacing="3">
                        <MudIconButton Icon="@Icons.Material.Filled.Search" Color="Color.Dark" Size="Size.Medium" />
                        <MudIconButton Icon="@Icons.Material.Filled.Notifications" Color="Color.Dark" Size="Size.Medium" />
                        <MudDivider Vertical="true" FlexItem="true" Class="mx-3" />
                        <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                            <ActivatorContent>
                                <MudAvatar Color="Color.Primary" Size="Size.Medium">
                                    @{
                                        var initial = GetUserInitial(context);
                                        <text>@initial</text>
                                    }
                                </MudAvatar>
                            </ActivatorContent>
                            <ChildContent>
                                <MudMenuItem OnClick="HandleLogout">
                                    <div class="d-flex align-center">
                                        <MudIcon Icon="@Icons.Material.Filled.Logout" Class="mr-2" />
                                        Đăng xuất
                                    </div>
                                </MudMenuItem>
                            </ChildContent>
                        </MudMenu>
                    </MudStack>
                </MudAppBar>

                <MudDrawer @bind-Open="@_drawerOpen"
                           ClipMode="DrawerClipMode.Always"
                           Elevation="0"
                           Variant="@DrawerVariant.Persistent"
                           DisableOverlay="true">
                    <NavMenu />
                </MudDrawer>

                <MudMainContent>
                    <MudContainer>
                        @Body
                    </MudContainer>
                </MudMainContent>
            </Authorized>
            <NotAuthorized>
                @if (IsPublicPage)
                {
                    <MudContainer MaxWidth="MaxWidth.Small" Class="d-flex justify-center align-center" Style="min-height: 100vh;">
                        @Body
                    </MudContainer>
                }
                else
                {
                    <LoginRedirect />
                }
            </NotAuthorized>
        </AuthorizeView>
    </MudLayout>
</div>

@code {
    [Inject] private AuthenticationStateProvider AuthenticationStateProvider { get; set; } = default!;
    private bool _drawerOpen = true;
    private bool _isLoading = false;
    private string _loadingText = "Đang tải...";
    private List<BreadcrumbItem> _breadcrumbItems = new();

    private string GetUserInitial(AuthenticationState context)
    {
        try
        {
            // Log để debug
            foreach (var claim in context.User.Claims)
            {
                Console.WriteLine($"Claim found - Type: {claim.Type}, Value: {claim.Value}");
            }

            // Thử tìm theo nhiều loại claim type khác nhau
            var hoTen = context.User.Claims.FirstOrDefault(c => c.Type == "hoTen")?.Value ??
                       context.User.Claims.FirstOrDefault(c => c.Type == ClaimTypes.GivenName)?.Value ??
                       context.User.Claims.FirstOrDefault(c => c.Type == "name")?.Value;

            if (!string.IsNullOrEmpty(hoTen))
            {
                Console.WriteLine($"Found hoTen: {hoTen}");
                return hoTen[0].ToString().ToUpper();
            }

            // Fallback to AuthState if claim not found
            if (AuthState.Value.CurrentUser?.HoTen != null)
            {
                Console.WriteLine($"Using AuthState HoTen: {AuthState.Value.CurrentUser.HoTen}");
                return AuthState.Value.CurrentUser.HoTen[0].ToString().ToUpper();
            }

            Console.WriteLine("No name found, returning U");
            return "U";
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error in GetUserInitial: {ex.Message}");
            return "U";
        }
    }

    private string GetCurrentPageTitle()
    {
        var uri = new Uri(NavigationManager.Uri);
        var segments = uri.Segments;
        if (segments.Length > 1)
        {
            var lastSegment = segments.Last().Trim('/');
            return char.ToUpper(lastSegment[0]) + lastSegment[1..];
        }
        return "Dashboard";
    }

    private void UpdateBreadcrumbs()
    {
        var uri = new Uri(NavigationManager.Uri);
        var segments = uri.Segments.Skip(1).ToList();

        _breadcrumbItems.Clear();
        _breadcrumbItems.Add(new BreadcrumbItem("Home", "/"));

        var currentPath = "";
        foreach (var segment in segments.Where(s => !string.IsNullOrWhiteSpace(s)))
        {
            currentPath += "/" + segment.TrimEnd('/');
            var title = char.ToUpper(segment[0]) + segment[1..].TrimEnd('/');
            _breadcrumbItems.Add(new BreadcrumbItem(title, currentPath));
        }
    }

    private bool IsPublicPage =>
        NavigationManager.Uri.EndsWith("/login", StringComparison.OrdinalIgnoreCase) ||
        NavigationManager.Uri.EndsWith("/", StringComparison.OrdinalIgnoreCase);

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            if (authState.User.Identity?.IsAuthenticated == true)
            {
                // Log tất cả claims hiện có
                foreach (var claim in authState.User.Claims)
                {
                    Console.WriteLine($"Initial Claim - Type: {claim.Type}, Value: {claim.Value}");
                }

                UpdateBreadcrumbs();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Lỗi khi khởi tạo: {ex.Message}", Severity.Error);
            Console.WriteLine($"Error in OnInitializedAsync: {ex}");
        }

        NavigationManager.LocationChanged += HandleLocationChanged;
    }

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        UpdateBreadcrumbs();
        StateHasChanged();
    }

    public void ShowLoading(string text = "Đang tải...")
    {
        _isLoading = true;
        _loadingText = text;
        StateHasChanged();
    }

    public void HideLoading()
    {
        _isLoading = false;
        StateHasChanged();
    }

    private async Task HandleLogout()
    {
        try
        {
            ShowLoading("Đang đăng xuất...");
            if (AuthenticationStateProvider is CustomAuthStateProvider authStateProvider)
            {
                await authStateProvider.MarkUserAsLoggedOut();
                NavigationManager.NavigateTo("/", true);
                Snackbar.Add("Đăng xuất thành công", Severity.Success);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Lỗi khi đăng xuất: {ex.Message}", Severity.Error);
            Console.WriteLine($"Lỗi trong quá trình đăng xuất: {ex.Message}");
        }
        finally
        {
            HideLoading();
        }
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= HandleLocationChanged;
    }
}