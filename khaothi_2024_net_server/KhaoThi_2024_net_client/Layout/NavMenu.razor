@using KhaoThi_2024_net_client.Models.Auth
@using static KhaoThi_2024_net_client.Services.Auth.AuthActions
@inject IDispatcher Dispatcher
@inject IState<AuthState> AuthState

<MudNavMenu>
    <AuthorizeView>
        <Authorized>
            <div class="px-4 py-2">
                <MudText Typo="Typo.subtitle1">KhaoThi 2024</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">Xin chào,</MudText>
                <MudText Typo="Typo.body1" Class="mt-n1">@AuthState.Value.CurrentUser?.HoTen</MudText>
            </div>

            <MudDivider Class="my-2" />

            <MudNavLink Href="dashboard" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard">
                Dashboard
            </MudNavLink>

            <MudNavLink Href="counter" Icon="@Icons.Material.Filled.Add">
                Counter
            </MudNavLink>

            <MudNavLink Href="weather" Icon="@Icons.Material.Filled.CloudQueue">
                Weather
            </MudNavLink>

            <MudSpacer />

            <MudNavLink OnClick="HandleLogout" Icon="@Icons.Material.Filled.Logout" Class="mt-auto">
                Đăng xuất
            </MudNavLink>
        </Authorized>
        <NotAuthorized>
            <MudNavLink Href="login" Icon="@Icons.Material.Filled.Login">
                Đăng nhập
            </MudNavLink>
        </NotAuthorized>
    </AuthorizeView>
</MudNavMenu>

@code {
    private async Task HandleLogout()
    {
        try
        {
            await Logger.Info($"User {AuthState.Value.CurrentUser?.TenDangNhap} logging out");
            Dispatcher.Dispatch(new LogoutAction());
        }
        catch (Exception ex)
        {
            await Logger.Error("Error during logout", ex);
        }
    }
}