@using KhaoThi_2024_net_client.Models.Auth
@using static KhaoThi_2024_net_client.Services.Auth.AuthActions
@using Microsoft.Extensions.Logging
@inject IDispatcher Dispatcher
@inject IState<AuthState> AuthState
@inject ILogger<NavMenu> Logger
@inject NavigationManager NavigationManager

<div class="nav-container">
    <MudNavMenu Color="Color.Dark" Class="mud-navmenu">
        <AuthorizeView>
            <Authorized>
                <div class="menu-header d-flex flex-column align-center">
                    <img src="/images/logo_NEW.png" alt="Logo Sở Giáo dục và Đào tạo" class="company-logo" style="width: 100px; height: 100px;" />
                    <MudText Typo="Typo.h6">
                        Hệ thống quản lý
                    </MudText>
                </div>
                <div class="profile-section d-flex align-center">
                    <MudAvatar Color="Color.Primary" Size="Size.Medium">
                        @(GetFirstCharsOfName(@context.User.FindFirst("HoTen")?.Value.ToString().ToUpper()))
                    </MudAvatar>
                    <div class="user-info">
                        <div class="user-name">@(@context.User.FindFirst("HoTen")?.Value ?? "Người dùng")</div>
                        <div class="user-role"> @GetChucVuDisplay(context.User.FindFirst("MaChucVu")?.Value ?? "Chưa có chức vụ")</div>
                    </div>
                </div>

                <div class="menu-section">CÔNG CỤ QUẢN LÝ</div>
                <MudNavLink Href="dashboard" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard">
                    Thông tin hệ thống
                </MudNavLink>

                <div class="menu-section">QUẢN LÝ</div>
                <MudNavLink Href="/profile" Icon="@Icons.Material.Filled.People">
                    Người dùng
                </MudNavLink>

                @{
                    var maChucVu = context.User.FindFirst("MaChucVu")?.Value;
                    if (maChucVu == "01") // Chỉ hiển thị các menu khác cho quản trị viên
                    {
                        <MudNavLink Href="departments" Icon="@Icons.Material.Filled.Business">
                            Đơn vị
                        </MudNavLink>

                        <div class="menu-section">BÁO CÁO</div>
                        <MudNavLink Href="reports" Icon="@Icons.Material.Filled.BarChart">
                            Thống kê
                        </MudNavLink>
                        <MudNavLink Href="analytics" Icon="@Icons.Material.Filled.Analytics">
                            Phân tích
                        </MudNavLink>

                        <div class="menu-section">OTHER</div>
                        <MudNavLink Href="settings" Icon="@Icons.Material.Filled.Settings">
                            Cài đặt
                        </MudNavLink>
                    }
                }

                <MudNavLink OnClick="@HandleLogout" Icon="@Icons.Material.Filled.Logout">
                    Đăng xuất
                </MudNavLink>
            </Authorized>

            <NotAuthorized>
                <div class="menu-header">
                    <MudText Typo="Typo.h6">
                        <MudIcon Icon="@Icons.Material.Filled.School" Class="mr-2" Size="Size.Small" />
                        KhaoThi 2024
                    </MudText>
                </div>
                <div class="pa-4">
                    <MudButton Href="login"
                               Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Login"
                               FullWidth="true">
                        Đăng nhập
                    </MudButton>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </MudNavMenu>
</div>

@code {
    [Inject] private AuthenticationStateProvider AuthenticationStateProvider { get; set; } = default!;
    private void HandleLogout()
    {
        try
        {
            if (AuthState.Value.CurrentUser != null)
            {
                var username = AuthState.Value.CurrentUser.TenDangNhap ?? "Unknown";
                //Logger.LogInformation($"Người dùng {username} đang đăng xuất");
                Dispatcher.Dispatch(new LogoutAction());
            }
            else
            {
                Logger.LogWarning("Cố gắng đăng xuất khi không có người dùng đăng nhập");
                Dispatcher.Dispatch(new LogoutAction());
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Lỗi trong quá trình đăng xuất");
            throw;
        }
    }
    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        var maChucVu = user.FindFirst("MaChucVu")?.Value;
    }

    private string GetChucVuDisplay(string? maChucVu)
    {
        return maChucVu switch
        {
            "01" => "Quản trị viên",
            "02" => "Người dùng",
            _ => maChucVu ?? "Không xác định"
        };
    }
    private string GetFirstCharsOfName(string? HoTen)
    {
        var parts = HoTen?.ToUpper().Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        // Lấy phần tử cuối cùng (tên)
        return parts?.Last()[0].ToString().ToUpper() ?? "U";
    }
}