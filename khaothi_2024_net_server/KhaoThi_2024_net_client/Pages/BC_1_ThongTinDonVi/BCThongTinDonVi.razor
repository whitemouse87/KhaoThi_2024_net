                                                <MudText>
                                                    <span class="font-weight-bold">Trạng thái khóa:</span>
                                                    @(DonVi.Lock ? "Đã khóa (chỉ Admin có thể mở khóa)" : "Đang mở (cho phép nhập liệu)")
