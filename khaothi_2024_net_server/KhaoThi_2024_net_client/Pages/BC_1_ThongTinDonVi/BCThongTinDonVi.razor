@code {
    [Parameter]
    public string MaDonVi { get; set; }

    private KhaoThi_1_THPT_ThongTin_DonViModel DonVi { get; set; } = new();
    private string _errorMessage = string.Empty;
    private bool IsLoading => DonViState.Value.IsLoading;
    private string _lastNotificationMessage;
    private bool _debugMode = false;

    protected override async Task OnInitializedAsync()
    {
        // Đăng ký nhận sự kiện thay đổi trạng thái
        DonViState.StateChanged += HandleStateChanged;

        // Lấy mã đơn vị từ query string
        ExtractMaDonViFromQueryString();

        //Console.WriteLine($"OnInitializedAsync - MaDonVi: {MaDonVi}");
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Tải dữ liệu chỉ khi render lần đầu
            await LoadData();
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        //Console.WriteLine($"OnParametersSetAsync - MaDonVi: {MaDonVi}");

        // Kiểm tra query string nếu MaDonVi không có giá trị từ route parameter
        if (string.IsNullOrEmpty(MaDonVi))
        {
            ExtractMaDonViFromQueryString();
        }

        // Nếu có mã đơn vị và cần tải lại dữ liệu
        if (!string.IsNullOrEmpty(MaDonVi) && (DonVi == null || DonVi.MaTruong != MaDonVi))
        {
            await LoadData();
        }
    }

    private void ExtractMaDonViFromQueryString()
    {
        var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
        if (QueryHelpers.ParseQuery(uri.Query).TryGetValue("maDonVi", out var maDonViParam))
        {
            MaDonVi = maDonViParam.First();
            //Console.WriteLine($"Đã trích xuất mã đơn vị từ query string: {MaDonVi}");
        }
    }

    private async Task LoadData()
    {
        if (!string.IsNullOrEmpty(MaDonVi))
        {
            //Console.WriteLine($"LoadData - Tải dữ liệu cho mã đơn vị: {MaDonVi}");

            // Reset thông báo trước khi tải mới
            _lastNotificationMessage = null;

            // Gửi action để lấy dữ liệu
            Dispatcher.Dispatch(new GetDonViByMaTruongAction(MaDonVi));
        }
        else
        {
            // Khởi tạo bản ghi trống mới
            //Console.WriteLine("LoadData - Tạo đơn vị mới");
            DonVi = new KhaoThi_1_THPT_ThongTin_DonViModel();
            StateHasChanged();
        }
    }

    private void HandleStateChanged(object sender, EventArgs e)
    {
        try
        {
            var state = DonViState.Value;
            //Console.WriteLine($"HandleStateChanged - State ID: {state.Id}, SelectedDonVi: {state.SelectedDonVi?.MaTruong ?? "null"}");

            // Cập nhật thông báo lỗi
            _errorMessage = state.ErrorMessage ?? string.Empty;

            // Nếu có đơn vị được chọn, cập nhật mô hình cục bộ
            if (state.SelectedDonVi != null)
            {
                //Console.WriteLine($"HandleStateChanged - Cập nhật DonVi với MaTruong: {state.SelectedDonVi.MaTruong}, TenTruong: {state.SelectedDonVi.TenTruong}");
                DonVi = state.SelectedDonVi;
            }

            // Hiển thị thông báo nếu có tin nhắn và không trùng lặp với thông báo trước đó
            if (!string.IsNullOrEmpty(state.NotificationMessage) &&
                state.NotificationMessage != _lastNotificationMessage)
            {
                _lastNotificationMessage = state.NotificationMessage;
                //Console.WriteLine($"HandleStateChanged - Hiển thị thông báo: {state.NotificationMessage}, Loại: {state.NotificationType}");

                var severity = state.NotificationType?.ToLower() == "success"
                    ? Severity.Success
                    : Severity.Error;

                Snackbar.Add(state.NotificationMessage, severity);
            }

            // Cập nhật UI
            StateHasChanged();
        }
        catch (Exception ex)
        {
            //Console.WriteLine($"Lỗi trong HandleStateChanged: {ex.Message}");
            _errorMessage = $"Lỗi xử lý sự kiện: {ex.Message}";
            StateHasChanged();
        }
    }

    private async Task SaveData()
    {
        if (string.IsNullOrEmpty(DonVi.MaTruong))
        {
            Snackbar.Add("Mã trường không được để trống", Severity.Error);
            return;
        }

        //Console.WriteLine($"SaveData - Lưu dữ liệu cho MaTruong: {DonVi.MaTruong}");
        _lastNotificationMessage = null; // Reset notification tracker

        // Thêm thông báo trước khi lưu
        Snackbar.Add("Đang lưu dữ liệu...", Severity.Info);

        // Gửi action để cập nhật
        Dispatcher.Dispatch(new UpdateDonViAction(DonVi));
    }

    // Force reload - có thể gọi từ UI nếu cần
    private async Task ForceReload()
    {
        if (!string.IsNullOrEmpty(MaDonVi))
        {
            //Console.WriteLine($"ForceReload - Đang tải lại dữ liệu cho MaTruong: {MaDonVi}");
            await LoadData();
        }
    }

    public void Dispose()
    {
        // Hủy đăng ký sự kiện thay đổi trạng thái để tránh rò rỉ bộ nhớ
        //Console.WriteLine("Dispose - Hủy đăng ký sự kiện StateChanged");
        DonViState.StateChanged -= HandleStateChanged;
    }
}