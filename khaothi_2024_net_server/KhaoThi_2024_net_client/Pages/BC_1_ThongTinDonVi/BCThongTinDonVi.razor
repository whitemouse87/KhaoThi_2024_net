                                                  AdornmentIcon="@Icons.Material.Filled.WorkOutline" />
                                </MudPaper>
                            </MudItem>

                            <MudItem xs="12" md="3">
                                <MudPaper Elevation="0" Class="pa-3 rounded-lg">
                                    <MudTextField T="string" Label="Số Điện Thoại Di Động"
                                                  @bind-Value="DonVi.SDTDiDongNhapLieu"
                                                  Variant="MudBlazor.Variant.Outlined"
                                                  MaxLength="100" Required="true"
                                                  Counter="100"
                                                  Adornment="Adornment.Start"
                                                  AdornmentIcon="@Icons.Material.Filled.Smartphone" />
                                </MudPaper>
                            </MudItem>

                            <MudItem xs="12" md="3">
                                <MudPaper Elevation="0" Class="pa-3 rounded-lg">
                                    <MudTextField T="string" Label="Email Nhập Liệu"
                                                  @bind-Value="DonVi.EmailNhapLieu"
                                                  Variant="MudBlazor.Variant.Outlined"
                                                  MaxLength="100" Required="true"
                                                  Counter="100"
                                                  Adornment="Adornment.Start"
                                                  AdornmentIcon="@Icons.Material.Filled.AlternateEmail" />
                                </MudPaper>
                            </MudItem>
                        </MudGrid>
                    </MudCardContent>
                </MudCard>
            </MudItem>

            <MudItem xs="12">
                <MudCard Elevation="0" Class="border-none mt-6">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudText Typo="Typo.h5" Class="primary-text font-weight-bold">THÔNG TIN NHÂN SỰ</MudText>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent>
                        <MudDivider Class="mb-4" />
                        <MudGrid>
                            <MudItem xs="12" md="3">
                                <MudPaper Elevation="2" Class="pa-4 rounded-lg mud-theme-primary">
                                    <MudStack Row="true" AlignItems="MudBlazor.AlignItems.Center">
                                        <MudIcon Icon="@Icons.Material.Filled.SupervisorAccount" Size="Size.Large" Class="mr-3" />
                                        <div>
                                            <MudText Typo="Typo.subtitle2">Tổng Hiệu Trưởng</MudText>
                                            <MudNumericField T="int" @bind-Value="DonVi.TongHieuTruong" Min="0" Variant="MudBlazor.Variant.Outlined" Class="mt-1" />
                                        </div>
                                    </MudStack>
                                </MudPaper>
                            </MudItem>

                            <MudItem xs="12" md="3">
                                <MudPaper Elevation="2" Class="pa-4 rounded-lg mud-theme-secondary">
                                    <MudStack Row="true" AlignItems="MudBlazor.AlignItems.Center">
                                        <MudIcon Icon="@Icons.Material.Filled.ManageAccounts" Size="Size.Large" Class="mr-3" />
                                        <div>
                                            <MudText Typo="Typo.subtitle2">Tổng Phó Hiệu Trưởng</MudText>
                                            <MudNumericField T="int" @bind-Value="DonVi.TongPhoHieuTruong" Min="0" Variant="MudBlazor.Variant.Outlined" Class="mt-1" />
                                        </div>
                                    </MudStack>
                                </MudPaper>
                            </MudItem>

                            <MudItem xs="12" md="3">
                                <MudPaper Elevation="2" Class="pa-4 rounded-lg mud-theme-tertiary">
                                    <MudStack Row="true" AlignItems="MudBlazor.AlignItems.Center">
                                        <MudIcon Icon="@Icons.Material.Filled.Groups" Size="Size.Large" Class="mr-3" />
                                        <div>
                                            <MudText Typo="Typo.subtitle2">Tổng Giáo Viên</MudText>
                                            <MudNumericField T="int" @bind-Value="DonVi.TongGiaoVien" Min="0" Variant="MudBlazor.Variant.Outlined" Class="mt-1" />
                                        </div>
                                    </MudStack>
                                </MudPaper>
                            </MudItem>

                            <MudItem xs="12" md="3">
                                <MudPaper Elevation="2" Class="pa-4 rounded-lg mud-theme-info">
                                    <MudStack Row="true" AlignItems="MudBlazor.AlignItems.Center">
                                        <MudIcon Icon="@Icons.Material.Filled.PeopleAlt" Size="Size.Large" Class="mr-3" />
                                        <div>
                                            <MudText Typo="Typo.subtitle2">Tổng Nhân Viên</MudText>
                                            <MudNumericField T="int" @bind-Value="DonVi.TongNhanVien" Min="0" Variant="MudBlazor.Variant.Outlined" Class="mt-1" />
                                        </div>
                                    </MudStack>
                                </MudPaper>
                            </MudItem>

                            <MudItem xs="12" md="3">
                                <MudPaper Elevation="0" Class="pa-3 rounded-lg">
                                    <MudNumericField T="int" Label="Tổng Giáo Viên Tổ Trưởng"
                                                     @bind-Value="DonVi.TongGiaoVien_ToTruong"
                                                     Variant="MudBlazor.Variant.Outlined"
                                                     Min="0"
                                                     Adornment="Adornment.Start"
                                                     AdornmentIcon="@Icons.Material.Filled.AssignmentInd" />
                                </MudPaper>
                            </MudItem>

                            <MudItem xs="12" md="3">
                                <MudPaper Elevation="0" Class="pa-3 rounded-lg">
                                    <MudNumericField T="int" Label="Tổng Giáo Viên Coi Thi"
                                                     @bind-Value="DonVi.TongGiaoVien_CoiThi"
                                                     Variant="MudBlazor.Variant.Outlined"
                                                     Min="0"
                                                     Adornment="Adornment.Start"
                                                     AdornmentIcon="@Icons.Material.Filled.AssignmentTurnedIn" />
                                </MudPaper>
                            </MudItem>

                            <MudItem xs="12" md="3">
                                <MudPaper Elevation="0" Class="pa-3 rounded-lg">
                                    <MudNumericField T="int" Label="Tổng Số Phòng Tối Đa"
                                                     @bind-Value="DonVi.TongSoPhongToiDa"
                                                     Variant="MudBlazor.Variant.Outlined"
                                                     Min="0"
                                                     Adornment="Adornment.Start"
                                                     AdornmentIcon="@Icons.Material.Filled.MeetingRoom" />
                                </MudPaper>
                            </MudItem>

                            <MudItem xs="12" md="3">
                                <MudPaper Elevation="0" Class="pa-3 rounded-lg">
                                    <MudNumericField T="int" Label="Tổng Số Phòng Coi Thi"
                                                     @bind-Value="DonVi.TongSoPhongCoiThi"
                                                     Variant="MudBlazor.Variant.Outlined"
                                                     Min="0"
                                                     Adornment="Adornment.Start"
                                                     AdornmentIcon="@Icons.Material.Filled.DoorFront" />
                                </MudPaper>
                            </MudItem>
                        </MudGrid>
                    </MudCardContent>
                </MudCard>
            </MudItem>

            <MudItem xs="12">
                <MudCard Elevation="0" Class="border-none mt-6">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudText Typo="Typo.h5" Class="primary-text font-weight-bold">THÔNG TIN HỌC SINH</MudText>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent>
                        <MudDivider Class="mb-4" />
                        <MudGrid>
                            <MudItem xs="12" md="4">
                                <MudPaper Elevation="3" Class="pa-4 rounded-lg">
                                    <MudStack AlignItems="MudBlazor.AlignItems.Center">
                                        <MudIcon Icon="@Icons.Material.Filled.School" Color="Color.Primary" Size="Size.Large" />
                                        <MudText Typo="Typo.h6" Class="mt-2">Tổng Học Sinh Lớp 12</MudText>
                                        <MudNumericField T="int" @bind-Value="DonVi.Tong_HS_12" Min="0" Variant="MudBlazor.Variant.Filled" Class="mt-1" />
                                    </MudStack>
                                </MudPaper>
                            </MudItem>

                            <MudItem xs="12" md="4">
                                <MudExpansionPanels>
                                    <MudExpansionPanel>
                                        <TitleContent>
                                            <MudText Typo="Typo.h6">Học sinh đặc biệt</MudText>
                                        </TitleContent>
                                        <ChildContent>
                                            <MudGrid>
                                                <MudItem xs="12">
                                                    <MudNumericField T="int" Label="HS Khuyết Tật Nhẹ"
                                                                     @bind-Value="DonVi.Tong_HS_KhuyetTat_Nhe"
                                                                     Variant="MudBlazor.Variant.Outlined"
                                                                     Adornment="Adornment.Start"
                                                                     AdornmentIcon="@Icons.Material.Filled.Accessibility"
                                                                     Min="0" />
                                                </MudItem>

                                                <MudItem xs="12">
                                                    <MudNumericField T="int" Label="HS Khuyết Tật Nặng"
                                                                     @bind-Value="DonVi.Tong_HS_KhuyetTat_Nang"
                                                                     Variant="MudBlazor.Variant.Outlined"
                                                                     Adornment="Adornment.Start"
                                                                     AdornmentIcon="@Icons.Material.Filled.AccessibilityNew"
                                                                     Min="0" />
                                                </MudItem>

                                                <MudItem xs="12">
                                                    <MudNumericField T="int" Label="HS Khiếm Thị"
                                                                     @bind-Value="DonVi.Tong_HS_KhiemThi"
                                                                     Variant="MudBlazor.Variant.Outlined"
                                                                     Adornment="Adornment.Start"
                                                                     AdornmentIcon="@Icons.Material.Filled.Visibility"
                                                                     Min="0" />
                                                </MudItem>

                                                <MudItem xs="12">
                                                    <MudNumericField T="int" Label="HS Cần Hỗ Trợ Đặc Biệt"
                                                                     @bind-Value="DonVi.Tong_HS_CanHoTroDacBiet"
                                                                     Variant="MudBlazor.Variant.Outlined"
                                                                     Adornment="Adornment.Start"
                                                                     AdornmentIcon="@Icons.Material.Filled.SupportAgent"
