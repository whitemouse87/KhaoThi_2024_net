@page "/bao-cao-thong-tin-don-vi"
@page "/bao-cao-thong-tin-don-vi/{MaDonVi}"
@using KhaoThi_2024_net_client.Models.BaoCaoSoLieu
@using MudBlazor
@using KhaoThi_2024_net_client.Services.BC_1_ThongTinDonVi
@using static KhaoThi_2024_net_client.Services.BC_1_ThongTinDonVi.BCThongTinDonViAction
@inject IDispatcher Dispatcher
@inject ISnackbar Snackbar
@inject NotificationService NotificationService
@using Blazored.Modal
@using Blazored.Modal.Services
@using System.ComponentModel.DataAnnotations
@using Radzen
@using Radzen.Blazor
@using Microsoft.AspNetCore.WebUtilities
@inject IState<BCThongTinDonViState> DonViState
@inject IBCThongTinDonViService BCThongTinDonViService
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@implements IDisposable

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
    <MudPaper Elevation="3" Class="pa-4">
        <MudText Typo="Typo.h4" Class="mb-4">Thông Tin Trường Học</MudText>

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <MudAlert Severity="Severity.Error" Class="my-4">@_errorMessage</MudAlert>
        }

        <div class="d-flex justify-start mb-6">
            <MudButton Variant="MudBlazor.Variant.Filled"
                       Color="Color.Primary"
                       Size="Size.Large"
                       StartIcon="@Icons.Material.Filled.Save"
                       OnClick="SaveData"
                       Disabled="@IsLoading">
                LƯU DỮ LIỆU
            </MudButton>
        </div>

        @if (IsLoading)
        {
            <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-4" />
        }

    <EditForm Model="@DonVi" OnValidSubmit="SaveData">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <MudGrid>
            <MudItem xs="12">
                <MudCard Elevation="0" Class="border-none">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudText Typo="Typo.h5" Class="primary-text font-weight-bold">THÔNG TIN CHUNG</MudText>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent>
                        <MudDivider Class="mb-4" />
                        <MudGrid>
                            <!-- Hàng 1: 4 cột -->
                            <MudItem xs="12" md="3">
                                <MudPaper Elevation="0" Class="pa-3 rounded-lg">
                                    <MudTextField T="string" Label="Mã Trường"
                                                  @bind-Value="DonVi.MaTruong"
                                                  Variant="MudBlazor.Variant.Outlined"
                                                  MaxLength="100" Required="true"
                                                  Counter="100"
                                                  Adornment="Adornment.Start"
                                                  AdornmentIcon="@Icons.Material.Filled.School"
                                                  HelperText="Mã trường của phòng Khảo thí cấp" Disabled="true" />
                                </MudPaper>
                            </MudItem>

                            <MudItem xs="12" md="3">
                                <MudPaper Elevation="0" Class="pa-3 rounded-lg">
                                    <MudTextField T="string" Label="Tên Trường"
                                                  @bind-Value="DonVi.TenTruong"
                                                  Variant="MudBlazor.Variant.Outlined"
                                                  MaxLength="255" Required="true"
                                                  Adornment="Adornment.Start"
                                                  AdornmentIcon="@Icons.Material.Filled.BusinessCenter" Disabled="true" />
                                </MudPaper>
                            </MudItem>

                            <MudItem xs="12" md="3">
                                <MudPaper Elevation="0" Class="pa-3 rounded-lg">
                                    <MudTextField T="string" Label="Email Nhận Thông Báo"
                                                  @bind-Value="DonVi.EmailNhanThongBao"
                                                  Variant="MudBlazor.Variant.Outlined"
                                                  MaxLength="100" Required="true"
                                                  Counter="100"
                                                  Adornment="Adornment.Start"
                                                  AdornmentIcon="@Icons.Material.Filled.Email" />
                                </MudPaper>
                            </MudItem>

                            <MudItem xs="12" md="3">
                                <MudPaper Elevation="0" Class="pa-3 rounded-lg">
                                    <MudSelect T="string" Label="Loại Hình Đào Tạo"
                                               @bind-Value="DonVi.LoaiHinhDaoTao"
                                               Variant="MudBlazor.Variant.Outlined"
                                               Required="true"
                                               Adornment="Adornment.Start"
                                               AdornmentIcon="@Icons.Material.Filled.Category">
                                        <MudSelectItem Value="@("Công lập")">Công lập</MudSelectItem>
                                        <MudSelectItem Value="@("Dân lập")">Dân lập</MudSelectItem>
                                        <MudSelectItem Value="@("Tư thục")">Tư thục</MudSelectItem>
                                        <MudSelectItem Value="@("Quốc tế")">Quốc tế</MudSelectItem>
                                    </MudSelect>
                                </MudPaper>
                            </MudItem>

                            <!-- Hàng 2: 4 cột -->
                            <MudItem xs="12" md="3">
                                <MudPaper Elevation="0" Class="pa-3 rounded-lg">
                                    <MudTextField T="string" Label="Mã Trường Bộ"
                                                  @bind-Value="DonVi.MaTruongBo"
                                                  Variant="MudBlazor.Variant.Outlined"
                                                  MaxLength="100" Required="true"
                                                  Counter="100"
                                                  Adornment="Adornment.Start"
                                                  AdornmentIcon="@Icons.Material.Filled.Code" />
                                </MudPaper>
                            </MudItem>

                            <MudItem xs="12" md="3">
                                <MudPaper Elevation="0" Class="pa-3 rounded-lg">
                                    <MudTextField T="int" Label="Quận huyện"
                                                  @bind-Value="DonVi.QuanDangKyDuThi"
                                                  Variant="MudBlazor.Variant.Outlined"
                                                  Min="0"
                                                  Adornment="Adornment.Start"
                                                  AdornmentIcon="@Icons.Material.Filled.LocationCity" />
                                </MudPaper>
                            </MudItem>

                            <MudItem xs="12" md="3">
                                <MudPaper Elevation="0" Class="pa-3 rounded-lg">
                                    <MudTextField T="string" Label="Số Điện Thoại Trường"
                                                  @bind-Value="DonVi.SDTTruong"
                                                  Variant="MudBlazor.Variant.Outlined"
                                                  MaxLength="100" Required="true"
                                                  Counter="100"
                                                  Adornment="Adornment.Start"
                                                  AdornmentIcon="@Icons.Material.Filled.Phone" />
                                </MudPaper>
                            </MudItem>

                            <MudItem xs="12" md="3">
                                <MudPaper Elevation="0" Class="pa-3 rounded-lg">
                                    <MudTextField T="string" Label="Số Điện Thoại Phòng Hội Đồng"
                                                  @bind-Value="DonVi.SDTPhongHoiDong"
                                                  Variant="MudBlazor.Variant.Outlined"
                                                  MaxLength="100"
                                                  Counter="100"
                                                  Adornment="Adornment.Start"
                                                  AdornmentIcon="@Icons.Material.Filled.PhonelinkRing" />
                                </MudPaper>
                            </MudItem>

                            <!-- Hàng 3: 1 cột chiếm toàn bộ -->
                            <MudItem xs="12">
                                <MudPaper Elevation="0" Class="pa-3 rounded-lg">
                                    <MudTextField T="string" Label="Địa Chỉ Trường"
                                                  @bind-Value="DonVi.DiaChiTruong"
                                                  Variant="MudBlazor.Variant.Outlined"
                                                  MaxLength="255" Required="true"
                                                  Counter="255"
                                                  Adornment="Adornment.Start"
                                                  AdornmentIcon="@Icons.Material.Filled.Place" />
                                </MudPaper>
                            </MudItem>
                        </MudGrid>
                    </MudCardContent>
                </MudCard>
            </MudItem>

            <MudItem xs="12">
                <MudCard Elevation="0" Class="border-none mt-6">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudText Typo="Typo.h5" Class="primary-text font-weight-bold">THÔNG TIN NGƯỜI NHẬP LIỆU</MudText>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent>
                        <MudDivider Class="mb-4" />
                        <MudGrid>
                            <MudItem xs="12" md="3">
                                <MudPaper Elevation="0" Class="pa-3 rounded-lg">
                                    <MudTextField T="string" Label="Họ Tên Người Nhập Liệu"
                                                  @bind-Value="DonVi.HoTenNhapLieu"
                                                  Variant="MudBlazor.Variant.Outlined"
