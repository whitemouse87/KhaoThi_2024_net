@page "/bao-cao-thong-tin-don-vi"
@page "/bao-cao-thong-tin-don-vi/{MaDonVi}"
@using KhaoThi_2024_net_client.Models.BaoCaoSoLieu
@using MudBlazor
@using KhaoThi_2024_net_client.Services.BC_1_ThongTinDonVi
@using static KhaoThi_2024_net_client.Services.BC_1_ThongTinDonVi.BCThongTinDonViAction
@inject IDispatcher Dispatcher
@inject ISnackbar Snackbar
@inject NotificationService NotificationService
@using Blazored.Modal
@using Blazored.Modal.Services
@using System.ComponentModel.DataAnnotations
@using Radzen
@using Radzen.Blazor
@using Microsoft.AspNetCore.WebUtilities
@inject IState<BCThongTinDonViState> DonViState
@inject IBCThongTinDonViService BCThongTinDonViService
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@implements IDisposable

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
    <MudPaper Elevation="3" Class="pa-4">

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <MudAlert Severity="Severity.Error" Class="my-4">@_errorMessage</MudAlert>
        }



        @if (IsLoading)
        {
            <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-4" />
        }

        <EditForm Model="@DonVi" OnValidSubmit="SaveData">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <MudGrid>
                <MudItem xs="12">
                    <MudCard Elevation="0" Class="border-none">
                        <MudCardHeader Class="py-3" Style="background: linear-gradient(90deg, #2563EB, #3B82F6); border-radius: 8px 8px 0 0;">
                            <CardHeaderAvatar>
                                <MudAvatar Color="Color.Inherit" Style="background-color: rgba(255,255,255,0.2);">
                                    <MudIcon Icon="@Icons.Material.Filled.School" />
                                </MudAvatar>
                            </CardHeaderAvatar>
                            <CardHeaderContent>
                                <MudText Typo="Typo.h6" Style="color: white; font-weight: 500; letter-spacing: 0.5px;">
                                    Thông tin chung
                                </MudText>
                            </CardHeaderContent>
                            <CardHeaderActions>
                                <MudIconButton Icon="@Icons.Material.Filled.ExpandMore" Color="Color.Inherit" Style="color: white;" />
                            </CardHeaderActions>
                        </MudCardHeader>
                        <MudCardContent>
                            <MudDivider Class="mb-4" />
                            <MudGrid>
                                <!-- Hàng 1: 4 cột -->
                                <MudItem xs="12" md="3">
                                    <MudPaper Elevation="0" Class="pa-3 rounded-lg">
                                        <MudTextField T="string" Label="Mã Trường"
                                                      @bind-Value="DonVi.MaTruong"
                                                      Variant="MudBlazor.Variant.Outlined"
                                                      MaxLength="100" Required="true"
                                                      Counter="100"
                                                      Adornment="Adornment.Start"
                                                      AdornmentIcon="@Icons.Material.Filled.School"
                                                      HelperText="Mã trường của phòng Khảo thí cấp" Disabled="true" />
                                    </MudPaper>
                                </MudItem>

                                <MudItem xs="12" md="3">
                                    <MudPaper Elevation="0" Class="pa-3 rounded-lg">
                                        <MudTextField T="string" Label="Tên Trường"
                                                      @bind-Value="DonVi.TenTruong"
                                                      Variant="MudBlazor.Variant.Outlined"
                                                      MaxLength="255" Required="true"
                                                      Adornment="Adornment.Start"
                                                      AdornmentIcon="@Icons.Material.Filled.BusinessCenter" Disabled="true" />
                                    </MudPaper>
                                </MudItem>

                                <MudItem xs="12" md="3">
                                    <MudPaper Elevation="0" Class="pa-3 rounded-lg">
                                        <MudTextField T="string" Label="Email Nhận Thông Báo"
                                                      @bind-Value="DonVi.EmailNhanThongBao"
                                                      Variant="MudBlazor.Variant.Outlined"
                                                      MaxLength="100" Required="true"
                                                      Counter="100"
                                                      Adornment="Adornment.Start"
                                                      AdornmentIcon="@Icons.Material.Filled.Email" />
                                    </MudPaper>
                                </MudItem>

                                <MudItem xs="12" md="3">
                                    <MudPaper Elevation="0" Class="pa-3 rounded-lg">
                                        <MudSelect T="string" Label="Loại Hình Đào Tạo"
                                                   @bind-Value="DonVi.LoaiHinhDaoTao"
                                                   Variant="MudBlazor.Variant.Outlined"
                                                   Required="true"
                                                   Adornment="Adornment.Start"
                                                   AdornmentIcon="@Icons.Material.Filled.Category">
                                            <MudSelectItem Value="@("Công lập")">Công lập</MudSelectItem>
                                            <MudSelectItem Value="@("Dân lập")">Dân lập</MudSelectItem>
                                            <MudSelectItem Value="@("Tư thục")">Tư thục</MudSelectItem>
                                            <MudSelectItem Value="@("Quốc tế")">Quốc tế</MudSelectItem>
                                        </MudSelect>
                                    </MudPaper>
                                </MudItem>

                                <!-- Hàng 2: 4 cột -->
                                <MudItem xs="12" md="3">
                                    <MudPaper Elevation="0" Class="pa-3 rounded-lg">
                                        <MudTextField T="string" Label="Mã Trường Bộ"
                                                      @bind-Value="DonVi.MaTruongBo"
                                                      Variant="MudBlazor.Variant.Outlined"
                                                      MaxLength="100" Required="true"
                                                      Counter="100"
                                                      Adornment="Adornment.Start"
                                                      AdornmentIcon="@Icons.Material.Filled.Code" />
                                    </MudPaper>
                                </MudItem>

                                <MudItem xs="12" md="3">
                                    <MudPaper Elevation="0" Class="pa-3 rounded-lg">
                                        @*<MudTextField T="int" Label="Quận huyện"
                                            @bind-Value="DonVi.QuanDangKyDuThi"
                                            Variant="MudBlazor.Variant.Outlined"
                                            Min="0"
                                            Adornment="Adornment.Start"
                                            AdornmentIcon="@Icons.Material.Filled.LocationCity" />*@
                                        <MudSelect T="int" Label="Quận/Huyện"
                                                   @bind-Value="selectedQuanCode"
                                                   Variant="MudBlazor.Variant.Outlined"
                                                   Required="true"
                                                   Adornment="Adornment.Start"
                                                   AdornmentIcon="@Icons.Material.Filled.LocationCity"
                                                   Disabled="@isQuansLoading"
                                                   @onchange="@OnQuanChanged">
                                            @if (Quans != null)
                                            {
                                                @foreach (var quan in Quans)
                                                {
                                                    <MudSelectItem Value="@quan.MaQuan">@quan.TenQuan</MudSelectItem>
                                                }
                                            }
                                        </MudSelect>
                                    </MudPaper>
                                </MudItem>

                                <MudItem xs="12" md="3">
                                    <MudPaper Elevation="0" Class="pa-3 rounded-lg">
                                        <MudTextField T="string" Label="Số Điện Thoại Trường"
                                                      @bind-Value="DonVi.SDTTruong"
                                                      Variant="MudBlazor.Variant.Outlined"
                                                      MaxLength="100" Required="true"
                                                      Counter="100"
                                                      Adornment="Adornment.Start"
                                                      AdornmentIcon="@Icons.Material.Filled.Phone" />
                                    </MudPaper>
                                </MudItem>

                                <MudItem xs="12" md="3">
                                    <MudPaper Elevation="0" Class="pa-3 rounded-lg">
                                        <MudTextField T="string" Label="Số Điện Thoại Phòng Hội Đồng"
                                                      @bind-Value="DonVi.SDTPhongHoiDong"
                                                      Variant="MudBlazor.Variant.Outlined"
                                                      MaxLength="100"
                                                      Counter="100"
                                                      Adornment="Adornment.Start"
                                                      AdornmentIcon="@Icons.Material.Filled.PhonelinkRing" />
                                    </MudPaper>
                                </MudItem>

                                <!-- Hàng 3: 1 cột chiếm toàn bộ -->
                                <MudItem xs="12">
                                    <MudPaper Elevation="0" Class="pa-3 rounded-lg">
                                        <MudTextField T="string" Label="Địa Chỉ Trường"
                                                      @bind-Value="DonVi.DiaChiTruong"
                                                      Variant="MudBlazor.Variant.Outlined"
                                                      MaxLength="255" Required="true"
                                                      Counter="255"
                                                      Adornment="Adornment.Start"
                                                      AdornmentIcon="@Icons.Material.Filled.Place" />
                                    </MudPaper>
                                </MudItem>
                            </MudGrid>
                        </MudCardContent>
                    </MudCard>
                </MudItem>

                <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="my-4">
                    <MudGrid Spacing="2">
                        <!-- THÔNG TIN NGƯỜI NHẬP LIỆU - Left Column -->
                        <MudItem xs="12" md="6">
                            <MudCard Elevation="2" Class="rounded-lg h-100">
                                <MudCardHeader Class="py-3" Style="background: linear-gradient(90deg, #7C3AED, #8B5CF6); border-radius: 8px 8px 0 0;">
                                    <CardHeaderAvatar>
                                        <MudAvatar Color="Color.Inherit" Style="background-color: rgba(255,255,255,0.2);">
                                            <MudIcon Icon="@Icons.Material.Filled.ManageAccounts" />
                                        </MudAvatar>
                                    </CardHeaderAvatar>
                                    <CardHeaderContent>
                                        <MudText Typo="Typo.h6" Style="color: white; font-weight: 500; letter-spacing: 0.5px;">
                                            Thông tin người nhập liệu
                                        </MudText>
                                    </CardHeaderContent>
                                    <CardHeaderActions>
                                        <MudIconButton Icon="@Icons.Material.Filled.ExpandMore" Color="Color.Inherit" Style="color: white;" />
                                    </CardHeaderActions>
                                </MudCardHeader>

                                <MudCardContent Class="pa-4">
                                    <!-- Ghi chú: Hiển thị theo hàng dọc, mỗi hàng 1 item -->
                                    <MudGrid Spacing="2">
                                        <!-- Họ Tên -->
                                        <MudItem xs="12">
                                            <MudTextField T="string" Label="Họ Tên Người Nhập Liệu"
                                                          @bind-Value="DonVi.HoTenNhapLieu"
                                                          Variant="MudBlazor.Variant.Outlined"
                                                          MaxLength="255" Required="true"
                                                          Adornment="Adornment.Start"
                                                          AdornmentIcon="@Icons.Material.Filled.Person"
                                                          FullWidth="true" />
                                        </MudItem>

                                        <!-- Chức Vụ -->
                                        <MudItem xs="12">
                                            <MudTextField T="string" Label="Chức Vụ Nhập Liệu"
                                                          @bind-Value="DonVi.ChucVuNhapLieu"
                                                          Variant="MudBlazor.Variant.Outlined"
                                                          MaxLength="255" Required="true"
                                                          Adornment="Adornment.Start"
                                                          AdornmentIcon="@Icons.Material.Filled.WorkOutline"
                                                          FullWidth="true" />
                                        </MudItem>

                                        <!-- Số Điện Thoại -->
                                        <MudItem xs="12">
                                            <MudTextField T="string" Label="Số Điện Thoại Di Động"
                                                          @bind-Value="DonVi.SDTDiDongNhapLieu"
                                                          Variant="MudBlazor.Variant.Outlined"
                                                          MaxLength="100" Required="true"
                                                          Adornment="Adornment.Start"
                                                          AdornmentIcon="@Icons.Material.Filled.Smartphone"
                                                          FullWidth="true" />
                                        </MudItem>

                                        <!-- Email -->
                                        <MudItem xs="12">
                                            <MudTextField T="string" Label="Email Nhập Liệu"
                                                          @bind-Value="DonVi.EmailNhapLieu"
                                                          Variant="MudBlazor.Variant.Outlined"
                                                          MaxLength="100" Required="true"
                                                          Adornment="Adornment.Start"
                                                          AdornmentIcon="@Icons.Material.Filled.AlternateEmail"
                                                          FullWidth="true" />
                                        </MudItem>
                                    </MudGrid>
                                </MudCardContent>
                            </MudCard>
                        </MudItem>

                        <!-- THÔNG TIN NHÂN SỰ - Right Column -->
                        <MudItem xs="12" md="6">
                            <MudCard Elevation="2" Class="rounded-lg h-100">
                                <MudCardHeader Class="py-3" Style="background: linear-gradient(90deg, #059669, #10B981); border-radius: 8px 8px 0 0;">
                                    <CardHeaderAvatar>
                                        <MudAvatar Color="Color.Inherit" Style="background-color: rgba(255,255,255,0.2);">
                                            <MudIcon Icon="@Icons.Material.Filled.PeopleOutline" />
                                        </MudAvatar>
                                    </CardHeaderAvatar>
                                    <CardHeaderContent>
                                        <MudText Typo="Typo.h6" Style="color: white; font-weight: 500; letter-spacing: 0.5px;">
                                            Thông tin nhân sự
                                        </MudText>
                                    </CardHeaderContent>
                                    <CardHeaderActions>
                                        <MudIconButton Icon="@Icons.Material.Filled.ExpandMore" Color="Color.Inherit" Style="color: white;" />
                                    </CardHeaderActions>
                                </MudCardHeader>
                                <MudCardContent Class="pa-4 overflow-auto">
                                    <!-- Ghi chú: Section Thống kê chính - 4 ô trên một hàng -->
                                    <MudText Typo="Typo.subtitle1" Class="mb-3 d-flex align-center">
                                        <MudIcon Icon="@Icons.Material.Filled.BarChart" Class="mr-2" Size="Size.Small" /> Thống Kê Chính
                                    </MudText>
                                    <MudGrid Spacing="2">
                                        <!-- Hiệu Trưởng -->
                                        <MudItem xs="12" sm="6" lg="3">
                                            <MudPaper Elevation="2" Class="rounded-lg border-0 overflow-hidden">
                                                <MudGrid Spacing="0">
                                                    <MudItem xs="3" Style="background-color: #6366F1;">
                                                        <div class="d-flex justify-center align-center" style="height:100%; padding: 12px;">
                                                            <MudIcon Icon="@Icons.Material.Filled.SupervisorAccount" Color="Color.Inherit" />
                                                        </div>
                                                    </MudItem>
                                                    <MudItem xs="9" Class="pa-2">
                                                        <MudText Typo="Typo.caption" Class="mb-1 font-weight-bold">Hiệu Trưởng</MudText>
                                                        <MudNumericField T="int" @bind-Value="@DonVi.TongHieuTruong"
                                                                         Min="0"
                                                                         Variant="MudBlazor.Variant.Outlined"
                                                                         Dense="true"
                                                                         FullWidth="true" />
                                                    </MudItem>
                                                </MudGrid>
                                            </MudPaper>
                                        </MudItem>

                                        <!-- Phó Hiệu Trưởng -->
                                        <MudItem xs="12" sm="6" lg="3">
                                            <MudPaper Elevation="2" Class="rounded-lg border-0 overflow-hidden">
                                                <MudGrid Spacing="0">
                                                    <MudItem xs="3" Style="background-color: #8B5CF6;">
                                                        <div class="d-flex justify-center align-center" style="height:100%; padding: 12px;">
                                                            <MudIcon Icon="@Icons.Material.Filled.ManageAccounts" Color="Color.Inherit" />
                                                        </div>
                                                    </MudItem>
                                                    <MudItem xs="9" Class="pa-2">
                                                        <MudText Typo="Typo.caption" Class="mb-1 font-weight-bold">Phó Hiệu Trưởng</MudText>
                                                        <MudNumericField T="int" @bind-Value="@DonVi.TongPhoHieuTruong"
                                                                         Min="0"
                                                                         Variant="MudBlazor.Variant.Outlined"
                                                                         Dense="true"
                                                                         FullWidth="true" />
                                                    </MudItem>
                                                </MudGrid>
                                            </MudPaper>
                                        </MudItem>

                                        <!-- Giáo Viên -->
                                        <MudItem xs="12" sm="6" lg="3">
                                            <MudPaper Elevation="2" Class="rounded-lg border-0 overflow-hidden">
                                                <MudGrid Spacing="0">
                                                    <MudItem xs="3" Style="background-color: #EC4899;">
                                                        <div class="d-flex justify-center align-center" style="height:100%; padding: 12px;">
                                                            <MudIcon Icon="@Icons.Material.Filled.Groups" Color="Color.Inherit" />
                                                        </div>
                                                    </MudItem>
                                                    <MudItem xs="9" Class="pa-2">
                                                        <MudText Typo="Typo.caption" Class="mb-1 font-weight-bold">Giáo Viên</MudText>
                                                        <MudNumericField T="int" @bind-Value="@DonVi.TongGiaoVien"
                                                                         Min="0"
                                                                         Variant="MudBlazor.Variant.Outlined"
                                                                         Dense="true"
                                                                         FullWidth="true" />
                                                    </MudItem>
                                                </MudGrid>
                                            </MudPaper>
                                        </MudItem>

                                        <!-- Nhân Viên -->
                                        <MudItem xs="12" sm="6" lg="3">
                                            <MudPaper Elevation="2" Class="rounded-lg border-0 overflow-hidden">
                                                <MudGrid Spacing="0">
                                                    <MudItem xs="3" Style="background-color: #F43F5E;">
                                                        <div class="d-flex justify-center align-center" style="height:100%; padding: 12px;">
                                                            <MudIcon Icon="@Icons.Material.Filled.PeopleAlt" Color="Color.Inherit" />
                                                        </div>
                                                    </MudItem>
                                                    <MudItem xs="9" Class="pa-2">
                                                        <MudText Typo="Typo.caption" Class="mb-1 font-weight-bold">Nhân Viên</MudText>
                                                        <MudNumericField T="int" @bind-Value="@DonVi.TongNhanVien"
                                                                         Min="0"
                                                                         Variant="MudBlazor.Variant.Outlined"
                                                                         Dense="true"
                                                                         FullWidth="true" />
                                                    </MudItem>
                                                </MudGrid>
                                            </MudPaper>
                                        </MudItem>
                                    </MudGrid>

                                    <!-- Ghi chú: Section Thông tin chi tiết - 4 ô trên một hàng -->
                                    <MudText Typo="Typo.subtitle1" Class="mt-4 mb-3 d-flex align-center">
                                        <MudIcon Icon="@Icons.Material.Filled.Insights" Class="mr-2" Size="Size.Small" /> Thông Tin Chi Tiết
                                    </MudText>
                                    <MudGrid Spacing="2">
                                        <!-- Giáo Viên Tổ Trưởng -->
                                        <MudItem xs="12" sm="6" lg="3">
                                            <MudPaper Elevation="2" Class="rounded-lg border-0 overflow-hidden">
                                                <MudGrid Spacing="0">
                                                    <MudItem xs="3" Style="background-color: #10B981;">
                                                        <div class="d-flex justify-center align-center" style="height:100%; padding: 12px;">
                                                            <MudIcon Icon="@Icons.Material.Filled.AssignmentInd" Color="Color.Inherit" />
                                                        </div>
                                                    </MudItem>
                                                    <MudItem xs="9" Class="pa-2">
                                                        <MudText Typo="Typo.caption" Class="mb-1 font-weight-bold">GV Tổ Trưởng</MudText>
                                                        <MudNumericField T="int" @bind-Value="@DonVi.TongGiaoVien_ToTruong"
                                                                         Min="0"
                                                                         Variant="MudBlazor.Variant.Outlined"
                                                                         Dense="true"
                                                                         FullWidth="true" />
                                                    </MudItem>
                                                </MudGrid>
                                            </MudPaper>
                                        </MudItem>

                                        <!-- Giáo Viên Coi Thi -->
                                        <MudItem xs="12" sm="6" lg="3">
                                            <MudPaper Elevation="2" Class="rounded-lg border-0 overflow-hidden">
                                                <MudGrid Spacing="0">
                                                    <MudItem xs="3" Style="background-color: #06B6D4;">
                                                        <div class="d-flex justify-center align-center" style="height:100%; padding: 12px;">
                                                            <MudIcon Icon="@Icons.Material.Filled.AssignmentTurnedIn" Color="Color.Inherit" />
                                                        </div>
                                                    </MudItem>
                                                    <MudItem xs="9" Class="pa-2">
                                                        <MudText Typo="Typo.caption" Class="mb-1 font-weight-bold">GV Coi Thi</MudText>
                                                        <MudNumericField T="int" @bind-Value="@DonVi.TongGiaoVien_CoiThi"
                                                                         Min="0"
                                                                         Variant="MudBlazor.Variant.Outlined"
                                                                         Dense="true"
                                                                         FullWidth="true" />
                                                    </MudItem>
                                                </MudGrid>
                                            </MudPaper>
                                        </MudItem>

                                        <!-- Tổng Số Phòng Tối Đa -->
                                        <MudItem xs="12" sm="6" lg="3">
                                            <MudPaper Elevation="2" Class="rounded-lg border-0 overflow-hidden">
                                                <MudGrid Spacing="0">
                                                    <MudItem xs="3" Style="background-color: #F59E0B;">
                                                        <div class="d-flex justify-center align-center" style="height:100%; padding: 12px;">
                                                            <MudIcon Icon="@Icons.Material.Filled.MeetingRoom" Color="Color.Inherit" />
                                                        </div>
                                                    </MudItem>
                                                    <MudItem xs="9" Class="pa-2">
                                                        <MudText Typo="Typo.caption" Class="mb-1 font-weight-bold">Phòng Tối Đa</MudText>
                                                        <MudNumericField T="int" @bind-Value="@DonVi.TongSoPhongToiDa"
                                                                         Min="0"
                                                                         Variant="MudBlazor.Variant.Outlined"
                                                                         Dense="true"
                                                                         FullWidth="true" />
                                                    </MudItem>
                                                </MudGrid>
                                            </MudPaper>
                                        </MudItem>

                                        <!-- Tổng Số Phòng Coi Thi -->
                                        <MudItem xs="12" sm="6" lg="3">
                                            <MudPaper Elevation="2" Class="rounded-lg border-0 overflow-hidden">
                                                <MudGrid Spacing="0">
                                                    <MudItem xs="3" Style="background-color: #3B82F6;">
                                                        <div class="d-flex justify-center align-center" style="height:100%; padding: 12px;">
                                                            <MudIcon Icon="@Icons.Material.Filled.DoorFront" Color="Color.Inherit" />
                                                        </div>
                                                    </MudItem>
                                                    <MudItem xs="9" Class="pa-2">
                                                        <MudText Typo="Typo.caption" Class="mb-1 font-weight-bold">Phòng Coi Thi</MudText>
                                                        <MudNumericField T="int" @bind-Value="@DonVi.TongSoPhongCoiThi"
                                                                         Min="0"
                                                                         Variant="MudBlazor.Variant.Outlined"
                                                                         Dense="true"
                                                                         FullWidth="true" />
                                                    </MudItem>
                                                </MudGrid>
                                            </MudPaper>
                                        </MudItem>
                                    </MudGrid>
                                </MudCardContent>
                            </MudCard>
                        </MudItem>
                    </MudGrid>
                </MudContainer>

                <MudItem xs="12">
                    <MudCard Elevation="0" Class="border-none mt-6">
                        <MudCardHeader Class="py-3" Style="background: linear-gradient(90deg, #60A5FA, #93C5FD); border-radius: 8px 8px 0 0;">
                            <CardHeaderAvatar>
                                <MudAvatar Color="Color.Inherit" Style="background-color: rgba(255,255,255,0.2);">
                                    <MudIcon Icon="@Icons.Material.Filled.CoPresent" />
                                </MudAvatar>
                            </CardHeaderAvatar>
                            <CardHeaderContent>
                                <MudText Typo="Typo.h6" Style="color: white; font-weight: 500; letter-spacing: 0.5px;">
                                    Thông tin học sinh
                                </MudText>
                            </CardHeaderContent>
                            <CardHeaderActions>
                                <MudIconButton Icon="@Icons.Material.Filled.ExpandMore" Color="Color.Inherit" Style="color: white;" />
                            </CardHeaderActions>
                        </MudCardHeader>


                        <MudCardContent>
                            <MudDivider Class="mb-4" />
                            <!-- Hàng đầu tiên với 2 phần chính -->
                            <MudGrid Spacing="3">
                                <!-- Cột 1: Tổng Học Sinh Lớp 12 -->
                                <MudItem xs="12" md="6">
                                    <MudCard Elevation="2" Class="rounded-lg overflow-hidden">
                                        <MudCardHeader Class="py-2" Style="background: linear-gradient(90deg, #3B82F6, #60A5FA); border-radius: 4px;">
                                            <CardHeaderAvatar>
                                                <MudIcon Icon="@Icons.Material.Filled.School" Color="Color.Inherit" />
                                            </CardHeaderAvatar>
                                            <CardHeaderContent>
                                                <MudText Typo="Typo.subtitle1" Style="color: white; font-weight: 500;">Tổng Học Sinh Lớp 12</MudText>
                                            </CardHeaderContent>
                                        </MudCardHeader>
                                        <MudCardContent Class="pt-3">
                                            <MudGrid Justify="Justify.Center" Class="gap-4">
