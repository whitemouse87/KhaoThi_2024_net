                                <MudTable Items="@lanhDaoList" Hover="true" Striped="true" Bordered="true" Dense="true" Context="personItem">
                                    <ColGroup>
                                        <col style="width: 30%;" />
                                        <col style="width: 15%;" />
                                        <col style="width: 20%;" />
                                        <col style="width: 20%;" />
                                        <col style="width: 15%;" />
                                    </ColGroup>
                                    <HeaderContent>
                                        <MudTh>Họ và tên</MudTh>
                                        <MudTh>Năm sinh</MudTh>
                                        <MudTh>Chức vụ</MudTh>
                                        <MudTh>Điện thoại</MudTh>
                                        <MudTh>Email</MudTh>
                                        <MudTh>Tham gia coi thi TS10</MudTh>
                                        <MudTh>Tham gia coi thi THPT</MudTh>
                                    </HeaderContent>
                                    <RowTemplate>
                                        <MudTd DataLabel="Họ và tên">@personItem.HoTen</MudTd>
                                        <MudTd DataLabel="Năm sinh">@personItem.NamSinh</MudTd>
                                        <MudTd DataLabel="Chức vụ">@personItem.ChucVuDonVi</MudTd>
                                        <MudTd DataLabel="Điện thoại">@personItem.SDTDiDong</MudTd>
                                        <MudTd DataLabel="Email">@personItem.Email</MudTd>
                                        <MudTd DataLabel="Tham gia coi thi TS10">
                                            @if (personItem.CoiThiTS10)
                                            {
                                                <MudChip Color="Color.Success" Size="Size.Small" T="string">Có</MudChip>
                                            }
                                            else
                                            {
                                                <MudChip Color="Color.Error" Size="Size.Small" T="string">Không</MudChip>
                                            }
                                        </MudTd>
                                        <MudTd DataLabel="Tham gia coi thi THPT">
                                            @if (personItem.CoiThiTHPT)
                                            {
                                                <MudChip Color="Color.Success" Size="Size.Small" T="string">Có</MudChip>
                                            }
                                            else
                                            {
                                                <MudChip Color="Color.Error" Size="Size.Small" T="string">Không</MudChip>
                                            }
                                        </MudTd>
                                    </RowTemplate>
                                </MudTable>
                            </MudCardContent>
                        </MudCard>
                    }
                }
            }
        </Authorized>
        <NotAuthorized>
            <LoginRedirect></LoginRedirect>
        </NotAuthorized>
    </AuthorizeView>
</MudContainer>

@code {
    // Các biến cho thông tin của admin
    private int totalUserCount = 0;
    private int completedReports = 0;
    private int totalReports = 0;
    private string lastActivityTime = "Hôm nay, 08:30";
    private int totalSchools = 0;
    private int totalStudents = 0;
    private int totalTeachers = 0;
    private int totalRooms = 0;

    // Các biến cho thông tin đơn vị
    private KhaoThi_1_THPT_ThongTin_DonViModel? donViInfo;
    private IEnumerable<KhaoThi_4_THPT_ThongTin_LanhDaoModel>? lanhDaoList;
    private int lanhDaoCount = 0;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (!authState.User.Identity?.IsAuthenticated ?? true)
        {
            await LoggingService.LogErrorAsync("Unauthorized access attempt to dashboard", null, nameof(Dashboard));
            NavigationManager.NavigateTo("/login", true);
            return;
        }

        var user = authState.User;
        var maChucVu = user.FindFirst("maChucVu")?.Value;
        var maDonVi = user.FindFirst("maDonVi")?.Value;

        if (maChucVu == "01") // Admin
        {
            // Thiết lập dữ liệu mẫu cho admin
            totalUserCount = 120;
            completedReports = 45;
            totalReports = 60;
            totalSchools = 60;
            totalStudents = 25350;
            totalTeachers = 2180;
            totalRooms = 420;
        }
        else if (!string.IsNullOrEmpty(maDonVi)) // User đơn vị
        {
            try
            {
                // Lấy thông tin đơn vị
                donViInfo = await ThongTinDonViService.GetByMaTruongAsync(maDonVi);

                // Lấy danh sách lãnh đạo
                if (donViInfo != null)
                {
                    lanhDaoList = await LanhDaoDonViService.GetByMaTruongAsync(maDonVi);
                    lanhDaoCount = lanhDaoList?.Count() ?? 0;
                }
            }
            catch (Exception ex)
            {
                await LoggingService.LogErrorAsync("Error loading dashboard data", ex, nameof(Dashboard));
            }
        }
    }

    private async Task RefreshData()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        var maChucVu = user.FindFirst("maChucVu")?.Value;
        var maDonVi = user.FindFirst("maDonVi")?.Value;

        if (maChucVu != "01" && !string.IsNullOrEmpty(maDonVi))
        {
            try
            {
                // Lấy thông tin đơn vị
                donViInfo = await ThongTinDonViService.GetByMaTruongAsync(maDonVi);

                // Lấy danh sách lãnh đạo
                if (donViInfo != null)
                {
                    lanhDaoList = await LanhDaoDonViService.GetByMaTruongAsync(maDonVi);
                    lanhDaoCount = lanhDaoList?.Count() ?? 0;
                }
            }
            catch (Exception ex)
            {
                await LoggingService.LogErrorAsync("Error refreshing dashboard data", ex, nameof(Dashboard));
            }
        }
    }

    private string GetChucVuDisplay(string? maChucVu)
    {
        return maChucVu switch
        {
            "01" => "Quản trị viên - SGDĐT",
            "02" => "Quản trị viên - Đơn vị",
            _ => maChucVu ?? "Không xác định"
        };
    }
}