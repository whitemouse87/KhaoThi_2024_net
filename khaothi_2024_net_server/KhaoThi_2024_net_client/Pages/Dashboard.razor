@page "/dashboard"
@attribute [Authorize]

@using KhaoThi_2024_net_client.Components.Auth
@using MudBlazor
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@inject ILoggingService LoggingService

<PageTitle>Dashboard - KhaoThi</PageTitle>

@* MudLayout cung cấp bố cục tổng thể cho trang *@
<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
    <AuthorizeView>
        <Authorized>
            <MudPaper Elevation="0" Style="background: linear-gradient(135deg, #594ae2 0%, #5042cb 100%);">
                <div class="d-flex align-center py-4 px-6">
                    <div class="mr-4">
                        <MudAvatar Style="background-color: rgba(255,255,255,0.2); width: 52px; height: 52px;">
                            <MudIcon Icon="@Icons.Material.Filled.ManageAccounts"
                                     Color="Color.Surface"
                                     Style="font-size: 32px; color: white;" />
                        </MudAvatar>
                    </div>
                    <div>
                        <MudText Typo="Typo.h5"
                                 Style="color: white; font-weight: 600; letter-spacing: 0.5px;">
                            Trang quản trị
                        </MudText>
                        <MudText Typo="Typo.body2"
                                 Style="color: rgba(255,255,255,0.85); margin-top: 4px;">
                            Công cụ quản trị
                        </MudText>
                    </div>
                    <MudSpacer />
                    
                  
                </div>
            </MudPaper>
            @* Tiêu đề trang với icon *@
           

            @* Thẻ thông tin người dùng với đường viền, bóng đổ và màu sắc *@
            <MudCard Elevation="3" Class="mb-6" Style="border-left: 4px solid var(--mud-palette-primary);">
                <MudCardHeader>
                    <CardHeaderAvatar>
                        <MudAvatar Color="Color.Primary">
                            <MudIcon Icon="@Icons.Material.Filled.Person" />
                        </MudAvatar>
                    </CardHeaderAvatar>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h5" Style="font-weight:600">Thông tin người dùng</MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    <MudGrid>
                        <MudItem xs="12" md="4">
                            <MudField Label="Họ tên" Variant="Variant.Outlined" FullWidth="true">
                                @context.User.FindFirst("hoTen")?.Value
                            </MudField>
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <MudField Label="Đơn vị" Variant="Variant.Outlined" FullWidth="true">
                                @context.User.FindFirst("maDonVi")?.Value - @context.User.FindFirst("tenDonVi")?.Value
                            </MudField>
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <MudField Label="Chức vụ" Variant="Variant.Outlined" FullWidth="true">
                                @GetChucVuDisplay(context.User.FindFirst("maChucVu")?.Value)
                            </MudField>
                        </MudItem>
                    </MudGrid>
                </MudCardContent>
            </MudCard>

            @{
                var maChucVu = context.User.FindFirst("maChucVu")?.Value;
            }

            @* Hiển thị các thẻ chức năng cho Admin *@
            @if (maChucVu == "01") // Admin
            {
                <MudGrid>
                    <MudItem xs="12" md="4">
                        <MudCard Elevation="2" Class="mud-theme-primary h-100">
                            <MudCardHeader>
                                <CardHeaderAvatar>
                                    <MudAvatar Color="Color.Primary">
                                        <MudIcon Icon="@Icons.Material.Filled.People" />
                                    </MudAvatar>
                                </CardHeaderAvatar>
                                <CardHeaderContent>
                                    <MudText Typo="Typo.h6"
                                             Style="color: white; font-weight: 500; letter-spacing: 0.5px;">
                                        QUẢN LÝ NGƯỜI DÙNG
                                    </MudText>
                                    @*<MudText Typo="Typo.h6">Quản lý người dùng</MudText>*@
                                </CardHeaderContent>
                            </MudCardHeader>
                            <MudCardContent>
                                <MudText>Quản lý tài khoản và phân quyền người dùng</MudText>
                            </MudCardContent>
                            <MudCardActions>
                                <MudButton Variant="Variant.Filled"
                                           Color="Color.Primary"
                                           StartIcon="@Icons.Material.Filled.Login"
                                           Href="/users">
                                    Truy cập
                                </MudButton>
                            </MudCardActions>
                        </MudCard>
                    </MudItem>

                    <MudItem xs="12" md="4">
                        <MudCard Elevation="2" Class="mud-theme-secondary h-100">
                            <MudCardHeader>
                                <CardHeaderAvatar>
                                    <MudAvatar Color="Color.Secondary">
                                        <MudIcon Icon="@Icons.Material.Filled.Settings" />
                                    </MudAvatar>
                                </CardHeaderAvatar>
                                <CardHeaderContent>
                                    <MudText Typo="Typo.h6"
                                             Style="color: white; font-weight: 500; letter-spacing: 0.5px;">
                                        QUẢN LÝ BÁO CÁO
                                    </MudText>                                  
                                </CardHeaderContent>
                            </MudCardHeader>
                            <MudCardContent>
                                <MudText>Quản lý và kiểm tra dữ liệu báo cáo</MudText>
                            </MudCardContent>
                            <MudCardActions>
                                <MudButton Variant="Variant.Filled"
                                           Color="Color.Secondary"
                                           StartIcon="@Icons.Material.Filled.Login"
                                           Link="/admin/settings">
                                    Truy cập
                                </MudButton>
                            </MudCardActions>
                        </MudCard>
                    </MudItem>

                    <MudItem xs="12" md="4">
                        <MudCard Elevation="2" Class="mud-theme-tertiary h-100">
                            <MudCardHeader>
                                <CardHeaderAvatar>
                                    <MudAvatar Color="Color.Tertiary">
                                        <MudIcon Icon="@Icons.Material.Filled.History" />
                                    </MudAvatar>
                                </CardHeaderAvatar>
                                <CardHeaderContent>
                                    <MudText Typo="Typo.h6"
                                             Style="color: white; font-weight: 500; letter-spacing: 0.5px;">
                                        NHẬT KÝ HỆ THỐNG
                                    </MudText>
                                    @*<MudText Typo="Typo.h6">Nhật ký hệ thống</MudText>*@
                                </CardHeaderContent>
                            </MudCardHeader>
                            <MudCardContent>
                                <MudText>Xem lịch sử hoạt động</MudText>
                            </MudCardContent>
                            <MudCardActions>
                                <MudButton Variant="Variant.Filled"
                                           Color="Color.Tertiary"
                                           StartIcon="@Icons.Material.Filled.Login"
                                           Link="/admin/logs">
                                    Truy cập
                                </MudButton>
                            </MudCardActions>
                        </MudCard>
                    </MudItem>
                </MudGrid>
            }
            else // User thường
            {
                <MudGrid>
                    <MudItem xs="12" md="6">
                        <MudCard Elevation="2" Class="mud-theme-primary h-100">
                            <MudCardHeader>
                                <CardHeaderAvatar>
                                    <MudAvatar Color="Color.Primary">
                                        <MudIcon Icon="@Icons.Material.Filled.Assignment" />
                                    </MudAvatar>
                                </CardHeaderAvatar>
                                <CardHeaderContent>
                                    <MudText Typo="Typo.h6"
                                             Style="color: white; font-weight: 500; letter-spacing: 0.5px;">
                                        BÁO CÁO SỐ LIỆU PHỤC VỤ CÔNG TÁC TỔ CHỨC THI
                                    </MudText>
                                </CardHeaderContent>
                            </MudCardHeader>
                            <MudCardContent>
                                <MudText>Báo cáo số liệu, cơ sở vật chất, nhân sự, và các nội dung liên quan công tác tổ chức thi</MudText>
                            </MudCardContent>
                            <MudCardActions>
                                <MudButton Variant="Variant.Filled"
                                           Color="Color.Primary"
                                           StartIcon="@Icons.Material.Filled.Login"
                                           Link="/tasks">
                                    Xem công việc
                                </MudButton>
                            </MudCardActions>
                        </MudCard>
                    </MudItem>

                    <MudItem xs="12" md="6">
                        <MudCard Elevation="2" Class="mud-theme-secondary h-100">
                            <MudCardHeader>
                                <CardHeaderAvatar>
                                    <MudAvatar Color="Color.Secondary">
                                        <MudIcon Icon="@Icons.Material.Filled.Assessment" />
                                    </MudAvatar>
                                </CardHeaderAvatar>
                                <CardHeaderContent>
                                    <MudText Typo="Typo.h6"
                                             Style="color: white; font-weight: 500; letter-spacing: 0.5px;">
                                        IN BÁO CÁO
                                    </MudText>
                                </CardHeaderContent>
                            </MudCardHeader>
                            <MudCardContent>
                                <MudText>Kiểm tra và in báo cáo chuẩn bị công tác thi</MudText>
                            </MudCardContent>
                            <MudCardActions>
                                <MudButton Variant="Variant.Filled"
                                           Color="Color.Secondary"
                                           StartIcon="@Icons.Material.Filled.Login"
                                           Link="/reports">
                                     In báo cáo
                                </MudButton>
                            </MudCardActions>
                        </MudCard>
                    </MudItem>
                </MudGrid>
            }
        </Authorized>
        <NotAuthorized>
            <LoginRedirect></LoginRedirect>
        </NotAuthorized>
    </AuthorizeView>
</MudContainer>

@code {
    //// Hàm này cần được giữ lại từ mã gốc
    //private string GetChucVuDisplay(string maChucVu)
    //{
    //    return maChucVu switch
    //    {
    //        "01" => "Quản trị viên",
    //        "02" => "Giáo viên",
    //        "03" => "Nhân viên",
    //        _ => "Không xác định"
    //    };
    //}

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (!authState.User.Identity?.IsAuthenticated ?? true)
        {
            await Logger.Warning("Unauthorized access attempt to dashboard");
            NavigationManager.NavigateTo("/login", true);
            return;
        }

        var user = authState.User;
        var maChucVu = user.FindFirst("maChucVu")?.Value;
        await Logger.Info($"Dashboard accessed - User: {user.FindFirst("tenDangNhap")?.Value}, Role: {maChucVu}");
    }

    private string GetChucVuDisplay(string? maChucVu)
    {
        return maChucVu switch
        {
            "01" => "Quản trị viên - SGDĐT",
            "02" => "Quản trị viên - Đơn vị",
            _ => maChucVu ?? "Không xác định"
        };
    }
}