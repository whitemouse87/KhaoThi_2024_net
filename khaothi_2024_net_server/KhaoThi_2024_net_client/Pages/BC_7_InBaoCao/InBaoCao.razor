                        <MudTh>Môn Luận Chọn 1</MudTh>
                        <MudTh>Môn Luận Chọn 2</MudTh>
                        <MudTh>Số Lượng</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="ID">@context.ID</MudTd>
