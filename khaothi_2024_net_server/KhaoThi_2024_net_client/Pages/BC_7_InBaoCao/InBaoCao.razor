@page "/inbaocao"
@page "/inbaocao/{MaTruong}"
@inject KhaoThi_2024_net_client.Services.BC_1_ThongTinDonVi.IBCThongTinDonViService ThongTinDonViService
@inject KhaoThi_2024_net_client.Services.BC_2_NhomMonDonVi.IBCNhomMonDonViService NhomMonDonViService
@inject khaothi_2024_net_client.Services.BC_5_ThongTinConThi.IBCThongTinConThiService nhomConThiDonViService
@inject KhaoThi_2024_net_client.Services.BC_4_LanhDaoDonVi.IBCLanhDaoDonViService nhomLanhDaoDonViService
@inject KhaoThi_2024_net_client.Services.BC_5_TruongDiemDonVi.IBCThongTinTruongDiemDonViService nhomTruongDiemDonViService
@using KhaoThi_2024_net_client.Models.BaoCaoSoLieu
@inject KhaoThi_2024_net_client.Components.IReportService WordReportService
@inject KhaoThi_2024_net_client.Services.IPdfService PdfService
@inject HttpClient Http
@inject IJSRuntime JSRuntime
@inject ILoggingService Logger
@inject NavigationManager NavigationManager
@using Microsoft.AspNetCore.WebUtilities
@using KhaoThi_2024_net_client.Models.BaoCaoSoLieu

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
    <MudPaper Elevation="3" Class="pa-4 mb-6">
        <MudText Typo="Typo.h5" Class="mb-4 d-flex align-center">
            <MudIcon Icon="@Icons.Material.Filled.Description" Class="mr-2" />
            Xuất báo cáo trường: @MaTruong
        </MudText>

        <MudGrid>
            <MudItem xs="12" md="6">
                <MudTextField Label="Mã trường"
                              Value="@MaTruong"
                              ReadOnly="true"
                              Variant="Variant.Outlined"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.School"
                              Margin="Margin.Dense"
                              FullWidth="true" />
            </MudItem>

            <MudItem xs="12" md="6">
                @if (thongTinTruong != null)
                {
                    <MudTextField Label="Tên trường"
                                  Value="@thongTinTruong.TenTruong"
                                  ReadOnly="true"
                                  Variant="Variant.Outlined"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Business"
                                  Margin="Margin.Dense"
                                  FullWidth="true" />
                }
                else
                {
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="40px" Class="my-2" />
                }
            </MudItem>
        </MudGrid>

        @*@if (nhomMons != null && nhomMons.Any())
        {
            <MudPaper Elevation="0" Class="mt-4">
                <MudText Typo="Typo.h6" Class="mb-2">Danh sách nhóm môn</MudText>
                <MudTable Items="@nhomMons" Hover="true" Striped="true" Bordered="true" Dense="true">
