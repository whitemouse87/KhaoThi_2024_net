        <div class="d-flex justify-start mt-4">
            @*<MudButton Variant="Variant.Filled"
                           Color="MudBlazor.Color.Primary"
                           StartIcon="@Icons.Material.Filled.FileDownload"
                           Size="Size.Large"
                           OnClick="GenerateReport"
                           Disabled="@(isGenerating || thongTinTruong == null)">
                    @if (isGenerating)
                    {
                        <MudProgressCircular Class="mr-2" Size="Size.Small" Indeterminate="true" />
                        <span>Đang tạo báo cáo...</span>
                    }
                    else
                    {
                        <span>Xuất báo cáo Word</span>
                    }
                </MudButton>*@

            <MudButton Variant="Variant.Filled"
                       Color="MudBlazor.Color.Secondary"
                       StartIcon="@Icons.Material.Filled.PictureAsPdf"
                       Size="Size.Large"
                       OnClick="GeneratePdfReport"
                       Disabled="@(isGenerating || thongTinTruong == null)"
                       Class="ml-2">
                @if (isGenerating)
                {
                    <MudProgressCircular Class="mr-2" Size="Size.Small" Indeterminate="true" />
                    <span>Đang tạo PDF...</span>
                }
                else
                {
                    <span>Xuất báo cáo PDF</span>
                }
            </MudButton>
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <MudAlert Severity="Severity.Error" Class="mt-4" Variant="Variant.Filled">
                <div class="d-flex align-center">
                    <MudIcon Icon="@Icons.Material.Filled.Error" Class="mr-3" />
                    @errorMessage
                </div>
            </MudAlert>
        }

        @if (isDataLoaded)
        {
            <MudAlert Severity="Severity.Success" Class="mt-4" Variant="Variant.Filled">
                <div class="d-flex align-center">
                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Class="mr-3" />
