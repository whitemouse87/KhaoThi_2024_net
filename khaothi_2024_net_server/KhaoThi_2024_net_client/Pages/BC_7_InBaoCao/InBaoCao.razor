                        <MudTd DataLabel="Môn Luận Chọn 1">@context.MonLuaChon_1</MudTd>
                        <MudTd DataLabel="Môn Luận Chọn 2">@context.MonLuaChon_2</MudTd>
                        <MudTd DataLabel="Số Lượng">@context.SoLuong</MudTd>
                    </RowTemplate>
                </MudTable>
