</MudContainer>

@code {
    [Parameter]
    public string MaTruong { get; set; }

    private bool isGenerating = false;
    private bool isDataLoaded = false;
    private string errorMessage = string.Empty;

    // Lưu trữ dữ liệu đã tải
    private KhaoThi_1_THPT_ThongTin_DonViModel thongTinTruong;
    private IEnumerable<KhaoThi_2_THPT_NhomMon_DonViModel> nhomMons;
    private IEnumerable<KhaoThi_5_THPT_ThongTin_ConThiModel> nhomConThis;
    private IEnumerable<KhaoThi_4_THPT_ThongTin_LanhDaoModel> nhomThongTinLanhDaos;
    private IEnumerable<KhaoThi_4_THPT_ThongTin_LanhDaoModel> nhomTruongDiems;

    protected override async Task OnInitializedAsync()
    {
        // Đảm bảo JavaScript cho download đã được đăng ký
        await JSRuntime.InvokeVoidAsync("eval", @"
window.downloadFileFromStream = (fileName, contentType, base64Data) => {
const linkSource = `data:${contentType};base64,${base64Data}`;
const downloadLink = document.createElement('a');
downloadLink.href = linkSource;
downloadLink.download = fileName;
downloadLink.click();
downloadLink.remove();
}");

        // Nếu có MaTruong, tải dữ liệu ngay khi component khởi tạo
        if (!string.IsNullOrEmpty(MaTruong))
        {
            await LoadData();
        }
        else
        {
            // Cố gắng lấy từ query string nếu không có trong route
            ExtractMaDonViFromQueryString();
            if (!string.IsNullOrEmpty(MaTruong))
            {
                await LoadData();
            }
        }
    }

    private void ExtractMaDonViFromQueryString()
    {
        var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
        if (QueryHelpers.ParseQuery(uri.Query).TryGetValue("MaDonVi", out var maDonViParam))
        {
            MaTruong = maDonViParam.FirstOrDefault() ?? string.Empty;
        }
    }

    private async Task LoadData()
    {
        try
        {
            isDataLoaded = false;
            errorMessage = string.Empty;
            StateHasChanged();

            // Tải thông tin trường
            thongTinTruong = await ThongTinDonViService.GetByMaTruongAsync(MaTruong);

            // Tải dữ liệu nhóm môn
            nhomMons = await NhomMonDonViService.GetByMaTruongAsync(MaTruong);
            nhomConThis = await nhomConThiDonViService.GetByMaTruongAsync(MaTruong);
            nhomThongTinLanhDaos = await nhomLanhDaoDonViService.GetByMaTruongAsync(MaTruong);
            nhomTruongDiems = await nhomTruongDiemDonViService.GetByMaTruongAsync(MaTruong);

            // Kiểm tra dữ liệu trường cơ bản
            if (thongTinTruong == null)
            {
                errorMessage = $"Không tìm thấy thông tin trường với mã: {MaTruong}";
                isDataLoaded = false;
            }
            else
            {
                isDataLoaded = true;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Lỗi khi tải dữ liệu: {ex.Message}";
            await Logger.LogErrorAsync("Lỗi khi tải dữ liệu cho báo cáo", ex, "InBaoCaoComponent");
            isDataLoaded = false;
        }
        finally
        {
            StateHasChanged();
        }
    }



    private async Task GeneratePdfReport()
    {
        try
        {
            isGenerating = true;
            errorMessage = string.Empty;
            StateHasChanged();

            // Nếu chưa tải dữ liệu, tải lại
            if (!isDataLoaded)
            {
                await LoadData();
                if (!isDataLoaded) // Nếu vẫn không tải được dữ liệu
                {
                    errorMessage = "Không thể tải dữ liệu để tạo báo cáo";
                    return;
                }
            }

            // Sử dụng service để tạo báo cáo PDF
            //byte[] reportData = await PdfService.GeneratePdfReportAsync(thongTinTruong,nhomMons,nhomConThis,nhomThongTinLanhDaos);
            byte[] reportData = await PdfService.GeneratePdfReportAsync(thongTinTruong, nhomMons, nhomConThis, nhomThongTinLanhDaos, nhomTruongDiems);
            // Tải xuống file với tên có timestamp
            string fileName = $"BaoCao_{thongTinTruong?.MaTruong ?? "Unknown"}_{DateTime.Now:yyyyMMdd_HHmmss}.pdf";
            await DownloadFile(reportData, fileName, "application/pdf");
        }
        catch (Exception ex)
        {
            errorMessage = $"Lỗi khi tạo báo cáo PDF: {ex.Message}";
            await Logger.LogErrorAsync("Lỗi khi tạo báo cáo PDF", ex, "InBaoCaoComponent");
        }
        finally
        {
            isGenerating = false;
            StateHasChanged();
        }
    }

    private async Task DownloadFile(byte[] data, string fileName, string contentType)
    {
        // Sử dụng JS để tải file về client
        await JSRuntime.InvokeVoidAsync("downloadFileFromStream", fileName, contentType, Convert.ToBase64String(data));
    }
}