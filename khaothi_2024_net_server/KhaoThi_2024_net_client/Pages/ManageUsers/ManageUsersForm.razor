    /// <summary>
    /// Hiển thị dialog chỉnh sửa người dùng
    /// </summary>
    private async Task OpenEditDialog(KhaoThiUserModel user)
    {
        try
        {
            // Cập nhật người dùng được chọn vào state
            Dispatcher.Dispatch(new SelectUserAction(user));

            // Thiết lập tham số cho modal
            var parameters = new ModalParameters()
                .Add(nameof(KhaoThi_2024_net_client.Pages.Profile.EditUserForm.User), user);

            // Cấu hình tùy chọn cho modal
            var options = new ModalOptions
            {
                DisableBackgroundCancel = true,
                HideCloseButton = false,
                Position = ModalPosition.Middle,
                Size = ModalSize.Large,
                Class = "edit-user-modal",
                AnimationType = ModalAnimationType.FadeInOut
            };

            var result = await ModalService.Show<KhaoThi_2024_net_client.Pages.Profile.EditUserForm>("Cập nhật thông tin người dùng", parameters, options).Result;

            if (!result.Cancelled)
            {
                // Nếu cập nhật thành công, tải lại danh sách
                LoadUsers();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Có lỗi xảy ra: {ex.Message}", Severity.Error);
        }
    }

