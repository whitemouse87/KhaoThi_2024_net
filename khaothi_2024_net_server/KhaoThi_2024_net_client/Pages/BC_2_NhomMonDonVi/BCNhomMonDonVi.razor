@page "/bcnhommon"
@page "/bcnhommon/{MaTruong}"
@using KhaoThi_2024_net_client.Models.BaoCaoSoLieu
@using KhaoThi_2024_net_client.Services.BC_2_NhomMonDonVi
@using Fluxor
@using MudBlazor
@using KhaoThi_2024_net_client.Models.Shares
@using System.Text.RegularExpressions
@using Microsoft.AspNetCore.WebUtilities
@using BCNhomMonAction = KhaoThi_2024_net_client.Services.BC_2_NhomMonDonVi.BCNhomMonDonViActions

@inherits Fluxor.Blazor.Web.Components.FluxorComponent
@inject IState<BCNhomMonDonViState> NhomMonState
@inject IDispatcher Dispatcher
@inject IBCNhomMonDonViService NhomMonService
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager
@inject IDialogService DialogService

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
    <div class="d-flex">
        <MudPaper Elevation="3" Class="rounded-lg overflow-hidden mb-4 mr-4" Style="width: 30%;">
            <!-- Improved Header with Gradient -->
            <MudCardHeader Class="py-3" Style="background: linear-gradient(90deg, #059669, #10B981); border-radius: 8px 8px 0 0;">
                <CardHeaderContent>
                    <div class="d-flex align-center">
                        <MudAvatar Color="Color.Primary" Size="Size.Medium" Class="mr-3" Style="background-color: rgba(255,255,255,0.2);">

                            <MudAvatar Color="Color.Inherit" Style="background-color: rgba(255,255,255,0.2);">
                                <MudIcon Icon="@Icons.Material.Filled.School" />
                            </MudAvatar>
                        </MudAvatar>
                        <div>
                            <MudText Typo="Typo.h5" Style="color: white; font-weight: 500; letter-spacing: 0.5px;" Class="font-weight-bold">Thông tin đơn vị</MudText>
                            @*<MudText Typo="Typo.body2" Style="color: white; font-weight: 500; letter-spacing: 0.5px;" Class="opacity-80"></MudText>*@
                        </div>
                    </div>
                </CardHeaderContent>
            </MudCardHeader>

            <!-- School Info and Status Section -->
            <div class="d-flex flex-wrap align-center justify-space-between pa-4" Style="background-color: #ffffff;">
                <div class="d-flex align-center">

                    <div class="d-flex align-center mx-4">
                        @*<MudText Typo="Typo.caption" Class="font-weight-bold" Style="color: rgba(0,0,0,0.6);">Mã trường</MudText>*@
                        <MudText Typo="Typo.body2" Class="mr-2">Mã trường:</MudText>
                        <MudText Typo="Typo.h4" Class="font-weight-bold">@maTruong</MudText>
                    </div>
                </div>
                <div class="d-flex align-center mx-4">
                    <MudText Typo="Typo.body2" Class="mr-2">Trạng thái:</MudText>
                    @if (!NhomMonState.Value.IsLoading)
                    {
                        <div class="d-flex align-center" style="color: #2e7d32; background-color: #e8f5e9; border-radius: 16px; padding: 4px 8px;">
                            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" Class="mr-1" />
                            <span style="font-size: 12px;">Đã tải xong</span>
                        </div>
                    }
                    else
                    {
                        <div class="d-flex align-center" style="color: #ed6c02; background-color: #fff4e5; border-radius: 16px; padding: 4px 8px;">
                            <MudIcon Icon="@Icons.Material.Filled.Pending" Size="Size.Small" Class="mr-1" />
                            <span style="font-size: 12px;">Đang tải dữ liệu</span>
                        </div>
                    }
                </div>
                @*<MudButton Color="Color.Primary"
                       Variant="Variant.Filled"
                       OnClick="LoadNhomMonsByMaTruong"
                       DisableElevation="true"
                       Style="background-color: #5e35b1; border-radius: 20px;"
                       StartIcon="@Icons.Material.Filled.Refresh"
                       Size="Size.Medium"
                       Class="px-3">
                TẢI LẠI DỮ LIỆU
            </MudButton>*@
            </div>
        </MudPaper>

        <!-- Form nhập liệu - các đối tượng cùng 1 hàng -->
        <MudPaper Elevation="0" Class="mb-5 rounded-md" Style="border: 1px solid #e0e0e0; width: 70%;">
            <MudCardHeader Class="py-3" Style="background: linear-gradient(90deg, #2563EB, #3B82F6); border-radius: 8px 8px 0 0;">
                <CardHeaderContent>
                    <div class="d-flex align-center">
                        <MudAvatar Color="Color.Error" Size="Size.Medium" Class="mr-3" Style="background-color: rgba(255,255,255,0.2);">
                            <MudAvatar Color="Color.Inherit" Style="background-color: rgba(255,255,255,0.2);">
                                <MudIcon Icon="@Icons.Material.Filled.Create" />
                            </MudAvatar>
                        </MudAvatar>
                        <div>
                            <MudText Typo="Typo.h5" Style="color: white; font-weight: 500; letter-spacing: 0.5px;" Class="font-weight-bold">Tạo nhóm môn học của học sinh dự thi lớp 12</MudText>
                            <MudText Typo="Typo.body2" Style="color: yellow; font-weight: 500; letter-spacing: 0.5px;" Class="opacity-80">Đề nghị các đơn vị rà soát thật chính xác thông tin nhóm môn học để phục vụ công tác quy hoạch các điểm thi</MudText>
                        </div>
                    </div>
                </CardHeaderContent>
            </MudCardHeader>
            <MudForm @ref="form" Model="@newNhomMon" @onsubmit="CreateNhomMon">
                <div class="pa-3">
                    <MudGrid Spacing="3">
                        <MudItem xs="12" sm="6" lg="3">
                            <MudPaper Elevation="2" Class="rounded-lg border-0 overflow-hidden">
                                <MudGrid Spacing="0">
                                    <MudItem xs="3" Style="background-color: #EC4899;">
                                        <div class="d-flex justify-center align-center" style="height:100%; padding: 12px;">
                                            <MudIcon Icon="@Icons.Material.Filled.TextFields"  Style="color: white;" Size="Size.Large" />
                                        </div>
                                    </MudItem>
                                    <MudItem xs="9" Class="pa-2">
                                        <MudText Typo="Typo.subtitle1" Class="mb-1 font-weight-bold">Tên nhóm môn (theo số thứ tự)*</MudText>
                                        <MudNumericField @bind-Value="newNhomMon.TenNhom"
                                                         T="int"
                                                         Min="1"
                                                         Max="10"
                                                         Variant="MudBlazor.Variant.Outlined"
                                                         Dense="true"
                                                         FullWidth="true" />
                                        @if (!string.IsNullOrEmpty(nhomMonError))
                                        {
                                            <MudText Color="Color.Error">@nhomMonError</MudText>
                                        }
                                    </MudItem>
                                </MudGrid>
                            </MudPaper>
                        </MudItem>

                        <MudItem xs="12" sm="6" lg="3">
                            <MudPaper Elevation="2" Class="rounded-lg border-0 overflow-hidden">
                                <MudGrid Spacing="0">
                                    <MudItem xs="3" Style="background-color: #3B82F6;">
                                        <div class="d-flex justify-center align-center" style="height:100%; padding: 12px;">
                                            <MudIcon Icon="@Icons.Material.Filled.MenuBook"  Style="color: white;" Size="Size.Large" />
                                        </div>
                                    </MudItem>
                                    <MudItem xs="9" Class="pa-2">
                                        <MudText Typo="Typo.subtitle1" Class="mb-1 font-weight-bold">Môn lựa chọn 1*</MudText>
                                        <MudSelect @bind-Value="newNhomMon.MonLuaChon_1"
                                                   Required="true"
                                                   Variant="MudBlazor.Variant.Outlined"
                                                   Dense="true"
                                                   FullWidth="true">
                                            <MudSelectItem Value="@("Tiếng Anh")">Tiếng Anh</MudSelectItem>
                                            <MudSelectItem Value="@("Tiếng Pháp")">Tiếng Pháp</MudSelectItem>
                                            <MudSelectItem Value="@("Tiếng Trung")">Tiếng Trung</MudSelectItem>
                                            <MudSelectItem Value="@("Tiếng Nhật")">Tiếng Nhật</MudSelectItem>
                                            <MudSelectItem Value="@("Tiếng Đức")">Tiếng Đức</MudSelectItem>
                                            <MudSelectItem Value="@("Tiếng Hàn")">Tiếng Hàn</MudSelectItem>
                                            <MudSelectItem Value="@("Lịch sử")">Lịch sử</MudSelectItem>
                                            <MudSelectItem Value="@("Vật lý")">Vật lý</MudSelectItem>
                                            <MudSelectItem Value="@("Hóa học")">Hóa học</MudSelectItem>
                                            <MudSelectItem Value="@("Sinh học")">Sinh học</MudSelectItem>
                                            <MudSelectItem Value="@("Địa lý")">Địa lý</MudSelectItem>
                                            <MudSelectItem Value="@("Giáo dục kinh tế và pháp luật")">Giáo dục kinh tế và pháp luật</MudSelectItem>
                                            <MudSelectItem Value="@("Tin học")">Tin học</MudSelectItem>
                                            <MudSelectItem Value="@("Công nghệ")">Công nghệ</MudSelectItem>
                                        </MudSelect>
                                    </MudItem>
                                </MudGrid>
                            </MudPaper>
                        </MudItem>

                        <MudItem xs="12" sm="6" lg="3">
                            <MudPaper Elevation="2" Class="rounded-lg border-0 overflow-hidden">
                                <MudGrid Spacing="0">
                                    <MudItem xs="3" Style="background-color: #10B981;">
                                        <div class="d-flex justify-center align-center" style="height:100%; padding: 12px;">
                                            <MudIcon Icon="@Icons.Material.Filled.MenuBook"  Style="color: white;" Size="Size.Large" />
                                        </div>
                                    </MudItem>
                                    <MudItem xs="9" Class="pa-2">
                                        <MudText Typo="Typo.subtitle1" Class="mb-1 font-weight-bold">Môn lựa chọn 2*</MudText>
                                        <MudSelect @bind-Value="newNhomMon.MonLuaChon_2"
                                                   Required="true"
                                                   Variant="MudBlazor.Variant.Outlined"
                                                   Dense="true"
                                                   FullWidth="true">
                                            <MudSelectItem Value="@("Tiếng Anh")">Tiếng Anh</MudSelectItem>
                                            <MudSelectItem Value="@("Tiếng Pháp")">Tiếng Pháp</MudSelectItem>
                                            <MudSelectItem Value="@("Tiếng Trung")">Tiếng Trung</MudSelectItem>
                                            <MudSelectItem Value="@("Tiếng Nhật")">Tiếng Nhật</MudSelectItem>
                                            <MudSelectItem Value="@("Tiếng Đức")">Tiếng Đức</MudSelectItem>
                                            <MudSelectItem Value="@("Tiếng Hàn")">Tiếng Hàn</MudSelectItem>
                                            <MudSelectItem Value="@("Lịch sử")">Lịch sử</MudSelectItem>
                                            <MudSelectItem Value="@("Vật lý")">Vật lý</MudSelectItem>
                                            <MudSelectItem Value="@("Hóa học")">Hóa học</MudSelectItem>
                                            <MudSelectItem Value="@("Sinh học")">Sinh học</MudSelectItem>
                                            <MudSelectItem Value="@("Địa lý")">Địa lý</MudSelectItem>
                                            <MudSelectItem Value="@("Giáo dục kinh tế và pháp luật")">Giáo dục kinh tế và pháp luật</MudSelectItem>
                                            <MudSelectItem Value="@("Tin học")">Tin học</MudSelectItem>
                                            <MudSelectItem Value="@("Công nghệ")">Công nghệ</MudSelectItem>
                                        </MudSelect>
                                    </MudItem>
                                </MudGrid>
                            </MudPaper>
                        </MudItem>

                        <MudItem xs="12" sm="6" lg="3">
                            <MudPaper Elevation="2" Class="rounded-lg border-0 overflow-hidden">
                                <MudGrid Spacing="0">
                                    <MudItem xs="3" Style="background-color: #A855F7;">
                                        <div class="d-flex justify-center align-center" style="height:100%; padding: 12px;">
                                            <MudIcon Icon="@Icons.Material.Filled.Groups"  Style="color: white;" Size="Size.Large" />
                                        </div>
                                    </MudItem>
                                    <MudItem xs="9" Class="pa-2">
                                        <MudText Typo="Typo.subtitle1" Class="mb-1 font-weight-bold">Số lượng học sinh*</MudText>
                                        <MudNumericField @bind-Value="newNhomMon.SoLuong"
                                                         T="int"
                                                         Min="0"
                                                         Variant="MudBlazor.Variant.Outlined"
                                                         Dense="true"
                                                         FullWidth="true" />
                                    </MudItem>
                                </MudGrid>
                            </MudPaper>
                        </MudItem>
                        <MudItem xs="12" Class="d-flex justify-content-end">
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Success"
                                       OnClick="@CreateNhomMon"
                                       Disabled="@(string.IsNullOrEmpty(maTruong) || NhomMonState.Value.IsLoading)"
                                       StartIcon="@Icons.Material.Filled.Add"
                                       Class="rounded-md py-2"
                                       Style="height: 40px; width: 120px;">
                                Thêm
                            </MudButton>
                        </MudItem>
                    </MudGrid>

                </div>
            </MudForm>
        </MudPaper>
    </div>

    <!-- Bảng danh sách nhóm môn -->
    @if (NhomMonState.Value.DonVis != null && NhomMonState.Value.DonVis.Any())
    {
     <MudPaper Elevation="3" Class="pa-0 mb-4 rounded-lg">
         <MudText Typo="Typo.h6" Class="pa-4 d-flex align-center primary--text" Style="background-color: #f0f4c3; border-bottom: 1px solid #e0e0e0;">
             <MudIcon Icon="@Icons.Material.Filled.List" Class="mr-2" Color="Color.Primary" />
             Danh sách nhóm môn đã đăng ký
         </MudText>

         <div class="pa-3">
             <MudTable Items="@NhomMonState.Value.DonVis" Hover="true" Bordered="true" Striped="true"
                       Dense="false" Class="rounded-lg" Elevation="1">
                 <HeaderContent>
                     <MudTh Style="background-color: #e6ee9c; font-weight: 600; font-size: 1rem;">STT</MudTh>
                     <MudTh Style="background-color: #e6ee9c; font-weight: 600; font-size: 1rem;">Nhóm môn</MudTh>
                     <MudTh Style="background-color: #e6ee9c; font-weight: 600; font-size: 1rem;">Môn lựa chọn 1</MudTh>
                     <MudTh Style="background-color: #e6ee9c; font-weight: 600; font-size: 1rem;">Môn lựa chọn 2</MudTh>
                     <MudTh Style="background-color: #e6ee9c; font-weight: 600; font-size: 1rem;">Số lượng</MudTh>
                     <MudTh Style="background-color: #e6ee9c; font-weight: 600; font-size: 1rem; text-align: center;">Thao tác</MudTh>
                 </HeaderContent>
                 <RowTemplate>
                     <MudTd DataLabel="STT" Style="font-size: 0.9rem;">@(context.TenNhom)</MudTd>
                     <MudTd DataLabel="Nhóm môn" Style="font-size: 0.9rem;">
                         <strong>Nhóm @(context.TenNhom)</strong>
                     </MudTd>
                     <MudTd DataLabel="Môn lựa chọn 1" Style="font-size: 0.9rem;">
                         <div style="display: inline-block; background-color: #bbdefb; color: #1a237e; padding: 4px 10px; border-radius: 14px; font-size: 0.85rem;">
                             @context.MonLuaChon_1
                         </div>
                     </MudTd>
                     <MudTd DataLabel="Môn lựa chọn 2" Style="font-size: 0.9rem;">
                         <div style="display: inline-block; background-color: #ffe082; color: #bf360c; padding: 4px 10px; border-radius: 14px; font-size: 0.85rem;">
                             @context.MonLuaChon_2
                         </div>
                     </MudTd>
                     <MudTd DataLabel="Số lượng" Style="font-size: 0.9rem;">
                         @if (editingNhomMonId == context.ID)
                         {
                             <MudNumericField @bind-Value="editNhomMon.SoLuong" Min="0"
                                              Immediate="true" Style="width: 100px" Variant="Variant.Outlined" />
                         }
                         else
                         {
                             <div class="d-flex align-center">
                                 <MudIcon Icon="@Icons.Material.Filled.People" Size="Size.Small" Class="mr-1" Color="Color.Primary" />
                                 <strong style="font-size: 0.9rem;">@context.SoLuong</strong>
                             </div>
                         }
                     </MudTd>
                     <MudTd Style="text-align: center">
                         @if (editingNhomMonId == context.ID)
                         {
                             <div class="d-flex justify-center gap-2">
                                 <MudIconButton Icon="@Icons.Material.Filled.Save"
                                                Color="Color.Success"
                                                OnClick="@(() => SaveNhomMon(context))"
                                                Size="Size.Medium"
                                                Title="Lưu"
                                                Class="pa-2" />
                                 <MudIconButton Icon="@Icons.Material.Filled.Cancel"
                                                Color="Color.Default"
                                                OnClick="@CancelEditing"
                                                Size="Size.Medium"
                                                Title="Hủy"
                                                Class="pa-2" />
                             </div>
                         }
                         else
                         {
                             <div class="d-flex justify-center gap-2">
                                 <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                                Color="Color.Primary"
                                                OnClick="@(() => StartEditing(context))"
                                                Disabled="@context.Lock"
                                                Title="Sửa"
                                                Size="Size.Medium"
                                                Class="pa-2" />
                                 <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                Color="Color.Error"
                                                OnClick="@(() => DeleteNhomMon(context))"
                                                Disabled="@context.Lock"
                                                Title="Xóa"
                                                Size="Size.Medium"
                                                Class="pa-2" />
                             </div>
                         }
                     </MudTd>
                 </RowTemplate>
                 <FooterContent>
                     <MudTh colspan="4" Class="text-right" Style="font-size: 1rem;">
                         <div class="d-flex align-center justify-end">
                             <MudIcon Icon="@Icons.Material.Filled.Calculate" Class="mr-1" />
                             Tổng số học sinh:
                         </div>
                     </MudTh>
                     <MudTh Style="font-size: 1rem;">
                         <strong style="color: #2e7d32;">@totalSoLuong</strong>
                     </MudTh>
                     <MudTh></MudTh>
                 </FooterContent>
                 <PagerContent>
                     <MudTablePager PageSizeOptions="new int[]{5, 10, 20, 50}" />
                 </PagerContent>
             </MudTable>
         </div>
     </MudPaper>
    }
    else if (NhomMonState.Value.IsInitialized && !NhomMonState.Value.IsLoading && string.IsNullOrEmpty(NhomMonState.Value.ErrorMessage))
    {
        <MudPaper Elevation="0" Class="pa-3 d-flex align-center rounded-md" Style="border: 1px solid #e0e0e0; background-color: #f5f5f5;">
            <MudIcon Icon="@Icons.Material.Filled.Info" Color="Color.Info" Class="mr-2" />
            <MudText>Chưa có dữ liệu nhóm môn cho trường này. Vui lòng thêm thông tin nhóm môn.</MudText>
        </MudPaper>
    }
    else if (!string.IsNullOrEmpty(NhomMonState.Value.ErrorMessage))
    {
        <MudPaper Elevation="0" Class="pa-3 d-flex align-center rounded-md" Style="border: 1px solid #ffcdd2; background-color: #ffebee;">
            <MudIcon Icon="@Icons.Material.Filled.Error" Color="Color.Error" Class="mr-2" />
            <MudText>@NhomMonState.Value.ErrorMessage</MudText>
        </MudPaper>
    }

    <!-- Phần buttons điều hướng -->
    @*<div class="d-flex mt-4 gap-2">
        <MudButton Variant="Variant.Outlined"
                   Color="Color.Default"
                   OnClick="@GoBack"
                   StartIcon="@Icons.Material.Filled.ArrowBack"
                   Class="rounded-md">
            Quay lại Bước 1
        </MudButton>
        <MudSpacer />
    </div>*@

    <!-- Thông báo -->
    @if (!string.IsNullOrEmpty(NhomMonState.Value.NotificationMessage))
    {
        <div class="mt-4">
            @if (NhomMonState.Value.NotificationType == "error")
            {
                <MudPaper Elevation="0" Class="pa-3 d-flex align-center rounded-md" Style="border: 1px solid #ffcdd2; background-color: #ffebee;">
                    <MudIcon Icon="@Icons.Material.Filled.Error" Color="Color.Error" Class="mr-2" />
                    <MudText>@NhomMonState.Value.NotificationMessage</MudText>
                    <MudSpacer />
                    <MudIconButton Icon="@Icons.Material.Filled.Close" OnClick="@ClearNotification" Size="Size.Small" />
                </MudPaper>
            }
            else
            {
                <MudPaper Elevation="0" Class="pa-3 d-flex align-center rounded-md" Style="border: 1px solid #c8e6c9; background-color: #e8f5e9;">
                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Class="mr-2" />
                    <MudText>@NhomMonState.Value.NotificationMessage</MudText>
                    <MudSpacer />
                    <MudIconButton Icon="@Icons.Material.Filled.Close" OnClick="@ClearNotification" Size="Size.Small" />
                </MudPaper>
            }
        </div>
    }
</MudContainer>

@code {
    [Parameter]
    public string MaTruong { get; set; }

    private string maTruong = string.Empty;
    private int totalSoLuong => NhomMonState.Value.DonVis?.Sum(d => d.SoLuong) ?? 0;
    private MudForm form;
    // 4. Thêm một Timer để tự động xóa thông báo sau khoảng thời gian
    private System.Threading.Timer _clearNotificationTimer;

    // Form validation errors
    private string nhomMonError = string.Empty;
    private string mon1Error = string.Empty;
    private string mon2Error = string.Empty;

    // Editing state
    private int editingNhomMonId = -1;
    private KhaoThi_2_THPT_NhomMon_DonViModel editNhomMon = new();

    // New nhóm môn form
    private KhaoThi_2_THPT_NhomMon_DonViModel newNhomMon = new();

    protected override void OnInitialized()
    {
        base.OnInitialized();

        // Check if maTruong is in route parameter
        if (!string.IsNullOrEmpty(MaTruong))
        {
            maTruong = MaTruong;
        }
        else
        {
            // Extract maTruong from query string
            ExtractMaDonViFromQueryString();
        }

        if (!string.IsNullOrEmpty(maTruong))
        {
            newNhomMon.MaTruong = maTruong;
            LoadNhomMonsByMaTruong();
        }
    }

    private void ExtractMaDonViFromQueryString()
    {
        var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
        if (QueryHelpers.ParseQuery(uri.Query).TryGetValue("MaDonVi", out var maDonViParam))
        {
            maTruong = maDonViParam.First();
        }
    }

    protected override void OnAfterRender(bool firstRender)
    {
        base.OnAfterRender(firstRender);

        if (!string.IsNullOrEmpty(NhomMonState.Value.NotificationMessage))
        {
            var severity = NhomMonState.Value.NotificationType == "error"
                ? Severity.Error
                : Severity.Success;

            Snackbar.Add(NhomMonState.Value.NotificationMessage, severity);
            // Không xóa thông báo ngay lập tức
            // Dispatcher.Dispatch(new BCNhomMonAction.ClearErrorAction());
        }
    }
    private void ShowNotification(string message, string type)
    {
        var severity = type == "error" ? Severity.Error : Severity.Success;
        Snackbar.Add(message, severity);
    }

    private void ClearNotification()
    {
        Dispatcher.Dispatch(new BCNhomMonAction.ClearErrorAction());
    }

    private void ResetNewNhomMonForm()
    {
        newNhomMon = new KhaoThi_2_THPT_NhomMon_DonViModel
        {
            MaTruong = maTruong
        };
        nhomMonError = string.Empty;
        mon1Error = string.Empty;
        mon2Error = string.Empty;

    }

    private async Task LoadNhomMonsByMaTruong()
    {
        if (string.IsNullOrEmpty(maTruong))
            return;

        newNhomMon.MaTruong = maTruong;
        Dispatcher.Dispatch(new BCNhomMonAction.GetNhomMonByMaTruongAction(maTruong));
    }

    private async Task CreateNhomMon()
    {
        nhomMonError = string.Empty;
        mon1Error = string.Empty;
        mon2Error = string.Empty;

        // Basic validation
        if (newNhomMon.TenNhom <= 0)
        {
            nhomMonError = "Nhóm môn phải lớn hơn 0";
            ShowNotification("Nhóm môn phải lớn hơn 0", "error");
            return;
        }

        if (string.IsNullOrWhiteSpace(newNhomMon.MonLuaChon_1))
        {
            mon1Error = "Vui lòng chọn môn lựa chọn 1";
            ShowNotification("Vui lòng chọn môn lựa chọn 1", "error");
            return;
        }

        if (string.IsNullOrWhiteSpace(newNhomMon.MonLuaChon_2))
        {
            mon2Error = "Vui lòng chọn môn lựa chọn 2";
            ShowNotification("Vui lòng chọn môn lựa chọn 2", "error");
            return;
        }

        if (newNhomMon.MonLuaChon_1 == newNhomMon.MonLuaChon_2)
        {
            mon2Error = "Môn lựa chọn 2 không được trùng với môn lựa chọn 1";
            ShowNotification("Môn lựa chọn 2 không được trùng với môn lựa chọn 1", "error");
            return;
        }

        // Check if the combination already exists
        if (NhomMonState.Value.DonVis != null)
        {
            var existingNhomMon = NhomMonState.Value.DonVis.FirstOrDefault(n =>
                n.TenNhom == newNhomMon.TenNhom ||
                (n.MonLuaChon_1 == newNhomMon.MonLuaChon_1 && n.MonLuaChon_2 == newNhomMon.MonLuaChon_2) ||
                (n.MonLuaChon_1 == newNhomMon.MonLuaChon_2 && n.MonLuaChon_2 == newNhomMon.MonLuaChon_1)
            );

            if (existingNhomMon != null)
            {
                nhomMonError = "Nhóm môn hoặc tổ hợp môn đã tồn tại";
                ShowNotification("Nhóm môn hoặc tổ hợp môn đã tồn tại", "error");
                return;
            }
        }

        newNhomMon.MaTruong = maTruong;
        Dispatcher.Dispatch(new BCNhomMonAction.CreateNhomMonAction(newNhomMon));
        ShowNotification("Đang tạo nhóm môn...", "success");
        ResetNewNhomMonForm();
    }


    private void ClearNotificationAfterDelay()
    {
        // Xóa timer cũ nếu có
        _clearNotificationTimer?.Dispose();

        // Tạo timer mới để xóa thông báo sau 5 giây
        _clearNotificationTimer = new System.Threading.Timer(_ =>
        {
            InvokeAsync(() =>
            {
                Dispatcher.Dispatch(new BCNhomMonAction.ClearErrorAction());
                StateHasChanged();
            });
        }, null, 5000, Timeout.Infinite);
    }

    private void StartEditing(KhaoThi_2_THPT_NhomMon_DonViModel nhomMon)
    {
        editingNhomMonId = nhomMon.ID;
        editNhomMon = new KhaoThi_2_THPT_NhomMon_DonViModel
        {
            ID = nhomMon.ID,
            MaTruong = nhomMon.MaTruong,
            TenNhom = nhomMon.TenNhom,
            MonLuaChon_1 = nhomMon.MonLuaChon_1,
            MonLuaChon_2 = nhomMon.MonLuaChon_2,
            SoLuong = nhomMon.SoLuong,
            Lock = nhomMon.Lock
        };
    }

    private void CancelEditing()
    {
        editingNhomMonId = -1;
    }

    private void SaveNhomMon(KhaoThi_2_THPT_NhomMon_DonViModel nhomMon)
    {
        // Update only soLuong value
        nhomMon.SoLuong = editNhomMon.SoLuong;
        Dispatcher.Dispatch(new BCNhomMonAction.UpdateNhomMonAction(nhomMon));
        Snackbar.Add("Đang cập nhật số lượng học sinh", Severity.Info);
        editingNhomMonId = -1;
    }

    private void DeleteNhomMon(KhaoThi_2_THPT_NhomMon_DonViModel nhomMon)
    {
        Dispatcher.Dispatch(new BCNhomMonAction.DeleteNhomMonAction(nhomMon.ID));
        Snackbar.Add($"Đang xóa nhóm môn {nhomMon.TenNhom}", Severity.Info);
    }

    private void ToggleLockNhomMon(KhaoThi_2_THPT_NhomMon_DonViModel nhomMon)
    {
        Dispatcher.Dispatch(new BCNhomMonAction.ChangeLockAction(nhomMon.ID, !nhomMon.Lock));
        string actionText = nhomMon.Lock ? "mở khóa" : "khóa";
        Snackbar.Add($"Đang {actionText} nhóm môn {nhomMon.TenNhom}", Severity.Info);
    }

