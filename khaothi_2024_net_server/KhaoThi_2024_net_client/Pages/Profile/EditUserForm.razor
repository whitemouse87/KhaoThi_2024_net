@using KhaoThi_2024_net_client.Models.Users
@using MudBlazor
@inject IDispatcher Dispatcher
@inject ISnackbar Snackbar
@using static KhaoThi_2024_net_client.Services.User.KhaoThiUserActions
@using Blazored.Modal
@using Blazored.Modal.Services
@using System.ComponentModel.DataAnnotations
@using Radzen
@using Radzen.Blazor
<div class="profile-modal blazored-modal-container">
    <div class="blazored-modal">
        <MudPaper Elevation="0" Class="purple-header">
            <MudIcon Icon="@Icons.Material.Filled.School" Color="Color.Inherit" Size="Size.Large" Class="mb-3" />
            <MudText Typo="Typo.h5" Color="Color.Inherit" Class="mb-1">THÔNG TIN TÀI KHOẢN</MudText>
            <MudText Typo="Typo.body2" Color="Color.Inherit">Thông tin chi tiết và tài chính</MudText>
        </MudPaper>

        <div class="avatar-section">
            <MudAvatar Color="Color.Primary" Size="Size.Large" Class="mud-elevation-4">
                @(User?.HoTen?.FirstOrDefault().ToString().ToUpper() ?? "N")
            </MudAvatar>
        </div>

        <div class="user-info">
            <MudText Typo="Typo.h5" Class="mb-1">@User?.HoTen</MudText>
            <MudText Typo="Typo.body2" Color="Color.Default">@User?.TenDangNhap</MudText>
        </div>

        @if (User == null)
        {
            <div class="d-flex justify-center align-center" style="height: 200px;">
                <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
            </div>
        }
        else
        {
            <MudForm @ref="_form" Model="@User" @bind-IsValid="@_success">
                <MudGrid Spacing="3" Class="mud-grid">
                    <MudItem xs="12">
                        <div class="section-title d-flex align-items-center mb-3">
                            <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Small" Class="mr-2" />
                            <MudText Typo="Typo.h6">Thông Tin Khách Hàng</MudText>
                        </div>
                        <div class="field-row">
                            <div class="field-col">
                                <MudText Class="mud-input-label">Họ và tên</MudText>
                                <MudTextField @bind-Value="User.HoTen"
                                              Label=""
                                              Variant="MudBlazor.Variant.Outlined"
                                              Required="true"
                                              RequiredError="Họ và tên là bắt buộc!"
                                              Validation="@(new Func<string, IEnumerable<string>>(ValidateName))"
                                              Adornment="Adornment.Start"
                                              AdornmentIcon="@Icons.Material.Filled.Badge" />
                            </div>
                            <div class="field-col">
                                <MudText Class="mud-input-label">Email</MudText>
                                <MudTextField @bind-Value="User.Email"
                                              Label=""
                                              Variant="MudBlazor.Variant.Outlined"
                                              Required="true"
                                              RequiredError="Email là bắt buộc"
                                              Validation="@(new EmailAddressAttribute() { ErrorMessage = "Email không hợp lệ" })"
                                              Adornment="Adornment.Start"
                                              AdornmentIcon="@Icons.Material.Filled.Email" />
                            </div>
                            <div class="field-col">
                                <MudText Class="mud-input-label">Ngày sinh</MudText>
                                <MudDatePicker Label=""
                                               @bind-Date="User.NgaySinh"
                                               Variant="MudBlazor.Variant.Outlined"
                                               DateFormat="dd/MM/yyyy"
                                               Adornment="Adornment.Start"
                                               AdornmentIcon="@Icons.Material.Filled.Cake" />
                            </div>
                        </div>
                        <div class="field-row">
                            <div class="field-col">
                                <MudText Class="mud-input-label">Số điện thoại</MudText>
                                <MudTextField @bind-Value="User.SDT"
                                              Label=""
                                              Variant="MudBlazor.Variant.Outlined"
                                              Adornment="Adornment.Start"
                                              AdornmentIcon="@Icons.Material.Filled.Phone" />
                            </div>

                        </div>
                        <div class="field-row">
                            <div class="field-col">
                                <MudText Class="mud-input-label">Địa chỉ</MudText>
                                <MudTextField @bind-Value="User.DiaChi"
                                              Label=""
                                              Variant="MudBlazor.Variant.Outlined"
                                              Lines="3"
                                              Adornment="Adornment.Start"
                                              AdornmentIcon="@Icons.Material.Filled.Home" />
                            </div>
                        </div>
                    </MudItem>

                    <MudItem xs="12">
                        <div class="section-title d-flex align-items-center mb-3">
                            <MudIcon Icon="@Icons.Material.Filled.AccountBalance" Size="Size.Small" Class="mr-2" />
                            <MudText Typo="Typo.h6">Thông Tin Ngân Hàng</MudText>
                        </div>
                        <div class="field-row">

                            <MudText Class="mud-input-label">Tên ngân hàng</MudText>
                           

                                <RadzenDropDown Data="@Banks.Where(b => !string.IsNullOrEmpty(b.MaNganHang))"
                                                TextProperty="TenNganHang"
                                                ValueProperty="MaNganHang"
                                                @bind-Value="selectedBankCode"
                                                Placeholder="Chọn ngân hàng"
                                                Style="width: 100%; height: 42px; font-size: 16px;"
                                                Class="custom-bank-select">
                                    <Template Context="bank">
                                        <div style="display: flex; align-items: center; height: 36px;">
                                            <RadzenIcon Icon="account_balance" Style="margin-right: 12px; font-size: 22px;" />
                                            <span style="font-size: 16px; font-weight: 500;">@bank.TenNganHang</span>
                                        </div>
                                    </Template>
                                </RadzenDropDown>

                                @if (Banks == null || !Banks.Any())
                                {
                                    <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-danger);" Class="mt-2">
                                        Không có dữ liệu ngân hàng
                                    </RadzenText>
                                }
                            </div>
               
                        <div class="field-row">
                            <div class="field-col">
                                <MudText Class="mud-input-label">Số tài khoản</MudText>
                                <MudTextField @bind-Value="User.SoTaiKhoan"
                                              Label=""
                                              Variant="MudBlazor.Variant.Outlined"
                                              Adornment="Adornment.Start"
                                              AdornmentIcon="@Icons.Material.Filled.Numbers" />
                            </div>
                            <div class="field-col">
                                <MudText Class="mud-input-label">Mã số thuế</MudText>
                                <MudTextField @bind-Value="User.MaSoThue"
                                              Label=""
                                              Variant="MudBlazor.Variant.Outlined"
                                              Adornment="Adornment.Start"
                                              AdornmentIcon="@Icons.Material.Filled.Percent" />
                            </div>

                        </div>
                        <div class="field-row">
                            <div class="field-col">
                                <MudText Class="mud-input-label">Ngày tạo tài khoản</MudText>
                                <MudTextField Value="@User.NgayTao.ToString("dd/MM/yyyy")"
                                              Label=""
                                              Variant="MudBlazor.Variant.Outlined"
                                              ReadOnly="true"
                                              Adornment="Adornment.Start"
                                              AdornmentIcon="@Icons.Material.Filled.CalendarMonth" />
                            </div>
                        </div>
                    </MudItem>
                </MudGrid>
            </MudForm>
        }

        <div class="action-buttons">
            <MudButton OnClick="CancelAsync"
                       Variant="MudBlazor.Variant.Text"
                       Color="Color.Default"
                       Class="px-6">
                Hủy
            </MudButton>
            <MudButton Color="Color.Primary"
                       Variant="MudBlazor.Variant.Filled"
                       OnClick="Submit"
                       Disabled="@(!_success || IsLoading)"
                       Class="px-6">
                @if (IsLoading)
                {
                    <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                    <MudText Class="ms-2">Đang xử lý...</MudText>
                }
                else
                {
                    @("Lưu thay đổi")
                }
            </MudButton>
        </div>
    </div>
</div>

@code {
    [Inject] private IState<KhaoThiUserState> UserState { get; set; }
    [CascadingParameter] public BlazoredModalInstance BlazoredModal { get; set; } = default!;
    [Parameter] public KhaoThiUserModel User { get; set; } = null!;
    [Inject] private IUserService UserService { get; set; }
    private MudForm _form;
    private bool _success;
    private bool IsLoading => UserState.Value.IsLoading;
    private string? _lastNotificationMessage;
    private List<NganHangModel> Banks { get; set; } = new List<NganHangModel>();
    private string selectedBankCode;
    protected override async Task OnInitializedAsync()
    {
        UserState.StateChanged += HandleStateChanged;
        await LoadBanks(); // Sử dụng await bên trong phương thức async
    }
    protected override void OnParametersSet()
    {
        // Khi User được load, set selectedBankCode từ TenNganHang hiện tại
        if (User != null && !string.IsNullOrEmpty(User.TenNganHang) && Banks.Any())
        {
            var bank = Banks.FirstOrDefault(b => b.TenNganHang == User.TenNganHang);
            if (bank != null)
            {
                selectedBankCode = bank.MaNganHang;
            }
        }
    }


    private async Task LoadBanks()
    {
        try
        {
            var result = await UserService.LoadDanhSachNganHang();
            if (result != null)
            {
                Banks = result.ToList();

                // Cập nhật selectedBankCode nếu đã có TenNganHang
                if (User != null && !string.IsNullOrEmpty(User.TenNganHang))
                {
                    var bank = Banks.FirstOrDefault(b => b.TenNganHang == User.TenNganHang);
                    if (bank != null)
                    {
                        selectedBankCode = bank.MaNganHang;
                    }
                }

                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Lỗi khi tải danh sách ngân hàng: {ex.Message}", Severity.Error);
        }
    }

    private void HandleStateChanged(object? sender, EventArgs e)
    {
        var state = UserState.Value;

        if (!string.IsNullOrEmpty(state.NotificationMessage) &&
            state.NotificationMessage != _lastNotificationMessage)
        {
            _lastNotificationMessage = state.NotificationMessage;

            var severity = state.NotificationType?.ToLower() == "success"
                ? Severity.Success
                : Severity.Error;

            Snackbar.Add(state.NotificationMessage, severity);

            if (state.NotificationType?.ToLower() == "success")
            {
                InvokeAsync(async () =>
                {
                    await BlazoredModal.CloseAsync(ModalResult.Ok(state.SelectedUser));
                });
            }

            StateHasChanged();
        }
    }

    private IEnumerable<string> ValidateName(string name)
    {
        if (string.IsNullOrWhiteSpace(name))
        {
            yield return "Họ và tên là bắt buộc!";
            yield break;
        }
        if (name.Length < 3)
            yield return "Họ và tên phải có ít nhất 3 kí tự.";
    }

    private async Task Submit()
    {
        await _form.Validate();
        if (_success)
        {
            _lastNotificationMessage = null; // Reset notification tracker
            if (UserState.Value.SelectedUser != null)
            {
                User.RefreshToken = UserState.Value.SelectedUser.RefreshToken;
                User.RefreshTokenExpiryTime = UserState.Value.SelectedUser.RefreshTokenExpiryTime;
            }
            // Cập nhật TenNganHang từ selectedBankCode trước khi submit
            if (!string.IsNullOrEmpty(selectedBankCode))
            {
                User.TenNganHang = Banks.FirstOrDefault(b => b.MaNganHang == selectedBankCode)?.TenNganHang ?? "";
            }
            Dispatcher.Dispatch(new UpdateUserAction(User));
        }
    }

    private async Task CancelAsync()
    {
        await BlazoredModal.CancelAsync();
    }

    public void Dispose()
    {
        UserState.StateChanged -= HandleStateChanged;
    }
}