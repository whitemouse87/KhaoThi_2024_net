        <div class="action-buttons">
            <MudButton OnClick="CancelAsync"
                       Variant="Variant.Text"
                       Color="Color.Default"
                       Class="px-6 mr-2">
                Hủy
            </MudButton>
            <MudButton OnClick="SubmitAsync"
                       Color="Color.Primary"
                       Variant="Variant.Filled"
                       Disabled="@(!_success || IsLoading)"
                       Class="px-6">
                @if (IsLoading)
                {
                    <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                    <MudText Class="ms-2">Đang xử lý...</MudText>
                }
                else
                {
                    @("Lưu thay đổi")
                }
            </MudButton>
        </div>
    </div>
</div>

<style>
    .purple-header {
        background-color: #f3f0f9;
        padding: 24px;
        border-radius: 8px;
        text-align: center;
    }

    .action-buttons {
        display: flex;
        justify-content: flex-end;
        margin-top: 16px;
    }
</style>
@code {
    [Inject] private IState<KhaoThiUserState> UserState { get; set; }
    [CascadingParameter] public BlazoredModalInstance BlazoredModal { get; set; } = default!;
    [Parameter] public int? UserID { get; set; }
    [Parameter] public string TenUser { get; set; } = null!;
    private MudForm _form;
    private bool _success;
    private bool IsLoading => UserState.Value.IsLoading;
    private string? _lastNotificationMessage;

    private bool _showCurrentPassword = false;
    private bool _showNewPassword = false;
    private bool _showConfirmPassword = false;
    private ChangePasswordModel passwordModel = new();
    protected override void OnInitialized()
    {
        UserState.StateChanged += HandleStateChanged;
    }
    private void HandleStateChanged(object? sender, EventArgs e)
    {

        var errorMessage = UserState.Value.ErrorMessage;
        var notification = UserState.Value.NotificationMessage;
        var notificationType = UserState.Value.NotificationType;

        // Kiểm tra lỗi
        if (!string.IsNullOrEmpty(errorMessage) && errorMessage != _lastNotificationMessage)
        {
            Snackbar.Add(errorMessage, Severity.Error);
            _lastNotificationMessage = errorMessage;
            BlazoredModal.CloseAsync();
        }

        // Kiểm tra thành công
        if (!string.IsNullOrEmpty(notification) &&
            "success".Equals(notificationType, StringComparison.OrdinalIgnoreCase))
        {
            Snackbar.Add(notification, Severity.Success);
            BlazoredModal.CloseAsync();
        }

        StateHasChanged();
    }
    private async Task CancelAsync()
    {
        await BlazoredModal.CancelAsync();
    }
    public void Dispose()
    {
        UserState.StateChanged -= HandleStateChanged;
    }
    private IEnumerable<string> ValidatePassword(string password)
    {
        if (string.IsNullOrWhiteSpace(password))
            yield return "Mật khẩu không được để trống";

        if (password?.Length < 8)
            yield return "Mật khẩu phải có ít nhất 8 ký tự";

        if (password != null && !password.Any(char.IsUpper))
            yield return "Mật khẩu phải chứa ít nhất một chữ cái in hoa";

        if (password != null && !password.Any(char.IsDigit))
            yield return "Mật khẩu phải chứa ít nhất một chữ số";
    }

    private string ValidateConfirmPassword(string confirmPassword)
    {
        if (confirmPassword != passwordModel.NewPassword)
            return "Xác nhận mật khẩu không khớp";
        return null;
    }

    private async Task SubmitAsync()
    {
        await _form.Validate();

        if (_success)
        {
            Dispatcher.Dispatch(new ChangePasswordAction(UserID ?? 0, passwordModel));

        }
    }
}





