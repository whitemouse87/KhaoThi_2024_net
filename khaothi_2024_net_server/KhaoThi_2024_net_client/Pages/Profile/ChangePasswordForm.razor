@using KhaoThi_2024_net_client.Models.Users
@using MudBlazor
@inject IDispatcher Dispatcher
@inject ISnackbar Snackbar
@using static KhaoThi_2024_net_client.Services.User.KhaoThiUserActions
@using Blazored.Modal
@using Blazored.Modal.Services
@using System.ComponentModel.DataAnnotations
<div class="password-modal-container">
    <div class="password-modal">
        <div class="password-header">
            <MudIcon Icon="@Icons.Material.Filled.Password" Color="Color.Inherit" Size="Size.Medium" Class="mb-2" />
            <MudText Typo="Typo.h6" Class="mb-1">Cập nhật mật khẩu</MudText>
            <MudText Typo="Typo.body2">Họ tên người dùng: @TenUser.ToUpper().Trim()</MudText>
        </div>


        <div class="form-content">
            <MudForm @ref="_form" @bind-IsValid="_success" Model="@passwordModel">
                <MudTextField @bind-Value="passwordModel.CurrentPassword"
                              Label="Mật khẩu hiện tại"
                              Variant="Variant.Outlined"
                              InputType="@(_showCurrentPassword ? InputType.Text : InputType.Password)"
                              Adornment="Adornment.End"
                              AdornmentIcon="@(_showCurrentPassword ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                              OnAdornmentClick="() => _showCurrentPassword = !_showCurrentPassword"
                              AdornmentColor="Color.Primary"
                              Required="true"
                              RequiredError="Vui lòng nhập mật khẩu hiện tại"
                              Class="mb-3" />

                <MudTextField @bind-Value="passwordModel.NewPassword"
                              Label="Mật khẩu mới"
                              Variant="Variant.Outlined"
                              InputType="@(_showNewPassword ? InputType.Text : InputType.Password)"
                              Adornment="Adornment.End"
                              AdornmentIcon="@(_showNewPassword ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                              OnAdornmentClick="() => _showNewPassword = !_showNewPassword"
                              AdornmentColor="Color.Primary"
                              Required="true"
                              RequiredError="Vui lòng nhập mật khẩu mới"
                              Validation="@(new Func<string, IEnumerable<string>>(ValidatePassword))"
                              Class="mb-3" />

                <MudTextField @bind-Value="passwordModel.ConfirmPassword"
                              Label="Xác nhận mật khẩu mới"
                              Variant="Variant.Outlined"
                              InputType="@(_showConfirmPassword ? InputType.Text : InputType.Password)"
                              Adornment="Adornment.End"
                              AdornmentIcon="@(_showConfirmPassword ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                              OnAdornmentClick="() => _showConfirmPassword = !_showConfirmPassword"
                              AdornmentColor="Color.Primary"
                              Required="true"
                              RequiredError="Vui lòng xác nhận mật khẩu mới"
                              Validation="@(new Func<string, string>(ValidateConfirmPassword))"
                              Class="mb-3" />
            </MudForm>
        </div>

