@page "/profile"
@using MudBlazor
@using KhaoThi_2024_net_client.Services.User
@using static KhaoThi_2024_net_client.Services.User.KhaoThiUserActions
@implements IDisposable
@inject IDispatcher Dispatcher
@inject IState<KhaoThiUserState> UserState
@inject NavigationManager Navigation
@inject IAuthService AuthService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IModalService ModalService
<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
    <MudPaper Elevation="3" Class="rounded-lg overflow-hidden">
        <!-- Header với gradient và avatar -->
        <MudPaper Elevation="0" Style="background: linear-gradient(135deg, #594ae2 0%, #5042cb 100%); ">
            <div class="d-flex align-center py-4 px-6">
                <div class="mr-4">
                    <MudAvatar Style="background-color: rgba(255,255,255,0.2); width: 52px; height: 52px;">
                        <MudIcon Icon="@Icons.Material.Filled.School"
                                 Color="Color.Surface"
                                 Style="font-size: 32px; color: white;" />
                    </MudAvatar>
                </div>
                <div>
                    <MudText Typo="Typo.h5"
                             Style="color: white; font-weight: 600; letter-spacing: 0.5px;">
                        THÔNG TIN TÀI KHOẢN
                    </MudText>
                    <MudText Typo="Typo.body2"
                             Style="color: rgba(255,255,255,0.85); margin-top: 4px;">
                        Thông tin chi tiết và tài chính
                    </MudText>
                </div>
                <MudSpacer />
                <MudTooltip Text="Làm mới thông tin" Color="Color.Primary">
                    <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                                   Style="background-color: rgba(255,255,255,0.15); margin-left: 8px; color: white;"
                                   OnClick="@(() => LoadUserProfile())"
                                   Disabled="@UserState.Value.IsLoading">
                        @if (UserState.Value.IsLoading)
                        {
                            <MudProgressCircular Size="Size.Small"
                                                 Indeterminate="true"
                                                 Color="Color.Surface" />
                        }
                    </MudIconButton>
                </MudTooltip>
            </div>
        </MudPaper>

        <!-- Content -->
        @if (UserState.Value.IsLoading)
        {
            <div class="d-flex justify-center align-center" style="height: 400px;">
                <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" />
            </div>
        }
        else if (!string.IsNullOrEmpty(_errorMessage))
        {
            <div class="pa-4">
                <MudAlert Severity="Severity.Error" Variant="Variant.Filled"
                          Class="my-2 rounded-lg">
                    @_errorMessage
                </MudAlert>
            </div>
        }
        else if (UserState.Value.SelectedUser is not null)
        {
            <div class="pa-6">
                <!-- Thông tin cơ bản với Avatar -->
                <div class="d-flex flex-column align-center mb-8">
                    <MudAvatar Style="background-color: #594AE2; color: white; width: 120px; height: 120px; "
                               Class="mud-elevation-4 mb-4">
                        <MudText Typo="Typo.h3" Style="color: white;">
                            @(UserState.Value.SelectedUser.HoTen?.Substring(0, 1).ToUpper() ?? "U")
                        </MudText>
                    </MudAvatar>
                    <MudText Typo="Typo.h4" Style="color: #313a46; font-weight: 600;" Class="mb-2">
                        @UserState.Value.SelectedUser.HoTen
                    </MudText>
                    <MudText Typo="Typo.subtitle1" Style="color: #6c757d;">
                        @UserState.Value.SelectedUser.TenDangNhap
                    </MudText>
                </div>

                <!-- Thông tin chi tiết -->
                <MudGrid Spacing="4">
                    <!-- Cột thông tin cá nhân -->
                    <MudItem xs="12" md="6">
                        <MudPaper Elevation="0" Class="pa-4 rounded-lg" Style="background-color: #f8f9fa; ">
                            <MudText Typo="Typo.h6" Style="color: #313a46; font-weight: 600;" Class="mb-4 d-flex align-center">
                                <MudIcon Icon="@Icons.Material.Filled.Person"
                                         Style="color: #727cf5;" Class="mr-2" />
                                Thông Tin Chi Tiết
                            </MudText>

                            <MudList T="string" Dense="true" Clickable="false" DisablePadding="true">
                                <MudListItem Icon="@Icons.Material.Filled.Badge" IconColor="Color.Primary">
                                    <MudText>
                                        <strong style="color: #313a46; min-width: 150px; display: inline-block;">
                                            Mã số:
                                        </strong>
                                        @UserState.Value.SelectedUser.ID
                                    </MudText>
                                </MudListItem>

                                <MudListItem Icon="@Icons.Material.Filled.Work" IconColor="Color.Primary">
                                    <MudText>
                                        <strong style="color: #313a46; min-width: 150px; display: inline-block;">
                                            Chức vụ:
                                        </strong>
                                        @UserState.Value.SelectedUser.MaChucVu
                                    </MudText>
                                </MudListItem>

                                <MudListItem Icon="@Icons.Material.Filled.Business" IconColor="Color.Primary">
                                    <MudText>
                                        <strong style="color: #313a46; min-width: 150px; display: inline-block;">
                                            Đơn vị:
                                        </strong>
                                        @UserState.Value.SelectedUser.TenDonVi
                                    </MudText>
                                </MudListItem>

                                <MudListItem Icon="@Icons.Material.Filled.Numbers" IconColor="Color.Primary">
                                    <MudText>
                                        <strong style="color: #313a46; min-width: 150px; display: inline-block;">
                                            Mã đơn vị:
                                        </strong>
                                        @UserState.Value.SelectedUser.MaDonVi
                                    </MudText>
                                </MudListItem>

                                <MudListItem Icon="@Icons.Material.Filled.Email" IconColor="Color.Primary">
                                    <MudText>
                                        <strong style="color: #313a46; min-width: 150px; display: inline-block;">
                                            Email:
                                        </strong>
                                        @UserState.Value.SelectedUser.Email
                                    </MudText>
                                </MudListItem>

                                <MudListItem Icon="@Icons.Material.Filled.Phone" IconColor="Color.Primary">
                                    <MudText>
                                        <strong style="color: #313a46; min-width: 150px; display: inline-block;">
                                            Số điện thoại:
                                        </strong>
                                        @(UserState.Value.SelectedUser.SDT ?? "Chưa cập nhật")
                                    </MudText>
                                </MudListItem>

                                <MudListItem Icon="@Icons.Material.Filled.Cake" IconColor="Color.Primary">
                                    <MudText>
                                        <strong style="color: #313a46; min-width: 150px; display: inline-block;">
                                            Ngày sinh:
                                        </strong>
                                        @(UserState.Value.SelectedUser.NgaySinh?.ToString("dd/MM/yyyy") ?? "Chưa cập nhật")
                                    </MudText>
                                </MudListItem>

                                <MudListItem Icon="@Icons.Material.Filled.Home" IconColor="Color.Primary">
                                    <MudText>
                                        <strong style="color: #313a46; min-width: 150px; display: inline-block;">
                                            Địa chỉ:
                                        </strong>
                                        @(UserState.Value.SelectedUser.DiaChi ?? "Chưa cập nhật")
                                    </MudText>
                                </MudListItem>
                            </MudList>
                        </MudPaper>
                    </MudItem>

                    <!-- Cột thông tin tài chính -->
                    <MudItem xs="12" md="6">
                        <MudPaper Elevation="0" Class="pa-4 rounded-lg" Style="background-color: #f8f9fa;">
                            <MudText Typo="Typo.h6" Style="color: #313a46; font-weight: 600;" Class="mb-4 d-flex align-center">
                                <MudIcon Icon="@Icons.Material.Filled.AccountBalance"
                                         Style="color: #727cf5;" Class="mr-2" />
                                Thông Tin Tài Chính
                            </MudText>
                            <MudList T="string" Dense="true" Clickable="false" DisablePadding="true">
                                <MudList Dense="true" Clickable="false" DisablePadding="true">
                                    <MudListItem Icon="@Icons.Material.Filled.AccountBalance" IconColor="Color.Primary">
                                        <MudText>
                                            <strong style="color: #313a46; min-width: 150px; display: inline-block;">
                                                Số tài khoản:
                                            </strong>
                                            @(UserState.Value.SelectedUser.SoTaiKhoan ?? "Chưa cập nhật")
                                        </MudText>
                                    </MudListItem>

                                    <MudListItem Icon="@Icons.Material.Filled.Business" IconColor="Color.Primary">
                                        <MudText>
                                            <strong style="color: #313a46; min-width: 150px; display: inline-block;">
                                                Ngân hàng:
                                            </strong>
                                            @(UserState.Value.SelectedUser.TenNganHang ?? "Chưa cập nhật")
                                        </MudText>
                                    </MudListItem>

                                    <MudListItem Icon="@Icons.Material.Filled.Receipt" IconColor="Color.Primary">
                                        <MudText>
                                            <strong style="color: #313a46; min-width: 150px; display: inline-block;">
                                                Mã số thuế:
                                            </strong>
                                            @(UserState.Value.SelectedUser.MaSoThue ?? "Chưa cập nhật")
                                        </MudText>
                                    </MudListItem>

                                    <MudListItem Icon="@Icons.Material.Filled.Today" IconColor="Color.Primary">
                                        <MudText>
                                            <strong style="color: #313a46; min-width: 150px; display: inline-block;">
                                                Ngày tạo tài khoản:
                                            </strong>
                                            @UserState.Value.SelectedUser.NgayTao.ToString("dd/MM/yyyy")
                                        </MudText>
                                    </MudListItem>
                                </MudList>
                            </MudList>
                        </MudPaper>
                    </MudItem>
                </MudGrid>

                <!-- Buttons -->
                <div class="d-flex justify-center gap-4 mt-8">
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Edit"
                               OnClick="EditProfile"
                               Style="min-width: 200px; text-transform: none; font-weight: 500;"
                               Size="Size.Large">
                        Chỉnh Sửa Thông Tin
                    </MudButton>
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Error"
                               StartIcon="@Icons.Material.Filled.Password"
                               OnClick="ChangePasswordProfile"
                               Style="min-width: 200px; text-transform: none; font-weight: 500;"
                               Size="Size.Large">
                        Đổi Mật Khẩu
                    </MudButton>
                </div>
            </div>
        }
        else
        {
            <div class="pa-4">
                <MudAlert Severity="Severity.Warning" Variant="Variant.Filled"
                          Class="rounded-lg">
                    Không tìm thấy thông tin người dùng
                    <MudButton Color="Color.Inherit" Variant="Variant.Text"
                               OnClick="@(() => LoadUserProfile())" Class="ml-auto">
                        Tải Lại
                    </MudButton>
                </MudAlert>
            </div>
        }
    </MudPaper>
</MudContainer>


@code {
        // Biến lưu thông báo lỗi
    private string? _errorMessage;
    // Biến lưu ID người dùng
    private int? _userId;

    /// <summary>
    /// Phương thức khởi tạo component và lấy thông tin người dùng từ token xác thực
    /// Được gọi khi component được tạo lần đầu
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Lấy ID người dùng từ token xác thực
            _userId = await AuthService.GetUserIdFromToken();

            // Kiểm tra nếu ID không hợp lệ
            if (!_userId.HasValue || _userId <= 0)
            {
                _errorMessage = "Không thể xác định người dùng. Vui lòng đăng nhập lại.";
                return;
            }

            // Tải thông tin profile người dùng
            await LoadUserProfile();
        }
        catch (Exception ex)
        {
            _errorMessage = $"Đã xảy ra lỗi: {ex.Message}";
        }
    }

    /// <summary>
    /// Đăng ký lắng nghe sự kiện thay đổi trạng thái
    /// Được gọi sau khi component được khởi tạo
    /// </summary>
    protected override void OnInitialized()
    {
        // Đăng ký theo dõi sự thay đổi của UserState
        UserState.StateChanged += OnUserStateChanged;
    }

    /// <summary>
    /// Xử lý khi trạng thái thay đổi
    /// Cập nhật lại giao diện người dùng
    /// </summary>
    private async void OnUserStateChanged(object? sender, EventArgs e)
    {
        // Cập nhật lại giao diện khi có thay đổi
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Hủy đăng ký lắng nghe sự kiện khi component bị hủy
    /// Tránh memory leak
    /// </summary>
    public void Dispose()
    {
        UserState.StateChanged -= OnUserStateChanged;
    }

    /// <summary>
    /// Tải thông tin profile của người dùng
    /// Gửi action để lấy thông tin từ API
    /// </summary>
    private async Task LoadUserProfile()
    {
        try
        {
            if (_userId.HasValue && _userId > 0)
            {
                _errorMessage = null;
                // Gửi action để lấy thông tin người dùng
                Dispatcher.Dispatch(new GetUserByIdAction(_userId.Value));
                await InvokeAsync(StateHasChanged);
            }
            else
            {
                _errorMessage = "Không thể xác định ID người dùng.";
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (Exception ex)
        {
            _errorMessage = "Có lỗi xảy ra khi tải thông tin. Vui lòng thử lại.";
            await InvokeAsync(StateHasChanged);
        }
    }

    /// <summary>
    /// Xử lý chức năng chỉnh sửa profile
    /// Hiển thị modal chỉnh sửa thông tin
    /// </summary>
    private async Task EditProfile()
    {
        try
        {
            // Lấy thông tin người dùng để chỉnh sửa
            var user = GetUserForEditing();
            if (user == null) return;

            // Hiển thị modal chỉnh sửa
            var modalRef = ShowEditModal(user);
            // Xử lý kết quả sau khi modal đóng
            await HandleModalResult(modalRef);
        }
        catch (Exception ex)
        {
            HandleError(ex);
        }
    }

    /// <summary>
    /// Xử lý chức năng đổi mật khẩu
    /// Tương tự như EditProfile
    /// </summary>
    private async Task ChangePasswordProfile()
    {
        try
        {
            var user = GetUserForEditing();
            if (user == null) return;
            var modalRef = ChangePasswordModal(user.ID,user.HoTen);
            await HandleModalResult(modalRef);
        }
        catch (Exception ex)
        {
            HandleError(ex);
        }
    }

    /// <summary>
    /// Lấy thông tin người dùng để chỉnh sửa
    /// Kiểm tra và trả về null nếu không tìm thấy
    /// </summary>
    private KhaoThiUserModel GetUserForEditing()
    {
        if (UserState?.Value?.SelectedUser == null)
        {
            Snackbar.Add("Không tìm thấy thông tin người dùng!", Severity.Error);
            return null;
        }
        return UserState.Value.SelectedUser;
    }

    /// <summary>
    /// Hiển thị modal chỉnh sửa thông tin
    /// Cấu hình các tham số và tùy chọn cho modal
    /// </summary>
    private IModalReference ShowEditModal(KhaoThiUserModel user)
    {
        // Thiết lập tham số cho modal
        var parameters = new ModalParameters()
            .Add(nameof(EditUserForm.User), user);

        // Cấu hình tùy chọn cho modal
        var options = new ModalOptions
        {
            DisableBackgroundCancel = true, // Không cho phép đóng khi click nền
            HideCloseButton = false,        // Hiển thị nút đóng
            Position = ModalPosition.Middle, // Vị trí giữa màn hình
            Size = ModalSize.ExtraLarge,    // Kích thước lớn
            Class = "profile-modal",        // CSS class
            AnimationType = ModalAnimationType.FadeInOut // Hiệu ứng
        };

        return ModalService.Show<EditUserForm>("Chỉnh Sửa Thông Tin", parameters, options);
    }

    /// <summary>
    /// Xử lý kết quả trả về từ modal
    /// Cập nhật thông tin nếu thành công
    /// </summary>
    private async Task HandleModalResult(IModalReference modalRef)
    {
        var result = await modalRef.Result;
        if (!result.Cancelled && result.Data is KhaoThiUserModel updatedUser)
        {
            // Thông báo thành công và tải lại thông tin
            Snackbar.Add("Cập nhật thông tin thành công!", Severity.Success);
            await LoadUserProfile();
        }
        else if (!result.Cancelled)
        {
            // Thông báo lỗi nếu dữ liệu không hợp lệ
            Snackbar.Add("Dữ liệu trả về không hợp lệ!", Severity.Warning);
        }
    }

    /// <summary>
    /// Xử lý lỗi chung
    /// Hiển thị thông báo lỗi cho người dùng
    /// </summary>
    private void HandleError(Exception ex)
    {
        //Console.Error.WriteLine($"Error in EditProfile: {ex}");
        Snackbar.Add($"Có lỗi xảy ra: {ex.Message}", Severity.Error);
    }

    /// <summary>
    /// Chuyển hướng đến trang đổi mật khẩu
    /// </summary>
    //private void ChangePassword() => Navigation.NavigateTo("/profile/change-password");
    private IModalReference ChangePasswordModal(int UserID,string HoTen)
    {
        // Thiết lập tham số cho modal
        var parameters = new ModalParameters()
            .Add(nameof(ChangePasswordForm.UserID), UserID)
            .Add(nameof(ChangePasswordForm.TenUser), HoTen);

        // Cấu hình tùy chọn cho modal
        var options = new ModalOptions
        {
            DisableBackgroundCancel = true, // Không cho phép đóng khi click nền
            HideCloseButton = false,        // Hiển thị nút đóng
            Position = ModalPosition.Middle, // Vị trí giữa màn hình
            Size = ModalSize.ExtraLarge,    // Kích thước lớn
            Class = "profile-modal",        // CSS class
            AnimationType = ModalAnimationType.FadeInOut // Hiệu ứng
        };

        return ModalService.Show<ChangePasswordForm>("Thay đổi mật khẩu", parameters, options);
    }
}