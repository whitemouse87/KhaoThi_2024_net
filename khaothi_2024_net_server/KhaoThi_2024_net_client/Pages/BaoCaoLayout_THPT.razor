
@page "/bao-cao-ky-thi"
@using KhaoThi_2024_net_client.Models.BaoCaoSoLieu
@using KhaoThi_2024_net_client.Services.BC_1_ThongTinDonVi
@using KhaoThi_2024_net_client.Services.BC_4_LanhDaoDonVi
@using Fluxor
@using Radzen
@using Radzen.Blazor
@inject IState<BCThongTinDonViState> DonViState
@inject IState<BCLanhDaoDonViState> LanhDaoState
@using KhaoThi_2024_net_client.Pages.BC_1_ThongTinDonVi
@using KhaoThi_2024_net_client.Pages.BC_2_NhomMonDonVi
@using KhaoThi_2024_net_client.Pages.BC_4_LanhDaoDonVi
@using KhaoThi_2024_net_client.Pages.BC_5_ThongTinTruongDiemDonVi
@using KhaoThi_2024_net_client.Pages.BC_6_ThongTinConThiDonVi
@inject IDispatcher Dispatcher
@inject NotificationService NotificationService
@inject NavigationManager NavigationManager
@inject IDialogService DialogService
<!-- Header -->
<MudPaper Elevation="0" Style="background: linear-gradient(135deg, #594ae2 0%, #5042cb 100%);">
    <div class="d-flex align-center py-4 px-6">
        <div class="mr-4">
            <MudAvatar Style="background-color: rgba(255,255,255,0.2); width: 52px; height: 52px;">
                <MudIcon Icon="@Icons.Material.Filled.Analytics"
                         Color="Color.Surface"
                         Style="font-size: 32px; color: white;" />
            </MudAvatar>
        </div>
        <div>
            <MudText Typo="Typo.h5"
                     Style="color: white; font-weight: 600; letter-spacing: 0.5px;">
                BÁO CÁO SỐ LIỆU TRỰC TUYẾN PHỤC VỤ KỲ THI TỐT NGHIỆP THPT NĂM 2025 VÀ TUYỂN SINH LỚP 10 NĂM HỌC 2025-2026
            </MudText>
            <MudText Typo="Typo.body2"
                     Style="color: rgba(255,255,255,0.85); margin-top: 4px;">
                Đề nghị làm đủ 5 bước. Mọi vấn đề liên hệ với Phòng Khảo thí và KĐCLGD - Sở GDĐT.
            </MudText>
        </div>
        <MudSpacer />
    </div>
</MudPaper>

<!-- Steps -->
<div class="steps-container">
    @foreach (var step in steps)
    {
        <div class="step-item @(currentTab == step.Index ? "active" : "")" @onclick="@(() => SwitchTab(step.Index))">
            <RadzenIcon Icon="@step.Icon" Style="font-size: 48px; margin-bottom: 16px;" />
            <div class="step-number">Bước @step.Index</div>
            <div class="step-title">@step.Title</div>
        </div>
    }
</div>

<!-- Content -->
<div class="content-container">
    @switch (currentTab)
    {
        case 1:
            <BCThongTinDonVi />
            break;
        case 2:
            <BCNhomMonDonVi />
            break;
        case 3:
            <BCLanhDaoDonVi />
            break;
        case 4:
            <BCThongTinTruongDiemDonVi />
            break;
        case 5:
            <BCThongTinConDonVi />
            break;
        case 6:
            <MudText>Đang phát triển - Bước 6: Khai báo thông tin phục vụ tuyển sinh"</MudText>
            break;
        case 7:
            <MudText>Đang phát triển - Bước 7: In báo cáo</MudText>
            break;
        default:
            <BCThongTinDonVi />
            break;
    }
</div>

<!-- Buttons -->
<div class="buttons-container">
    @if (currentTab > 1)
    {
        <RadzenButton Click="@(async () => await SwitchTab(currentTab - 1))"
                      ButtonStyle="ButtonStyle.Light"
                      Icon="arrow_back"
                      Text="Quay lại"
                      class="btn-back" />
    }

    @*<RadzenButton Click="@SaveDraft"
        ButtonStyle="ButtonStyle.Light"
        Icon="save"
        Text="Lưu nháp"
        class="btn-save"
        Disabled="@(DonViState.Value.IsLoading)" />*@
    @if (currentTab < 7)
    {
        <RadzenButton Click="@(async () => await SwitchTab(currentTab + 1))"
                      ButtonStyle="ButtonStyle.Primary"
                      Icon="arrow_forward"
                      Text="Tiếp theo"
                      class="btn-next" />
    }
    else
    {
        <RadzenButton Click="@SubmitForm"
                      ButtonStyle="ButtonStyle.Success"
                      Icon="check"
                      Text="Hoàn thành"
                      class="btn-next" />
    }
</div>

@code {
    private int currentTab = 1;
    private string _lastNotificationMessage;
    @inject IState<BCLanhDaoDonViState> LanhDaoState;
    private class StepInfo
    {
        public int Index { get; set; }
        public string Icon { get; set; }
        public string Title { get; set; }
    }

    private List<StepInfo> steps = new List<StepInfo>
{
        new StepInfo { Index = 1, Icon = "school", Title = "Khai báo thông tin đơn vị và số liệu học sinh" },
        new StepInfo { Index = 2, Icon = "score", Title = "Khảo sát nhóm môn thi phục vụ quy hoạch điểm coi thi" },
        new StepInfo { Index = 3, Icon = "people", Title = "Khai báo thông tin lãnh đạo" },
        new StepInfo { Index = 4, Icon = "psychology", Title = "Khai báo thông tin lãnh đạo tham gia coi thi" },
        new StepInfo { Index = 5, Icon = "Face", Title = "Khai báo thông tin con em cán bộ nhà trường có con tham gia kỳ thi TS10 và tốt nghiệp THPT" },
        new StepInfo { Index = 6, Icon = "assignment", Title = "Khai báo thông tin phục vụ tuyển sinh" },
        new StepInfo { Index = 7, Icon = "print", Title = "In báo cáo" }
    };

    protected override void OnInitialized()
    {
        DonViState.StateChanged += HandleStateChanged;
    }

    private void HandleStateChanged(object? sender, EventArgs e)
    {
        // State management logic
        var state = DonViState.Value;

        if (!string.IsNullOrEmpty(state.NotificationMessage) &&
            state.NotificationMessage != _lastNotificationMessage)
        {
            _lastNotificationMessage = state.NotificationMessage;

            var notificationSeverity = state.NotificationType?.ToLower() == "success"
                ? NotificationSeverity.Success
                : NotificationSeverity.Error;

            NotificationService.Notify(new NotificationMessage
            {
                Severity = notificationSeverity,
                Summary = state.NotificationType?.ToLower() == "success" ? "Thành công" : "Lỗi",
                Detail = state.NotificationMessage,
                Duration = 4000
            });

            StateHasChanged();
        }
    }

    private async Task SwitchTab(int tabIndex)
    {
        // Kiểm tra nếu đang chuyển đến bước 4
        if (tabIndex == 4)
        {
            // Lấy mã trường từ state
            var maTruong = LanhDaoState.Value.MaTruong ?? "";

            // Kiểm tra xem danh sách lãnh đạo có dữ liệu không
            var lanhDaos = LanhDaoState.Value.LanhDaos;

            // Nếu chưa có dữ liệu, thử tải từ server
            if ((lanhDaos == null || !lanhDaos.Any()) && !string.IsNullOrEmpty(maTruong))
            {

                // Dispatch action để lấy danh sách lãnh đạo theo mã trường
                Dispatcher.Dispatch(new BCLanhDaoDonViAction.CheckLanhDaoEmptyAction(maTruong));

                // Đợi một chút để action được xử lý
                await Task.Delay(500);

                // Cập nhật lại danh sách sau khi đợi
                lanhDaos = LanhDaoState.Value.LanhDaos;
            }

            // Kiểm tra lại sau khi đã thử tải dữ liệu
            if (lanhDaos == null || !lanhDaos.Any())
            {
                // Hiển thị thông báo lỗi màu đỏ
                NotificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Error,
                    Summary = "Chưa có thông tin lãnh đạo",
                    Detail = "Trường của bạn chưa khai báo thông tin lãnh đạo. Vui lòng quay lại Bước 3 để khai báo thông tin lãnh đạo trước khi tiếp tục.",
                    Duration = 6000
                });

                // Chuyển về bước 3
                currentTab = 3;
                return;
            }
        }

        // Nếu không có vấn đề gì hoặc không phải bước 4, chuyển tab bình thường
        currentTab = tabIndex;
    }

    private void SaveDraft()
    {
        // Lưu nháp logic - sẽ thêm sau khi đã có actions tương ứng
        NotificationService.Notify(new NotificationMessage
        {
            Severity = NotificationSeverity.Success,
            Summary = "Thành công",
            Detail = "Đã lưu nháp báo cáo",
            Duration = 4000
        });
    }

    private void SubmitForm()
    {
        // Submit form logic - sẽ thêm sau khi đã có actions tương ứng
        NotificationService.Notify(new NotificationMessage
        {
            Severity = NotificationSeverity.Success,
            Summary = "Thành công",
            Detail = "Đã hoàn thành báo cáo",
            Duration = 4000
        });
    }

    public void Dispose()
    {
        DonViState.StateChanged -= HandleStateChanged;
    }

}