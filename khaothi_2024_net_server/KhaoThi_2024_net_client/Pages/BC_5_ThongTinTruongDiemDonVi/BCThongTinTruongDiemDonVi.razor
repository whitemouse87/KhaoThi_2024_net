                                }
                                else
                                {
                                    <MudChip T="string" Text="@truongDiem.CCCD" Color="Color.Primary" Variant="Variant.Outlined" Size="Size.Small" Disabled="true"></MudChip>
                                }
                            </MudTd>
                            <MudTd DataLabel="Họ và tên">
                                @if (editingTruongDiemId == GetTruongDiemId(truongDiem))
                                {
                                    <MudTextField @bind-Value="editTruongDiem.HoTen" Immediate="true"
                                                  Variant="Variant.Outlined" Margin="Margin.Dense" Required="true" RequiredError="Họ tên không được để trống" Disabled="true" />
                                }
                                else
                                {
                                    <div class="d-flex align-items-center">
                                        @if (!string.IsNullOrEmpty(truongDiem.HoTen))
                                        {
                                            <MudAvatar Color="Color.Secondary" Size="Size.Small" Class="mr-2" Disabled="true">
                                                @(truongDiem.HoTen.Substring(0, 1).ToUpper())
                                            </MudAvatar>
                                        }
                                        <strong>@truongDiem.HoTen</strong>
                                    </div>
                                }
                            </MudTd>
                            <MudTd DataLabel="Năm sinh">
