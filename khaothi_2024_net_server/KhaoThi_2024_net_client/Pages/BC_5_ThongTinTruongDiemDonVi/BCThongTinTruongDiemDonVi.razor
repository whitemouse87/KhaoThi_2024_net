    private void StartEditing(KhaoThi_4_THPT_ThongTin_LanhDaoModel truongDiem)
    {
        editingTruongDiemId = GetTruongDiemId(truongDiem);

        // Tạo đối tượng mới với các giá trị mặc định hợp lệ
        editTruongDiem = new KhaoThi_4_THPT_ThongTin_LanhDaoModel
        {
            MaTruong = truongDiem.MaTruong,
            CCCD = truongDiem.CCCD,
            HoTen = truongDiem.HoTen ?? "",
            NamSinh = truongDiem.NamSinh,
            ChucVuDonVi = truongDiem.ChucVuDonVi ?? "",
            CoiThiTS10 = truongDiem.CoiThiTS10,
            ChucVuCoiThiTS10 = truongDiem.ChucVuCoiThiTS10 ?? (truongDiem.CoiThiTS10 ? "Trưởng điểm" : "Không áp dụng"),
            // Đảm bảo LyDoKhongThamGiaTS10 luôn có giá trị
            LyDoKhongThamGiaTS10 = truongDiem.LyDoKhongThamGiaTS10 ?? (truongDiem.CoiThiTS10 ? "N/A" : "Không tham gia"),
            CoiThiTHPT = truongDiem.CoiThiTHPT,
            ChucVuCoiThiTHPT = truongDiem.ChucVuCoiThiTHPT ?? (truongDiem.CoiThiTHPT ? "Trưởng điểm" : "Không áp dụng"),
            // Đảm bảo LyDoKhongThamGiaTHPT luôn có giá trị
            LyDoKhongThamGiaTHPT = truongDiem.LyDoKhongThamGiaTHPT ?? (truongDiem.CoiThiTHPT ? "N/A" : "Không tham gia")
        };

        // Log để debug
        //Console.WriteLine($"Bắt đầu chỉnh sửa: MaTruong={editTruongDiem.MaTruong}");
        //Console.WriteLine($"CoiThiTS10={editTruongDiem.CoiThiTS10}, ChucVuCoiThiTS10={editTruongDiem.ChucVuCoiThiTS10}, LyDoKhongThamGiaTS10={editTruongDiem.LyDoKhongThamGiaTS10}");
        //Console.WriteLine($"CoiThiTHPT={editTruongDiem.CoiThiTHPT}, ChucVuCoiThiTHPT={editTruongDiem.ChucVuCoiThiTHPT}, LyDoKhongThamGiaTHPT={editTruongDiem.LyDoKhongThamGiaTHPT}");
    }

    private void CancelEditing()
    {
        editingTruongDiemId = string.Empty;
        editTruongDiem = new KhaoThi_4_THPT_ThongTin_LanhDaoModel();
    }

    private async Task SaveTruongDiem(KhaoThi_4_THPT_ThongTin_LanhDaoModel truongDiem)
    {
        isSaving = true;  // Vô hiệu hóa nút lưu trong khi đang lưu
        try
        {
            // Kiểm tra tên
            if (string.IsNullOrWhiteSpace(editTruongDiem.HoTen))
            {
                Snackbar.Add("Họ tên không được để trống", Severity.Error);
                return;
            }

            // Kiểm tra năm sinh
            if (editTruongDiem.NamSinh < 1950 || editTruongDiem.NamSinh > DateTime.Now.Year)
            {
                Snackbar.Add("Năm sinh không hợp lệ", Severity.Error);
                return;
            }

            // =====================================================================
            // Xử lý dữ liệu cho TS10
            // =====================================================================

            // Nếu tham gia coi thi TS10
            if (editTruongDiem.CoiThiTS10)
            {
                // Đảm bảo có chức vụ
                editTruongDiem.LyDoKhongThamGiaTS10 = "N/A";

                if (string.IsNullOrEmpty(editTruongDiem.ChucVuCoiThiTS10))
                {
                    editTruongDiem.ChucVuCoiThiTS10 = "Trưởng điểm";
                }
            }
            // Nếu KHÔNG tham gia coi thi TS10
            else
            {
                editTruongDiem.ChucVuCoiThiTS10 = "Không áp dụng";
                editTruongDiem.LyDoKhongThamGiaTS10 = string.IsNullOrEmpty(editTruongDiem.LyDoKhongThamGiaTS10)
                    ? "Không tham gia"
                    : editTruongDiem.LyDoKhongThamGiaTS10;
            }

            // =====================================================================
            // Xử lý dữ liệu cho THPT
            // =====================================================================

            // Nếu tham gia coi thi THPT
            if (editTruongDiem.CoiThiTHPT)
            {
                editTruongDiem.LyDoKhongThamGiaTHPT = "N/A";

                if (string.IsNullOrEmpty(editTruongDiem.ChucVuCoiThiTHPT))
                {
                    editTruongDiem.ChucVuCoiThiTHPT = "Trưởng điểm";
                }
            }
            // Nếu KHÔNG tham gia coi thi THPT
            else
            {
                editTruongDiem.ChucVuCoiThiTHPT = "Không áp dụng";
                editTruongDiem.LyDoKhongThamGiaTHPT = string.IsNullOrEmpty(editTruongDiem.LyDoKhongThamGiaTHPT)
                    ? "Không tham gia"
                    : editTruongDiem.LyDoKhongThamGiaTHPT;
            }

            // Kiểm tra cuối cùng để đảm bảo không có trường nào là null
            editTruongDiem.LyDoKhongThamGiaTS10 = editTruongDiem.LyDoKhongThamGiaTS10 ?? "Không tham gia";
            editTruongDiem.LyDoKhongThamGiaTHPT = editTruongDiem.LyDoKhongThamGiaTHPT ?? "Không tham gia";

            // Cập nhật giá trị từ editTruongDiem vào truongDiem
            truongDiem.HoTen = editTruongDiem.HoTen;
            truongDiem.NamSinh = editTruongDiem.NamSinh;
            truongDiem.ChucVuDonVi = editTruongDiem.ChucVuDonVi;
            truongDiem.CoiThiTS10 = editTruongDiem.CoiThiTS10;
            truongDiem.ChucVuCoiThiTS10 = editTruongDiem.ChucVuCoiThiTS10;
            truongDiem.LyDoKhongThamGiaTS10 = editTruongDiem.LyDoKhongThamGiaTS10;
            truongDiem.CoiThiTHPT = editTruongDiem.CoiThiTHPT;
            truongDiem.ChucVuCoiThiTHPT = editTruongDiem.ChucVuCoiThiTHPT;
            truongDiem.LyDoKhongThamGiaTHPT = editTruongDiem.LyDoKhongThamGiaTHPT;

            // Log các giá trị trước khi gửi đi
            //Console.WriteLine($"Đang gửi cập nhật: MaTruong={truongDiem.MaTruong}, CCCD={truongDiem.CCCD}");
            //Console.WriteLine($"CoiThiTS10={truongDiem.CoiThiTS10}, ChucVuCoiThiTS10={truongDiem.ChucVuCoiThiTS10}");
            //Console.WriteLine($"LyDoKhongThamGiaTS10={truongDiem.LyDoKhongThamGiaTS10}");
            //Console.WriteLine($"CoiThiTHPT={truongDiem.CoiThiTHPT}, ChucVuCoiThiTHPT={truongDiem.ChucVuCoiThiTHPT}");
            //Console.WriteLine($"LyDoKhongThamGiaTHPT={truongDiem.LyDoKhongThamGiaTHPT}");

            // Gửi action cập nhật
            Dispatcher.Dispatch(new UpdateTruongDiemAction(truongDiem));
            Snackbar.Add("Đang cập nhật thông tin...", Severity.Info);

            // Thoát chế độ chỉnh sửa
            editingTruongDiemId = string.Empty;

            // Đợi action hoàn thành
            await Task.Delay(500);

            // Tải lại dữ liệu
            await LoadPaginatedTruongDiems();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Lỗi khi lưu: {ex.Message}");
            Snackbar.Add($"Lỗi: {ex.Message}", Severity.Error);
        }
        finally
        {
            isSaving = false; // Bật lại nút lưu sau khi đã lưu xong
        }
    }
    private void OnCoiThiTS10Changed(bool value)
    {
        editTruongDiem.CoiThiTS10 = value;

        if (value) // Nếu chọn "Có"
        {
            // Khi tham gia thì không cần lý do không tham gia
            editTruongDiem.LyDoKhongThamGiaTS10 = null;

            // Đảm bảo chức vụ có giá trị hợp lệ
            if (string.IsNullOrEmpty(editTruongDiem.ChucVuCoiThiTS10) ||
                editTruongDiem.ChucVuCoiThiTS10 == "Không áp dụng")
            {
                editTruongDiem.ChucVuCoiThiTS10 = "Trưởng điểm";
            }
        }
        else // Nếu chọn "Không"
        {
            // Khi không tham gia thì không cần chức vụ
            editTruongDiem.ChucVuCoiThiTS10 = "Không áp dụng";

            // Khi không tham gia PHẢI có lý do
            if (string.IsNullOrEmpty(editTruongDiem.LyDoKhongThamGiaTS10))
            {
                editTruongDiem.LyDoKhongThamGiaTS10 = "Không tham gia";
            }
        }

        // Kiểm tra lại một lần nữa để đảm bảo
        if (!editTruongDiem.CoiThiTS10 && string.IsNullOrEmpty(editTruongDiem.LyDoKhongThamGiaTS10))
        {
            editTruongDiem.LyDoKhongThamGiaTS10 = "Không tham gia";
        }

        //Console.WriteLine($"Sau OnCoiThiTS10Changed: CoiThiTS10={editTruongDiem.CoiThiTS10}, " +
        //                 $"ChucVuCoiThiTS10={editTruongDiem.ChucVuCoiThiTS10}, " +
        //                 $"LyDoKhongThamGiaTS10={editTruongDiem.LyDoKhongThamGiaTS10 ?? "null"}");

        StateHasChanged();
    }

