                                        <MudSelectItem Value="@("Phó trưởng điểm cơ sở vật chất")">Phó trưởng điểm CSVC</MudSelectItem>
                                        @if (!editTruongDiem.CoiThiTS10)
                                        {
                                            <MudSelectItem Value="@("Không áp dụng")">Không áp dụng</MudSelectItem>
                                        }
                                    </MudSelect>
                                }
                                else
                                {
                                    <MudChip T="string" Text="@(truongDiem.CoiThiTS10 ? truongDiem.ChucVuCoiThiTS10 : "-")"
                                             Color="@(truongDiem.CoiThiTS10 ? Color.Info : Color.Default)"
                                             Variant="Variant.Outlined" Size="Size.Small"></MudChip>
                                }
                            </MudTd>

                            <MudTd DataLabel="Lý do không tham gia TS10">
                                @if (editingTruongDiemId == GetTruongDiemId(truongDiem))
                                {
                                    <MudTextField @bind-Value="editTruongDiem.LyDoKhongThamGiaTS10" Disabled="@(editTruongDiem.CoiThiTS10)"
