                            <MudTh Style="background-color: #1E88E5; color: white; font-weight: 700;">Họ và tên</MudTh>
                            <MudTh Style="background-color: #1E88E5; color: white; font-weight: 700;">Năm sinh</MudTh>
                            <MudTh Style="background-color: #1E88E5; color: white; font-weight: 700;">Chức vụ đơn vị</MudTh>
                            <MudTh Style="background-color: #1E88E5; color: white; font-weight: 700;">Coi thi TS10</MudTh>
                            <MudTh Style="background-color: #1E88E5; color: white; font-weight: 700;">Chức vụ TS10</MudTh>
