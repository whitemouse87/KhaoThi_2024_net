                                {
                                    <MudChip T="string" Text="@(truongDiem.CoiThiTS10 ? "Có" : "Không")"
                                             Color="@(truongDiem.CoiThiTS10 ? Color.Success : Color.Error)"
                                             Variant="Variant.Outlined" Size="Size.Small"></MudChip>
                                }
                            </MudTd>
                            <MudTd DataLabel="Chức vụ TS10">
                                @if (editingTruongDiemId == GetTruongDiemId(truongDiem))
                                {
                                    <MudSelect @bind-Value="editTruongDiem.ChucVuCoiThiTS10"
                                               Disabled="@(!editTruongDiem.CoiThiTS10)"
                                               Variant="Variant.Outlined" Margin="Margin.Dense">
                                        <MudSelectItem Value="@("Trưởng điểm")">Trưởng điểm</MudSelectItem>
