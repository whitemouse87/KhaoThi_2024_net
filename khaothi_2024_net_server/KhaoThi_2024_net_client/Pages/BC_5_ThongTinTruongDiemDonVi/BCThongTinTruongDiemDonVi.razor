                                               CheckedChanged="@((bool val) => { OnCoiThiTHPTChanged(val); StateHasChanged(); })"
                                               Color="Color.Primary" />
                                }
                                else
                                {
                                    <MudChip T="string" Text="@(truongDiem.CoiThiTHPT ? "Có" : "Không")"
                                             Color="@(truongDiem.CoiThiTHPT ? Color.Success : Color.Error)"
                                             Variant="Variant.Outlined" Size="Size.Small"></MudChip>
                                }
                            </MudTd>
                            <MudTd DataLabel="Chức vụ THPT">
                                @if (editingTruongDiemId == GetTruongDiemId(truongDiem))
                                {
                                    <MudSelect @bind-Value="editTruongDiem.ChucVuCoiThiTHPT"
                                               Disabled="@(!editTruongDiem.CoiThiTHPT)"
                                               Variant="Variant.Outlined" Margin="Margin.Dense">
                                        <MudSelectItem Value="@("Trưởng điểm")">Trưởng điểm</MudSelectItem>
                                        <MudSelectItem Value="@("Phó trưởng điểm coi thi")">Phó trưởng điểm coi thi</MudSelectItem>
                                        <MudSelectItem Value="@("Phó trưởng điểm cơ sở vật chất")">Phó trưởng điểm CSVC</MudSelectItem>
                                        @if (!editTruongDiem.CoiThiTHPT)
                                        {
                                            <MudSelectItem Value="@("Không áp dụng")">Không áp dụng</MudSelectItem>
                                        }
                                    </MudSelect>
                                }
                                else
                                {
                                    <MudChip T="string" Text="@(truongDiem.CoiThiTHPT ? truongDiem.ChucVuCoiThiTHPT : "-")"
                                             Color="@(truongDiem.CoiThiTHPT ? Color.Info : Color.Default)"
                                             Variant="Variant.Outlined" Size="Size.Small"></MudChip>
                                }
                            </MudTd>
                            <MudTd DataLabel="Lý do không tham gia THPT">
                                <MudTd DataLabel="Lý do không tham gia THPT">
                                    @if (editingTruongDiemId == GetTruongDiemId(truongDiem))
                                    {
                                        <MudTextField @bind-Value="editTruongDiem.LyDoKhongThamGiaTHPT" Disabled="@(editTruongDiem.CoiThiTHPT)"
                                                      Variant="Variant.Outlined" Margin="Margin.Dense" Lines="4" />
                                    }
                                    else
                                    {
                                        <MudTooltip Text="@(truongDiem.LyDoKhongThamGiaTHPT)" Arrow="true" Placement="Placement.Top">
                                            <div class="text-truncate" style="max-width: 150px;">
                                                @(truongDiem.CoiThiTHPT ? "-" : truongDiem.LyDoKhongThamGiaTHPT)
                                            </div>
                                        </MudTooltip>
                                    }
                                </MudTd>
                            </MudTd>
                            <MudTd Style="text-align: center">
                                @if (editingTruongDiemId == GetTruongDiemId(truongDiem))
                                {
                                    <div class="d-flex gap-2 justify-center">
                                        <MudIconButton Icon="@Icons.Material.Filled.Save"
                                                       Color="Color.Success"
                                                       OnClick="@(() => SaveTruongDiem(truongDiem))"
                                                       Size="Size.Small"
                                                       Title="Lưu" Disabled="@isSaving" />
                                        <MudIconButton Icon="@Icons.Material.Filled.Cancel"
                                                       Color="Color.Default"
                                                       OnClick="@CancelEditing"
                                                       Size="Size.Small"
                                                       Title="Hủy" Disabled="@isSaving" />
                                    </div>
                                }
                                else
                                {
                                    <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                                   Color="Color.Primary"
                                                   OnClick="@(() => StartEditing(truongDiem))"
                                                   Size="Size.Small"
                                                   Title="Sửa" Disabled="@isSaving" />
                                }
                            </MudTd>
                        </RowTemplate>
                        <PagerContent>
                            <MudTablePager PageSizeOptions="new int[] { 5, 10, 25, 50 }"
                                           RowsPerPageString="Số dòng mỗi trang:"
                                           InfoFormat="{first_item}-{last_item} / {all_items}"
                                           OnPageChanged="@(EventCallback.Factory.Create<int>(this, OnPageChanged))" />
                        </PagerContent>
                    </MudTable>
                </div>
            </MudPaper>
        }
        else if (TruongDiemState.Value.IsInitialized)
        {
            <MudPaper Elevation="0" Class="pa-3 d-flex flex-column align-center rounded-md" Style="border: 1px solid #e0e0e0; background-color: #f5f5f5;">
                <div class="d-flex align-center mb-2">
                    <MudIcon Icon="@Icons.Material.Filled.Info" Color="Color.Info" Class="mr-2" />
                    <MudText>Không có dữ liệu lãnh đạo điểm thi.</MudText>
                </div>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Refresh"
                           OnClick="@(async () => await LoadPaginatedTruongDiems())"
                           Class="mt-2">
                    Tải lại dữ liệu
                </MudButton>
            </MudPaper>
        }

        <!-- Hiển Thị Thông Báo -->
        @if (!string.IsNullOrEmpty(TruongDiemState.Value.NotificationMessage))
        {
            <div class="mt-4">
                @if (TruongDiemState.Value.NotificationType == "error")
                {
                    <MudPaper Elevation="0" Class="pa-3 d-flex align-center rounded-md" Style="border: 1px solid #ffcdd2; background-color: #ffebee;">
                        <MudIcon Icon="@Icons.Material.Filled.Error" Color="Color.Error" Class="mr-2" />
                        <MudText>@TruongDiemState.Value.NotificationMessage</MudText>
                        <MudSpacer />
                        <MudIconButton Icon="@Icons.Material.Filled.Close" OnClick="@ClearNotification" Size="Size.Small" />
                    </MudPaper>
                }
                else
                {
                    <MudPaper Elevation="0" Class="pa-3 d-flex align-center rounded-md" Style="border: 1px solid #c8e6c9; background-color: #e8f5e9;">
                        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Class="mr-2" />
                        <MudText>@TruongDiemState.Value.NotificationMessage</MudText>
                        <MudSpacer />
                        <MudIconButton Icon="@Icons.Material.Filled.Close" OnClick="@ClearNotification" Size="Size.Small" />
                    </MudPaper>
                }
            </div>
        }
    </div>
</MudContainer>

@code {
    [Parameter]
    public string MaTruong { get; set; }

    private string maTruong = string.Empty;
    private string searchTerm = string.Empty;
    private string editingTruongDiemId = string.Empty;
    private KhaoThi_4_THPT_ThongTin_LanhDaoModel editTruongDiem = new();

    private bool _notificationShown = false;
    private System.Threading.Timer _clearNotificationTimer;
    private int currentPage = 1;
    private int pageSize = 10;
    private bool isPageChanging = false;
    private bool isSaving = false; // Cờ để vô hiệu hóa các nút khi đang lưu
    private MudForm form;
    private MudTable<KhaoThi_4_THPT_ThongTin_LanhDaoModel> table;
    private bool _isFirstLoad = true;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        Console.WriteLine("Bắt đầu OnInitializedAsync");

        // Check maTruong từ route parameter
        if (!string.IsNullOrEmpty(MaTruong))
        {
            maTruong = MaTruong;
            //Console.WriteLine($"Lấy maTruong từ route parameter: {maTruong}");
        }
        else
        {
            // Trích xuất maTruong từ query string
            ExtractMaDonViFromQueryString();
        }

        if (!string.IsNullOrEmpty(maTruong))
        {
            //Console.WriteLine($"Đã xác định maTruong: {maTruong}, tiến hành tải dữ liệu");

            // Đảm bảo server API có thể gọi được
            // Gửi ping request trước
            try
            {
                await TruongDiemService.GetPaginatedAsync(1, 1);
                //Console.WriteLine("Ping API thành công");
            }
            catch (Exception ex)
            {
                //Console.WriteLine($"Ping API thất bại: {ex.Message}");
            }

            await LoadTruongDiemsByMaTruong();
        }
        else
        {
            //Console.WriteLine("Không thể xác định maTruong");
            Snackbar.Add("Không thể xác định mã trường", Severity.Warning);
        }
    }

    private void ExtractMaDonViFromQueryString()
    {
        var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query); // Parse query string trước

        if (query.TryGetValue("MaDonVi", out var maDonViParam))
        {
            maTruong = maDonViParam.First();
        }
    }

    protected override void OnAfterRender(bool firstRender)
    {
        base.OnAfterRender(firstRender);

        if (firstRender)
        {
            Console.WriteLine($"State: IsLoading={TruongDiemState.Value.IsLoading}, " +
                            $"IsInitialized={TruongDiemState.Value.IsInitialized}, " +
                            $"HasItems={TruongDiemState.Value.PaginatedTruongDiems?.Items?.Count() ?? 0}, " +
                            $"Error={TruongDiemState.Value.ErrorMessage ?? "None"}");

            // Kiểm tra nếu không có dữ liệu và đã khởi tạo trạng thái
            if (_isFirstLoad && !TruongDiemState.Value.IsLoading && TruongDiemState.Value.IsInitialized &&
                (TruongDiemState.Value.PaginatedTruongDiems == null || !TruongDiemState.Value.PaginatedTruongDiems.Items.Any()))
            {
                _isFirstLoad = false;
                InvokeAsync(async () => await LoadPaginatedTruongDiems());
            }
        }

        // Hiển thị thông báo Snackbar và đặt cờ để tránh lặp lại
        if (!string.IsNullOrEmpty(TruongDiemState.Value.NotificationMessage) && !_notificationShown)
        {
            var severity = TruongDiemState.Value.NotificationType == "error"
                ? Severity.Error
                : Severity.Success;

            Snackbar.Add(TruongDiemState.Value.NotificationMessage, severity);
            _notificationShown = true;

            // Xóa thông báo sau 5 giây
            _clearNotificationTimer?.Dispose();
            _clearNotificationTimer = new System.Threading.Timer(_ =>
            {
                InvokeAsync(() =>
                {
                    Dispatcher.Dispatch(new KhaoThi_2024_net_client.Services.BC_5_TruongDiemDonVi.BCThongTinTruongDiemAction.ClearErrorAction());
                    StateHasChanged();
                });
            }, null, 5000, Timeout.Infinite);
        }
        else if (string.IsNullOrEmpty(TruongDiemState.Value.NotificationMessage))
        {
            _notificationShown = false;
        }
    }

    private void ClearNotification()
    {
        Dispatcher.Dispatch(new KhaoThi_2024_net_client.Services.BC_5_TruongDiemDonVi.BCThongTinTruongDiemAction.ClearErrorAction());
    }

    private async Task LoadTruongDiemsByMaTruong()
    {
        if (string.IsNullOrEmpty(maTruong))
            return;

        await LoadPaginatedTruongDiems();
    }

    private async Task LoadPaginatedTruongDiems()
    {
        try
        {
            // Log trước khi gọi API
            //Console.WriteLine($"Đang gọi API LoadPaginatedTruongDiems: MaTruong={maTruong}, Page={currentPage}, PageSize={pageSize}, SearchTerm={searchTerm}");

            // Dispatch action để tải dữ liệu
            Dispatcher.Dispatch(new LoadPaginatedTruongDiemsAction(currentPage, pageSize, searchTerm, maTruong));

            // Đợi một khoảng thời gian cho effect xử lý
            await Task.Delay(1000);

            // Kiểm tra kết quả để debug
            var hasData = TruongDiemState.Value.PaginatedTruongDiems?.Items?.Any() == true;
            var isError = !string.IsNullOrEmpty(TruongDiemState.Value.ErrorMessage);

            //Console.WriteLine($"Kết quả tải dữ liệu: HasData={hasData}, IsError={isError}, ErrorMessage={TruongDiemState.Value.ErrorMessage ?? "None"}");
        }
        catch (Exception ex)
        {
            //Console.WriteLine($"Lỗi khi tải dữ liệu: {ex.Message}");
            Snackbar.Add("Có lỗi xảy ra khi tải dữ liệu. Vui lòng thử lại", Severity.Error);
        }

        // Cập nhật giao diện
        StateHasChanged();
    }
    private async Task OnPageChanged(int page)
    {
        if (isPageChanging) return;

        try
        {
            isPageChanging = true;
            currentPage = page;
            await LoadPaginatedTruongDiems();
        }
        finally
        {
            isPageChanging = false;
        }
    }

    private async Task SearchTruongDiem()
    {
        currentPage = 1; // Reset về trang đầu tiên khi tìm kiếm
        await LoadPaginatedTruongDiems();
    }

    private async Task RefreshData()
    {
        // Luôn tải lại dữ liệu khi người dùng yêu cầu làm mới
        searchTerm = string.Empty;
        currentPage = 1;
        await LoadPaginatedTruongDiems();
    }

    private string GetTruongDiemId(KhaoThi_4_THPT_ThongTin_LanhDaoModel truongDiem)
