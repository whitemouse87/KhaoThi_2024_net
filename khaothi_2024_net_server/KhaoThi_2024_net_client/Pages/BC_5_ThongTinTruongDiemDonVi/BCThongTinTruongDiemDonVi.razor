                                            @(truongDiem.CoiThiTS10 ? "-" : truongDiem.LyDoKhongThamGiaTS10)
                                        </div>
                                    </MudTooltip>
                                }
                            </MudTd>
                            <MudTd DataLabel="Coi thi THPT">
                                @if (editingTruongDiemId == GetTruongDiemId(truongDiem))
                                {
